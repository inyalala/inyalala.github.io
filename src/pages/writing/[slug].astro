---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { WRITING_POSTS, type WritingPost } from '../../data/writing';
import { ABCS_ENTRIES } from '../../data/abcs-agriculture';
import { getImageDim } from '../../data/media';
import { breadcrumbList, personEntity, webPageEntity, websiteEntity } from '../../data/schema';

export function getStaticPaths() {
  return WRITING_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: WritingPost;
}

const { post } = Astro.props;
const Content = post.Content;
const isAbcsPrimer = post.slug === 'abcs-of-ai-in-agriculture';
const mappedAbcsCount = ABCS_ENTRIES.filter((item) => Boolean(item.ourResearch)).length;

function fitTitleAtWord(text: string, maxLen = 48): string {
  if (text.length <= maxLen) return text;
  const cut = text.slice(0, maxLen).replace(/\s+\S*$/, '');
  return (cut || text.slice(0, maxLen)).trim();
}

const shortHeadline = post.shortTitle || fitTitleAtWord(post.title, 48);
const pageTitle = `${shortHeadline} | Nyalala`;
const metaDesc = post.summary.length > 160 ? `${fitTitleAtWord(post.summary, 156)}...` : post.summary;
const imgDim = post.image ? getImageDim(post.image, 1200, 750) : null;
const pageUrl = `https://inyalala.github.io/writing/${post.slug}/`;
const resolvedOgImage = post.image
  ? post.image.startsWith('http')
    ? post.image
    : `https://inyalala.github.io${post.image}`
  : 'https://inyalala.github.io/images/og-innocent-nyalala.png';

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    webPageEntity({
      url: pageUrl,
      name: pageTitle,
      description: metaDesc,
      breadcrumbId: `${pageUrl}#breadcrumb`,
      mainEntityId: `${pageUrl}#article`
    }),
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      headline: post.title,
      description: post.summary,
      inLanguage: 'en-US',
      keywords: post.tags.join(', '),
      datePublished: post.date,
      dateModified: post.date,
      author: { '@id': 'https://inyalala.github.io/#person' },
      publisher: { '@id': 'https://inyalala.github.io/#person' },
      isPartOf: { '@id': `${pageUrl}#webpage` },
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
      image: resolvedOgImage
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Writing & Guides', url: 'https://inyalala.github.io/writing/' },
        { name: post.title, url: pageUrl }
      ],
      `${pageUrl}#breadcrumb`
    )
  ]
};
const tocHeadings = post.headings || [];
const hasToc = tocHeadings.length >= 2;
const relatedPosts = WRITING_POSTS.filter((p) => p.slug !== post.slug)
  .sort((a, b) => (a.category === post.category ? -1 : 1) - (b.category === post.category ? -1 : 1) || b.date.localeCompare(a.date))
  .slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={metaDesc}
  canonical={pageUrl}
  ogType="article"
  ogImage={resolvedOgImage}
  ogImageAlt={post.imageAlt || post.title}
  ogImageWidth={imgDim ? imgDim.width : 1200}
  ogImageHeight={imgDim ? imgDim.height : 630}
  publishedTime={post.date}
  tags={post.tags}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <MonographRail currentPage="writing" />

  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <div class="monograph-canvas">
    <main id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/writing/">Writing &amp; Guides</a>
        <span>/</span>
        <span aria-current="page">{post.category}</span>
      </nav>

      <article class="essay-article">
        <header class="page-masthead">
          <span class="mono-eyebrow">
            {post.category} &middot; {post.date} &middot; {post.readingTime}
          </span>
          <h1 class="page-title">{post.title}</h1>
          <p class="page-lead">{post.summary}</p>
        </header>

        {post.image && imgDim && (
          <figure class="article-hero-fig">
            <img
              src={post.image}
              alt={post.imageAlt || post.title}
              width={imgDim.width}
              height={imgDim.height}
              loading="eager"
              fetchpriority="high"
            />
            {post.imageAlt && <figcaption>{post.imageAlt}</figcaption>}
          </figure>
        )}

        <div class:list={['essay-body-layout', hasToc ? 'has-toc' : '']}>
          {hasToc && (
            <nav id="articleToc" class="article-toc" aria-label="On this page">
              <details class="toc-details" open>
                <summary class="toc-summary">
                  <span class="mono-eyebrow">On This Page</span>
                  <span class="toc-caret" aria-hidden="true">+</span>
                </summary>
                <ol id="articleTocList" class="toc-list">
                  {tocHeadings.map((h) => (
                    <li class={h.depth === 3 ? 'toc-sub' : undefined}>
                      <a href={`#${h.slug}`} class="toc-link">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )}

          <div class="prose-body">
            <Content />
          </div>
        </div>

        {isAbcsPrimer && (
          <section class="abcs-primer" aria-label="Illustrated A to Z of AI in Agriculture">
            <div class="abcs-controls">
              <div class="abcs-filter-row" role="group" aria-label="Filter letters by SAAIL Lab research link">
                <button type="button" class="abc-filter-btn is-active" data-abc-filter="all" aria-pressed="true">
                  All 26 Letters ({ABCS_ENTRIES.length})
                </button>
                <button type="button" class="abc-filter-btn" data-abc-filter="mapped" aria-pressed="false">
                  Mapped to Our Research ({mappedAbcsCount})
                </button>
              </div>
              <nav class="abc-jump-bar" aria-label="Jump to letter A through Z">
                {ABCS_ENTRIES.map((item) => (
                  <a
                    href={`#letter-${item.letter.toLowerCase()}`}
                    class={`abc-jump-link${item.ourResearch ? ' has-research' : ''}`}
                    data-mapped={item.ourResearch ? 'true' : 'false'}
                    title={`${item.letter}: ${item.title}`}
                  >
                    {item.letter}
                  </a>
                ))}
              </nav>
              <p class="abc-filter-status" id="abcFilterStatus" aria-live="polite">
                Showing all {ABCS_ENTRIES.length} agricultural AI concepts from A to Z.
              </p>
            </div>

            <div class="abcs-overview-head">
              <span class="mono-eyebrow">Illustrated A&ndash;Z Visual Reference</span>
              <h2 id="abcsOverviewHeading">All {ABCS_ENTRIES.length} Concepts at a Glance</h2>
            </div>

            <div class="abcs-poster-grid">
              {ABCS_ENTRIES.map((item) => (
                <a
                  href={`#letter-${item.letter.toLowerCase()}`}
                  class="abc-tile"
                  data-mapped={item.ourResearch ? 'true' : 'false'}
                >
                  <div class="abc-tile-media">
                    <span class="abc-badge">{item.letter}</span>
                    <img
                      src={item.thumb}
                      alt=""
                      aria-hidden="true"
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="abc-tile-caption">
                    <strong>{item.title}</strong>
                    {item.ourResearch && <span class="abc-mini-tag">SAAIL Research</span>}
                  </div>
                </a>
              ))}
            </div>

            <div class="abcs-entries" id="abcsEntries">
              {ABCS_ENTRIES.map((item) => (
                <article
                  id={`letter-${item.letter.toLowerCase()}`}
                  class="abc-card"
                  data-mapped={item.ourResearch ? 'true' : 'false'}
                >
                  <header class="abc-card-head">
                    <span class="abc-letter-drop">{item.letter}</span>
                    <div>
                      <span class="mono-eyebrow">{item.subdomain}</span>
                      <h2>
                        {item.letter} is for {item.title}
                      </h2>
                    </div>
                  </header>

                  <figure class="abc-figure">
                    <img
                      src={item.image}
                      alt={item.imageAlt}
                      width="960"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>
                      {item.imageAlt} &middot; {item.credit}
                    </figcaption>
                  </figure>

                  <div class="abc-copy">
                    <p>{item.plainSummary}</p>
                    <div class="abc-tech-grid">
                      <div>
                        <h3>Current State of the Art</h3>
                        <p>{item.stateOfTheArt}</p>
                      </div>
                      <div>
                        <h3>Open Research Problems</h3>
                        <p>{item.openProblems}</p>
                      </div>
                    </div>
                  </div>

                  {item.ourResearch && (
                    <aside class="abc-research-box" aria-label={`Our research on ${item.title}`}>
                      <span class="mono-eyebrow">Mapped to Our Published Work &amp; SAAIL Lab</span>
                      <p class="abc-research-lead">{item.ourResearch.lead}</p>
                      <ul class="abc-research-list">
                        {item.ourResearch.refs.map((ref) => (
                          <li>
                            {ref.href.startsWith('http') ? (
                              <a href={ref.href} target="_blank" rel="noopener" class="inline-link pub-title">
                                {ref.title} &#8599;
                              </a>
                            ) : (
                              <a href={ref.href} class="inline-link pub-title">
                                {ref.title} &rarr;
                              </a>
                            )}
                            <span class="abc-ref-meta">
                              {ref.venue} ({ref.year}) &middot; {ref.note}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </aside>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {relatedPosts.length > 0 && (
          <section class="related-writing" aria-label="Related writing and guides">
            <span class="mono-eyebrow">Continue Reading</span>
            <h2 class="related-heading">Related Writing &amp; Guides</h2>
            <ul class="related-grid">
              {relatedPosts.map((rp) => (
                <li>
                  <span class="related-meta">{rp.category} &middot; {rp.date}</span>
                  <a href={`/writing/${rp.slug}/`} class="related-title">{rp.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <footer class="article-foot">
          <a href="/writing/" class="text-action">&larr; Back to All Writing &amp; Guides</a>
          <a href="/contact/" class="text-action">Write to Innocent Nyalala &rarr;</a>
        </footer>
      </article>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    (function () {
      var bar = document.getElementById('readingProgress');
      var article = document.querySelector('.essay-article');
      if (!bar || !article) return;
      function updateBar() {
        var rect = article.getBoundingClientRect();
        var total = Math.max(1, article.offsetHeight - window.innerHeight * 0.55);
        var done = Math.min(total, Math.max(0, -rect.top));
        bar.style.transform = 'scaleX(' + (done / total).toFixed(4) + ')';
      }
      window.addEventListener('scroll', updateBar, { passive: true });
      window.addEventListener('resize', updateBar, { passive: true });
      updateBar();

      var tocLinks = document.querySelectorAll('#articleTocList .toc-link');
      var proseEl = document.querySelector('.prose-body');
      if (tocLinks.length && proseEl && 'IntersectionObserver' in window) {
        var linksById = {};
        tocLinks.forEach(function (a) {
          var href = a.getAttribute('href') || '';
          if (href.indexOf('#') === 0) linksById[href.slice(1)] = a;
        });
        var headings = Array.prototype.slice.call(proseEl.querySelectorAll('h2[id], h3[id]'));
        var setCurrent = function (id) {
          Object.keys(linksById).forEach(function (k) {
            linksById[k].classList.toggle('is-active', k === id);
          });
        };
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && entry.target && entry.target.id) {
              setCurrent(entry.target.id);
            }
          });
        }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
        headings.forEach(function (h) { io.observe(h); });
      }
    })();
  </script>

{isAbcsPrimer && (
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var btns = document.querySelectorAll('.abc-filter-btn');
      var jumps = document.querySelectorAll('.abc-jump-link');
      var tiles = document.querySelectorAll('.abc-tile');
      var cards = document.querySelectorAll('.abc-card');
      var status = document.getElementById('abcFilterStatus');
      var overviewHeading = document.getElementById('abcsOverviewHeading');
      if (!btns.length) return;
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.getAttribute('data-abc-filter') || 'all';
          btns.forEach(function (b) {
            var active = b === btn;
            b.setAttribute('aria-pressed', String(active));
            b.classList.toggle('is-active', active);
          });
          jumps.forEach(function (el) {
            var hide = mode === 'mapped' && el.getAttribute('data-mapped') !== 'true';
            el.style.display = hide ? 'none' : '';
            if (hide) el.setAttribute('aria-hidden', 'true');
            else el.removeAttribute('aria-hidden');
          });
          var visibleCards = 0;
          tiles.forEach(function (el) {
            el.style.display = mode === 'mapped' && el.getAttribute('data-mapped') !== 'true' ? 'none' : '';
          });
          cards.forEach(function (el) {
            var hide = mode === 'mapped' && el.getAttribute('data-mapped') !== 'true';
            el.style.display = hide ? 'none' : '';
            if (!hide) visibleCards += 1;
          });
          if (overviewHeading) {
            overviewHeading.textContent = mode === 'mapped'
              ? visibleCards + ' Research-Mapped Concepts at a Glance'
              : 'All ' + visibleCards + ' Concepts at a Glance';
          }
          if (status) {
            status.textContent = mode === 'mapped'
              ? 'Showing ' + visibleCards + ' concepts mapped to published SAAIL Lab research.'
              : 'Showing all ' + visibleCards + ' agricultural AI concepts from A to Z.';
          }
        });
      });
    });
  </script>
)}
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 1.15rem;
  }
  .breadcrumb a {
    color: var(--accent-forest);
    text-decoration: none;
  }

  .article-hero-fig {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 0.65rem;
    margin-bottom: 2rem;
  }
  .article-hero-fig img {
    width: 100%;
    height: auto;
  }
  .article-hero-fig figcaption {
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .essay-body-layout {
    display: block;
  }
  .article-toc {
    max-width: 68ch;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0 0.85rem;
    margin-bottom: 1.75rem;
  }
  .toc-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .toc-summary::-webkit-details-marker {
    display: none;
  }
  .toc-summary .mono-eyebrow {
    margin-bottom: 0;
  }
  .toc-caret {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent-clove);
    transition: transform 0.16s ease;
  }
  .toc-details[open] .toc-caret {
    transform: rotate(45deg);
    color: var(--accent-forest);
  }
  .toc-list {
    list-style: none;
    padding: 0.65rem 0 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1.25rem;
  }
  .toc-list li.toc-sub {
    padding-left: 0.85rem;
  }
  .toc-link {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 0.45rem;
    display: inline-block;
    line-height: 1.4;
  }
  .toc-link:hover,
  .toc-link.is-active {
    color: var(--accent-forest);
    border-left-color: var(--accent-forest);
    font-weight: 500;
  }
  @media (min-width: 1180px) {
    .essay-body-layout.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 66ch) minmax(185px, 1fr);
      gap: 2rem;
      align-items: start;
    }
    .essay-body-layout.has-toc .prose-body {
      grid-column: 1;
      grid-row: 1;
    }
    .essay-body-layout.has-toc .article-toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 2rem;
      margin-bottom: 0;
      padding: 0.85rem 0 0.85rem 0.9rem;
      border-top: none;
      border-bottom: none;
      border-left: 1px solid var(--rule);
    }
    .essay-body-layout.has-toc .toc-caret {
      display: none;
    }
    .essay-body-layout.has-toc .toc-summary {
      cursor: default;
      pointer-events: none;
    }
    .essay-body-layout.has-toc .toc-list {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 1320px) {
    main {
      max-width: 1060px;
    }
    .essay-body-layout.has-toc {
      grid-template-columns: minmax(0, 68ch) minmax(200px, 1fr);
      gap: 2.5rem;
    }
  }
  @media (max-width: 680px) {
    .toc-list {
      grid-template-columns: 1fr;
    }
  }

  .prose-body {
    max-width: 68ch;
    font-size: 1.07rem;
    line-height: 1.76;
    color: var(--text-primary);
  }
  .prose-body :global(h2) {
    font-size: 1.65rem;
    margin: 2.1rem 0 0.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 28px;
  }
  .prose-body :global(h3) {
    font-size: 1.28rem;
    margin: 1.45rem 0 0.55rem;
    scroll-margin-top: 28px;
  }
  .prose-body :global(p) {
    margin-bottom: 1.1rem;
    color: var(--text-secondary);
  }
  .prose-body :global(ul),
  .prose-body :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1.2rem;
    color: var(--text-secondary);
  }
  .prose-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 0.45rem;
    margin: 1.45rem 0;
  }
  .prose-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    background: var(--bg-secondary);
    border: 1px solid var(--rule);
    padding: 0.95rem 1.1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    color: var(--text-primary);
  }
  .prose-body :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }
  .prose-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 1.75rem 0;
  }
  .prose-body :global(a) {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg-secondary);
    padding: 0.1rem 0.35rem;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-forest);
    transform-origin: 0 50%;
    transform: scaleX(0);
    z-index: 2500;
    pointer-events: none;
  }

  .related-writing {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .related-heading {
    font-size: 1.35rem;
    margin-bottom: 0.9rem;
  }
  .related-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .related-grid li {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .related-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-clove);
  }
  .related-title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.28;
    text-decoration: none;
    color: var(--text-primary);
  }
  .related-title:hover {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 780px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  .article-foot {
    margin-top: 2.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--rule-strong);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Illustrated A-Z Primer */
  .abcs-primer {
    margin-top: 2rem;
    border-top: 1px solid var(--rule-strong);
    padding-top: 1.5rem;
  }
  .abcs-controls {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 1rem 1.15rem;
    margin-bottom: 1.75rem;
  }
  .abcs-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
  }
  .abc-filter-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .abc-filter-btn.is-active,
  .abc-filter-btn[aria-pressed='true'] {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: #f8f5ee;
