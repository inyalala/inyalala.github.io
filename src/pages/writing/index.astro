---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { WRITING_POSTS } from '../../data/writing';
import { getImageDim, getThumbSrc } from '../../data/media';
import { breadcrumbList, personEntity, websiteEntity } from '../../data/schema';

const categories = ['All', 'Research Note', 'Scholar Guide', 'Essay & Reflection', 'Zanzibar & Campus Guide'];

const writingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    {
      '@type': 'CollectionPage',
      '@id': 'https://inyalala.github.io/writing/#webpage',
      url: 'https://inyalala.github.io/writing/',
      name: 'Writing & Travel Guides | Innocent Nyalala · IITMZ',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      about: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': 'https://inyalala.github.io/writing/#breadcrumb' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: WRITING_POSTS.length,
        itemListElement: WRITING_POSTS.map((p, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          item: {
            '@type': 'BlogPosting',
            headline: p.title,
            datePublished: p.date,
            author: { '@id': 'https://inyalala.github.io/#person' },
            url: `https://inyalala.github.io/writing/${p.slug}/`
          }
        }))
      }
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Writing & Guides', url: 'https://inyalala.github.io/writing/' }
      ],
      'https://inyalala.github.io/writing/#breadcrumb'
    )
  ]
};
---

<BaseLayout
  title="Writing & Travel Guides | Innocent Nyalala · IITMZ"
  description="Research notes on agricultural AI, field evaluation benchmarks, and practical travel and campus guides for visitors to IIT Madras Zanzibar."
  canonical="https://inyalala.github.io/writing/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(writingSchema)} />
  </Fragment>

  <MonographRail currentPage="writing" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">Essays, Notes &amp; Field Guides</span>
        <h1 class="page-title">Writing &amp; Visitor Guides</h1>
        <p class="page-lead">
          Personal field reflections from Zanzibar, research notes on East African agricultural AI and Swahili dialect NLP, Overleaf and scholarly writing guides for students, and practical campus guides for visitors to IIT Madras Zanzibar.
        </p>

        <div class="writing-controls">
          <div class="filter-strip" style="margin-top: 0;" role="group" aria-label="Filter articles by category">
            {categories.map((cat, idx) => (
              <button type="button" class="filter-btn" aria-pressed={idx === 0 ? 'true' : 'false'} data-wcat={cat}>
                {cat === 'All' ? `All (${WRITING_POSTS.length})` : cat}
              </button>
            ))}
          </div>

          <input
            id="writingSearch"
            type="search"
            placeholder="Search topics, Overleaf, Kiunguja, seaweed, Zanzibar..."
            aria-label="Search articles by title, summary, or topic tag"
            class="w-search-input"
          />
        </div>
        <p id="writingCount" class="w-count" aria-live="polite">
          Showing {WRITING_POSTS.length} of {WRITING_POSTS.length} articles
        </p>
      </header>

      <section class="rule-section" style="padding-top: 0;">
        <ol class="essay-ledger">
          {WRITING_POSTS.map((post) => {
            const thumb = post.image ? getThumbSrc(post.image) : '';
            const dim = thumb ? getImageDim(thumb, 640, 400) : { width: 640, height: 400 };
            const searchBlob = `${post.title} ${post.summary} ${post.category} ${post.tags.join(' ')}`.toLowerCase();
            return (
              <li class="essay-row" data-wcat={post.category} data-search={searchBlob}>
                {thumb && (
                  <a href={`/writing/${post.slug}/`} class="essay-media" aria-label={post.title}>
                    <img
                      src={thumb}
                      alt={post.imageAlt || post.title}
                      width={dim.width}
                      height={dim.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="essay-body">
                  <p class="essay-meta">
                    <span class="e-cat">{post.category}</span>
                    <span>&middot;</span>
                    <time datetime={post.date}>{post.date}</time>
                    <span>&middot;</span>
                    <span>{post.readingTime}</span>
                  </p>
                  <h2>
                    <a href={`/writing/${post.slug}/`}>{post.title}</a>
                  </h2>
                  <p class="essay-summary">{post.summary}</p>
                  {post.tags.length > 0 && (
                    <p class="essay-tags">{post.tags.join(' · ')}</p>
                  )}
                  <p>
                    <a href={`/writing/${post.slug}/`} class="text-action">Read Article &rarr;</a>
                  </p>
                </div>
              </li>
            );
          })}
        </ol>

        <div id="writingEmptyState" class="filter-empty-state" hidden>
          <p>No articles or guides matched the current filter or search term.</p>
          <button type="button" id="resetWritingFilters" class="filter-btn">Reset Filters</button>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var btns = document.querySelectorAll('.filter-btn[data-wcat]');
      var rows = document.querySelectorAll('.essay-row');
      var countEl = document.getElementById('writingCount');
      var searchEl = document.getElementById('writingSearch');
      var emptyEl = document.getElementById('writingEmptyState');
      var resetEl = document.getElementById('resetWritingFilters');
      var activeCat = 'All';

      function syncUrl() {
        try {
          var params = new URLSearchParams(window.location.search);
          if (activeCat !== 'All') params.set('cat', activeCat);
          else params.delete('cat');
          var qVal = ((searchEl && searchEl.value) || '').trim();
          if (qVal) params.set('q', qVal);
          else params.delete('q');
          var qs = params.toString();
          window.history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
        } catch (e) {}
      }

      function applyFilters(skipUrl) {
        var q = ((searchEl && searchEl.value) || '').trim().toLowerCase();
        var vis = 0;
        rows.forEach(function (r) {
          var catOk = activeCat === 'All' || r.getAttribute('data-wcat') === activeCat;
          var qOk = !q || (r.getAttribute('data-search') || '').indexOf(q) !== -1;
          var show = catOk && qOk;
          r.style.display = show ? 'grid' : 'none';
          if (show) vis++;
        });
        if (emptyEl) emptyEl.hidden = vis > 0;
        if (countEl) countEl.textContent = 'Showing ' + vis + ' of ' + rows.length + ' articles';
        if (!skipUrl) syncUrl();
      }

      try {
        var initP = new URLSearchParams(window.location.search);
        var initCat = initP.get('cat');
        var initQ = initP.get('q');
        if (initCat) {
          btns.forEach(function (b) {
            var match = b.getAttribute('data-wcat') === initCat;
            b.setAttribute('aria-pressed', String(match));
            if (match) activeCat = initCat;
          });
        }
        if (initQ && searchEl) searchEl.value = initQ;
        if (initCat || initQ) applyFilters(true);
      } catch (e) {}

      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', 'false');
          });
          btn.setAttribute('aria-pressed', 'true');
          activeCat = btn.getAttribute('data-wcat') || 'All';
          applyFilters();
        });
      });

      resetEl &&
        resetEl.addEventListener('click', function () {
          activeCat = 'All';
          if (searchEl) searchEl.value = '';
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-wcat') === 'All'));
          });
          applyFilters();
          searchEl && searchEl.focus();
        });

      searchEl && searchEl.addEventListener('input', function () { applyFilters(); });
    });
  </script>
</BaseLayout>

<style>
  .writing-controls {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.35rem;
  }
  .w-search-input {
    max-width: 440px;
    width: 100%;
    padding: 0.48rem 0.8rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 0.94rem;
    border-radius: 2px;
  }
  .essay-tags {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
  }
  .w-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.8rem;
  }
  .filter-empty-state {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 1.5rem;
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .filter-empty-state[hidden] {
    display: none;
  }
  .filter-empty-state p {
    color: var(--text-secondary);
    font-size: 0.96rem;
    margin: 0;
  }

  .essay-ledger {
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .essay-row {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 1.65rem;
    padding: 1.65rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .essay-media {
    display: block;
    border: 1px solid var(--rule);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .essay-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .essay-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .e-cat {
    color: var(--accent-clove);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .essay-body h2 {
    font-size: 1.55rem;
    margin-bottom: 0.45rem;
  }
  .essay-body h2 a {
    text-decoration: none;
  }
  .essay-body h2 a:hover {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .essay-summary {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 720px) {
    .essay-row {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .essay-media {
      max-width: 340px;
    }
  }
</style>
