---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PUBLICATIONS } from '../../data/publications';
import { THESES } from '../../data/theses';
import metrics from '../../data/scholar-metrics.json';
import { breadcrumbList, isInnocentNyalala, personEntity, scholarlyArticleNode, websiteEntity } from '../../data/schema';

const sortedPubs = [...PUBLICATIONS].sort((a, b) => {
  if (a.slug === 'cropguardnet') return -1;
  if (b.slug === 'cropguardnet') return 1;
  if (b.year !== a.year) return b.year - a.year;
  return b.dateISO.localeCompare(a.dateISO);
});

const saailCount = sortedPubs.filter((p) => p.isSaailLab).length;
const priorCount = sortedPubs.filter((p) => !p.isSaailLab).length;
const underReviewCount = sortedPubs.filter((p) => p.category === 'preprint').length;
const openAccessCount = sortedPubs.filter((p) => p.openAccess).length;
const datedCitationSum = Object.values(metrics.citationsPerYear).reduce((a, b) => a + b, 0);
const undatedCitationDelta = Math.max(0, metrics.citations - datedCitationSum);

const years = Object.keys(metrics.citationsPerYear).sort();
const yearsWithPapers = new Set(sortedPubs.map((p) => String(p.year)));
const vals = years.map((y) => metrics.citationsPerYear[y as keyof typeof metrics.citationsPerYear]);
const maxVal = Math.max(...vals, 1);
const W = 720;
const H = 212;
const padL = 10;
const padT = 54;
const padB = 26;
const slot = (W - padL * 2) / years.length;
const barW = Math.min(44, slot * 0.56);
const milestones: Record<string, string> = {
  '2023': '2023 PhD',
  '2024': '2024 IITMZ',
  '2025': '2025–26 DLI'
};

const topicCounts = new Map<string, number>();
for (const pub of sortedPubs) {
  for (const t of pub.topics || []) {
    topicCounts.set(t, (topicCounts.get(t) || 0) + 1);
  }
}
const topTopics = Array.from(topicCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8)
  .map(([topic, count]) => ({ topic, count }));

function formatApaCitation(pub: (typeof sortedPubs)[number]): string {
  const authList = pub.authors.slice(0, 20).join(', ');
  const doiPart = pub.doi ? ` https://doi.org/${pub.doi}` : pub.paperUrl ? ` ${pub.paperUrl}` : '';
  return `${authList} (${pub.year}). ${pub.title}. ${pub.venue}.${doiPart}`.trim();
}

const schemaCollection = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    {
      '@type': 'CollectionPage',
      '@id': 'https://inyalala.github.io/publications/#webpage',
      url: 'https://inyalala.github.io/publications/',
      name: `Publications (${sortedPubs.length}) | Innocent Nyalala · IITM Zanzibar`,
      description: `Bibliography of ${sortedPubs.length} papers by Innocent Nyalala in agricultural vision, Swahili NLP, responsible AI, and clinical ML (${metrics.citations} citations).`,
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      about: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': 'https://inyalala.github.io/publications/#breadcrumb' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: sortedPubs.length,
        itemListElement: sortedPubs.map((pub, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          item: scholarlyArticleNode(pub)
        }))
      }
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Publications', url: 'https://inyalala.github.io/publications/' }
      ],
      'https://inyalala.github.io/publications/#breadcrumb'
    )
  ]
};
---

<BaseLayout
  title={`Publications (${sortedPubs.length}) | Innocent Nyalala · IITM Zanzibar`}
  description={`Bibliography of ${sortedPubs.length} papers by Innocent Nyalala in agricultural vision, Swahili NLP, responsible AI, and clinical ML (${metrics.citations.toLocaleString()} citations).`}
  canonical="https://inyalala.github.io/publications/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaCollection)} />
  </Fragment>

  <MonographRail currentPage="publications" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">Scholarly Bibliography &middot; 2015 - 2026</span>
        <h1 class="page-title">Publications ({sortedPubs.length})</h1>
        <p class="page-lead">
          Complete publication index spanning {saailCount} SAAIL Lab works ({metrics.saailPublishedCount} published or accepted, {underReviewCount} under review; project pages on{' '}
          <a href="https://saaillab.github.io/publications/" target="_blank" rel="noopener" class="inline-link">SAAIL Lab &#8599;</a>) and {priorCount} prior studies (2015–2024) hosted natively in this personal archive.
        </p>

        <div class="pub-ext-links">
          <a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener" class="text-action">
            Google Scholar &#8599;
          </a>
          <a href="https://orcid.org/0000-0002-7969-437X" target="_blank" rel="noopener" class="text-action">
            ORCID &#8599;
          </a>
          <a href="https://www.scopus.com/authid/detail.uri?authorId=57190215419" target="_blank" rel="noopener" class="text-action">
            Scopus &#8599;
          </a>
          <a href="https://www.webofscience.com/wos/author/record/X-4277-2018" target="_blank" rel="noopener" class="text-action">
            Web of Science &#8599;
          </a>
          <a href="https://openreview.net/profile?id=~Innocent_Nyalala1" target="_blank" rel="noopener" class="text-action">
            OpenReview &#8599;
          </a>
          <a href="https://www.semanticscholar.org/author/3406658" target="_blank" rel="noopener" class="text-action">
            Semantic Scholar &#8599;
          </a>
          <a href="https://openalex.org/A5013656785" target="_blank" rel="noopener" class="text-action">
            OpenAlex &#8599;
          </a>
          <a href="#theses" class="text-action">
            Ph.D. &amp; M.Sc. Theses ({THESES.length}) &darr;
          </a>
        </div>
      </header>

      <!-- Metrics & Yearly Citations -->
      <section class="rule-section" style="padding-top: 0;">
        <div class="ledger-five" aria-label="Verified Google Scholar metrics">
          <div class="l-tile">
            <strong class="tabular-nums">{metrics.citations.toLocaleString()}</strong>
            <span>Citations</span>
          </div>
          <div class="l-tile">
            <strong class="tabular-nums">{(metrics.citationsSinceRecent ?? metrics.citationsSince2021).toLocaleString()}</strong>
            <span>Since {metrics.citationsSinceYear}</span>
          </div>
          <div class="l-tile">
            <strong class="tabular-nums">{metrics.hIndex}</strong>
            <span>h-index</span>
          </div>
          <div class="l-tile">
            <strong class="tabular-nums">{metrics.i10Index}</strong>
            <span>i10-index</span>
          </div>
          <div class="l-tile">
            <strong class="tabular-nums">{sortedPubs.length}</strong>
            <span>Cataloged Papers</span>
          </div>
        </div>

        <div class="chart-panel">
          <div class="chart-head">
            <span>Citations per Year (Google Scholar Exact, Updated {metrics.updatedAt})</span>
            <span id="chartReadout" class="chart-readout tabular-nums">Hover or click any year bar to filter papers</span>
          </div>
          <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`Interactive citations per year from ${years[0]} to ${years[years.length - 1]}`}>
            {years.map((y, idx) => {
              const v = vals[idx];
              const barH = Math.max(4, (v / maxVal) * (H - padT - padB));
              const x = padL + slot * idx + (slot - barW) / 2;
              const yTop = H - padB - barH;
              const cx = x + barW / 2;
              const ms = milestones[y];
              const hasPapers = yearsWithPapers.has(y);
              const isThesisYear = y === '2023';
              const isInteractive = hasPapers || isThesisYear;
              const titleText = hasPapers
                ? `${y}: ${v} citations${ms ? ` (${ms})` : ''} · click to filter ${y} papers`
                : isThesisYear
                ? `${y}: ${v} citations (2023 PhD) · click to jump to thesis monograph`
                : `${y}: ${v} citations across prior works`;
              return (
                <g
                  class:list={['chart-col', !isInteractive ? 'is-static' : '']}
                  data-year={y}
                  data-cites={v}
                  data-action={isThesisYear ? 'thesis' : hasPapers ? 'filter' : 'static'}
                  role={isInteractive ? 'button' : 'presentation'}
                  tabindex={isInteractive ? '0' : undefined}
                  aria-pressed={isInteractive ? 'false' : undefined}
                  aria-label={
                    isThesisYear
                      ? `Jump to 2023 PhD thesis monograph (${v} citations)`
                      : hasPapers
                      ? `Filter publications from ${y} (${v} citations)`
                      : undefined
                  }
                >
                  <title>{titleText}</title>
                  {ms && y === '2025' && years[idx + 1] === '2026' ? (() => {
                    const cxNext = padL + slot * (idx + 1) + (slot - barW) / 2 + barW / 2;
                    const midX = (cx + cxNext) / 2;
                    const vNext = vals[idx + 1];
                    const barHNext = Math.max(4, (vNext / maxVal) * (H - padT - padB));
                    const yTopNext = H - padB - barHNext;
                    return (
                      <g class="chart-milestone-grp" aria-hidden="true">
                        <line x1={cx.toFixed(1)} y1="15" x2={cxNext.toFixed(1)} y2="15" class="chart-ms-line" />
                        <line x1={cx.toFixed(1)} y1="15" x2={cx.toFixed(1)} y2={(yTop - 16).toFixed(1)} class="chart-ms-line" />
                        <line x1={cxNext.toFixed(1)} y1="15" x2={cxNext.toFixed(1)} y2={(yTopNext - 16).toFixed(1)} class="chart-ms-line" />
                        <text x={midX.toFixed(1)} y="11" text-anchor="middle" class="chart-milestone">{ms}</text>
                      </g>
                    );
                  })() : ms ? (
                    <g class="chart-milestone-grp" aria-hidden="true">
                      <line x1={cx.toFixed(1)} y1="15" x2={cx.toFixed(1)} y2={(yTop - 16).toFixed(1)} class="chart-ms-line" />
                      <text x={cx.toFixed(1)} y="11" text-anchor="middle" class="chart-milestone">{ms}</text>
                    </g>
                  ) : null}
                  <rect x={(x - 4).toFixed(1)} y={padT - 14} width={(barW + 8).toFixed(1)} height={H - padT - padB + 28} fill="transparent" />
                  <rect x={x.toFixed(1)} y={yTop.toFixed(1)} width={barW.toFixed(1)} height={barH.toFixed(1)} rx="1" class="chart-bar" />
                  <text x={cx.toFixed(1)} y={(yTop - 5).toFixed(1)} text-anchor="middle" class="chart-val tabular-nums">{v}</text>
                  <text x={cx.toFixed(1)} y={(H - 7).toFixed(1)} text-anchor="middle" class="chart-yr">{y}</text>
                </g>
              );
            })}
          </svg>
          <div class="chart-year-strip" role="group" aria-label="Filter publications by year">
            <span class="yr-strip-lbl">Filter by year:</span>
            {years
              .filter((y) => yearsWithPapers.has(y) || y === '2023')
              .map((y) => (
                <button
                  type="button"
                  class="yr-chip"
                  data-year={y}
                  data-action={y === '2023' ? 'thesis' : 'filter'}
                  aria-pressed="false"
                >
                  {y === '2023' ? '2023 (PhD)' : y}
                </button>
              ))}
          </div>
          {undatedCitationDelta > 0 && (
            <p class="chart-footnote tabular-nums">
              {datedCitationSum.toLocaleString()} dated citations ({years[0]}&ndash;{years[years.length - 1]}) + {undatedCitationDelta} undated Google Scholar citations = {metrics.citations.toLocaleString()} total.
            </p>
          )}
        </div>
      </section>

      <!-- Filter, Search & Bibliography Ledger -->
      <section class="rule-section">
        <div class="controls-bar">
          <div class="filter-strip" style="margin-top: 0;" role="group" aria-label="Filter publications by category or venue">
            <button type="button" class="filter-btn" aria-pressed="true" data-filter="all">All ({sortedPubs.length})</button>
            <button type="button" class="filter-btn" aria-pressed="false" data-filter="saail">SAAIL Lab ({saailCount})</button>
            <button type="button" class="filter-btn" aria-pressed="false" data-filter="journal">Journals</button>
            <button type="button" class="filter-btn" aria-pressed="false" data-filter="conference">Conferences &amp; Workshops</button>
            <button type="button" class="filter-btn" aria-pressed="false" data-filter="preprint">Under Review ({underReviewCount})</button>
            <button type="button" class="filter-btn" aria-pressed="false" data-filter="oa">Open Access ({openAccessCount})</button>
          </div>

          <div class="search-sort">
            <input id="pubSearch" type="search" placeholder="Search title, author, venue, DOI..." aria-label="Search publications" class="search-input" />
            <select id="pubSort" aria-label="Sort publications" class="sort-select">
              <option value="default">Newest First</option>
              <option value="citations">Most Cited</option>
              <option value="title">Title A-Z</option>
            </select>
          </div>
        </div>

        <div class="result-bar">
          <p class="result-count" id="resultCount" aria-live="polite">
            Showing {sortedPubs.length} of {sortedPubs.length} publications
          </p>
          <div class="result-actions">
            <button type="button" id="copyVisibleBibBtn" class="bib-batch-btn">
              Copy Visible BibTeX ({sortedPubs.length + THESES.length})
            </button>
            <button type="button" id="downloadVisibleBibBtn" class="bib-batch-btn">
              Download .bib ({sortedPubs.length + THESES.length})
            </button>
            <button type="button" id="resetFilters" class="reset-btn" hidden>Reset Filters</button>
          </div>
        </div>

        <div class="topic-filter-bar" role="group" aria-label="Filter publications by popular topic">
          <span class="yr-strip-lbl">Top topics:</span>
          {topTopics.map(({ topic, count }) => (
            <button type="button" class="topic-pill" data-topic={topic} aria-pressed="false">
              {topic} ({count})
            </button>
          ))}
        </div>

        <p id="copyAnnounce" class="sr-only" aria-live="polite"></p>

        <ol class="bib-list" id="pubList">
          {sortedPubs.map((pub, idx) => {
            const bibId = `bib-${pub.slug}`;
            return (
              <li
                class="pub-entry"
                data-idx={idx}
                data-year={String(pub.year)}
                data-citations={pub.citations}
                data-title={pub.title.toLowerCase()}
                data-saail={pub.isSaailLab ? 'yes' : 'no'}
                data-category={pub.category}
                data-oa={pub.openAccess ? 'yes' : 'no'}
                data-topics={pub.topics.map((t) => t.toLowerCase()).join('|')}
                data-extra={`${pub.doi} ${pub.topics.join(' ')}`.toLowerCase()}
              >
                <div class="pub-yr-col">
                  <span class="pub-yr tabular-nums">{pub.year}</span>
                  <span class:list={['pub-short', pub.category === 'preprint' ? 'is-review' : '']}>{pub.venueShort}</span>
                  {pub.isSaailLab && <span class="pub-lab">SAAIL Lab</span>}
                  {pub.award && <span class="pub-award">{pub.award}</span>}
                  {pub.citations > 0 && (
                    <span class="pub-cit tabular-nums">
                      {pub.citations} {pub.citations === 1 ? 'citation' : 'citations'}
                    </span>
                  )}
                </div>

                <div class="pub-body">
                  <h2 class="pub-title">
                    {pub.doi ? (
                      <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">
                        {pub.title}
                      </a>
                    ) : pub.isSaailLab ? (
                      <a href={pub.saailPaperUrl} target="_blank" rel="noopener">
                        {pub.title}
                      </a>
                    ) : (
                      <a href={`/papers/${pub.slug}/`}>
                        {pub.title}
                      </a>
                    )}
                  </h2>
                  <p class="pub-authors">
                    {pub.authors.map((a, i) => (
                      <>
                        {isInnocentNyalala(a) ? <strong>{a}</strong> : a}
                        {i < pub.authors.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </p>
                  <p class="pub-venue-full">
                    <em>{pub.venue}</em>
                    {pub.impactFactor ? ` · ${pub.impactFactor}` : ''}
                    {pub.openAccess ? ' · Open Access' : ''}
                  </p>
                  <p class="pub-tldr">{pub.tldr}</p>

                  {pub.topics && pub.topics.length > 0 && (
                    <p class="pub-topics-inline" aria-label="Topics">
                      {pub.topics.map((topic, tIdx) => (
                        <>
                          {tIdx > 0 ? <span class="topic-sep" aria-hidden="true"> &middot; </span> : null}
                          <a
                            href={`/publications/?topic=${encodeURIComponent(topic)}`}
                            class="pub-topic-link"
                            data-topic={topic}
                          >
                            {topic}
                          </a>
                        </>
                      ))}
                    </p>
                  )}

                  <div class="pub-actions">
                    {pub.isSaailLab ? (
                      <a href={pub.saailPaperUrl} target="_blank" rel="noopener" class="row-ext">
                        SAAIL Companion &#8599;
                      </a>
                    ) : (
                      <a href={`/papers/${pub.slug}/`} class="row-ext">
                        Project Companion &rarr;
                      </a>
                    )}
                    {pub.doi && (
                      <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" class="row-ext">
                        DOI &#8599;
                      </a>
                    )}
                    {!pub.doi && pub.paperUrl && (
                      <a href={pub.paperUrl} target="_blank" rel="noopener" class="row-ext">
                        Paper / PDF &#8599;
                      </a>
                    )}
                    {pub.codeUrl && (
                      <a href={pub.codeUrl} target="_blank" rel="noopener" class="row-ext">
                        Code &#8599;
                      </a>
                    )}
                    {pub.datasetUrl && (
                      <a href={pub.datasetUrl} target="_blank" rel="noopener" class="row-ext">
                        Dataset &#8599;
                      </a>
                    )}
                    {pub.bibtex && (
                      <button type="button" class="bib-btn bib-toggle" aria-expanded="false" aria-controls={bibId}>
                        BibTeX
                      </button>
                    )}
                    <button type="button" class="bib-btn copy-apa-inline" data-apa={formatApaCitation(pub)}>
                      Cite (APA)
                    </button>
                  </div>

                  {pub.bibtex && (
                    <div id={bibId} class="bib-panel" hidden>
                      <pre><code>{pub.bibtex}</code></pre>
                      <button type="button" class="bib-btn copy-bib">Copy BibTeX</button>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>

        <div id="pubEmptyState" class="filter-empty-state" hidden>
          <p>No publications matched the current filter or search term.</p>
          <button type="button" id="emptyResetPubs" class="reset-btn">Reset Filters</button>
        </div>
      </section>

      <!-- Graduate Thesis Monographs (Excluded from Paper Count) -->
      <section id="theses" class="rule-section">
        <span class="mono-eyebrow">Graduate Monographs &middot; Excluded from {sortedPubs.length}-Paper Tally</span>
        <div class="section-bar">
          <h2 class="section-h">Graduate Thesis Monographs ({THESES.length})</h2>
        </div>
        <p class="section-intro">
          Doctoral and master&rsquo;s engineering degree monographs are indexed separately from the {sortedPubs.length} journal articles, peer-reviewed conference papers, and manuscripts under review above.
        </p>

        <ol class="bib-list">
          {THESES.map((th) => {
            const bibId = `bib-${th.slug}`;
            return (
              <li class="pub-entry">
                <div class="pub-yr-col">
                  <span class="pub-yr tabular-nums">{th.year}</span>
                  <span class="pub-short">{th.shortLabel}</span>
                  <span class="pub-lab">Monograph</span>
                </div>
                <div class="pub-body">
                  <h3 class="pub-title">
                    <a href={`/publications/theses/${th.slug}/`}>{th.title}</a>
                  </h3>
                  <p class="pub-venue-full">
                    <em>{th.degree}</em> &middot; {th.department} &middot; {th.institution} ({th.period})
                  </p>
                  <p class="pub-authors-line">
                    Supervisor{th.supervisors.includes(' and ') ? 's' : ''}: {th.supervisors}
                  </p>
                  <p class="pub-tldr">{th.summary}</p>
                  <div class="pub-actions">
                    <a
                      href={th.slug === 'msc-thesis-2016' ? '/papers/intelligent-greenhouse-arduino-2016/' : `/papers/${th.slug}/`}
                      class="row-ext"
                    >
                      Project Companion &rarr;
                    </a>
                    <a href={`/publications/theses/${th.slug}/`} class="row-ext">
                      Monograph Record &rarr;
                    </a>
                    <button type="button" class="bib-btn bib-toggle" aria-expanded="false" aria-controls={bibId}>
                      BibTeX
                    </button>
                  </div>
                  <div id={bibId} class="bib-panel" hidden>
                    <pre><code>{th.bibtex}</code></pre>
                    <button type="button" class="bib-btn copy-bib">Copy BibTeX</button>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    </main>

    <SiteFooter />
  </div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var mainEl = document.getElementById('main-content');
    var listEl = document.getElementById('pubList');
    var searchEl = document.getElementById('pubSearch');
    var sortEl = document.getElementById('pubSort');
    var countEl = document.getElementById('resultCount');
    var emptyEl = document.getElementById('pubEmptyState');
    var emptyResetEl = document.getElementById('emptyResetPubs');
    var resetBtn = document.getElementById('resetFilters');
    var copyVisibleBtn = document.getElementById('copyVisibleBibBtn');
    var downloadVisibleBtn = document.getElementById('downloadVisibleBibBtn');
    var chartReadout = document.getElementById('chartReadout');
    var chartCols = document.querySelectorAll('.chart-col');
    var yrChips = document.querySelectorAll('.yr-chip');
    var topicPills = document.querySelectorAll('.topic-pill');
    var announceEl = document.getElementById('copyAnnounce');
    var tabs = document.querySelectorAll('.filter-btn');
    if (!listEl) return;

    var cards = Array.prototype.slice.call(listEl.querySelectorAll('.pub-entry'));
    var activeFilter = 'all';
    var activeYear = '';
    var activeTopic = '';

    function copyTextFallback(text) {
      if (!text) return Promise.resolve(false);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(function () { return true; }).catch(function () {
          return execCopy(text);
        });
      }
      return Promise.resolve(execCopy(text));
    }

    function execCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      return ok;
    }

    function getVisibleBibBundle() {
      var entries = [];
      cards.forEach(function (card) {
        if (card.style.display === 'none') return;
        var codeEl = card.querySelector('.bib-panel pre code');
        if (codeEl && codeEl.textContent) {
          entries.push(codeEl.textContent.trim());
        }
      });
      var q = ((searchEl && searchEl.value) || '').trim();
      var isUnfiltered = activeFilter === 'all' && !activeYear && !activeTopic && !q;
      if (isUnfiltered) {
        var thesesSec = document.getElementById('theses');
        if (thesesSec) {
          thesesSec.querySelectorAll('.bib-panel pre code').forEach(function (codeEl) {
            if (codeEl && codeEl.textContent) entries.push(codeEl.textContent.trim());
          });
        }
      }
      return { count: entries.length, text: entries.join('\n\n') };
    }

    function jumpToTheses() {
      var thesesEl = document.getElementById('theses');
      if (!thesesEl) return;
      thesesEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      thesesEl.classList.add('is-flash');
      setTimeout(function () { thesesEl.classList.remove('is-flash'); }, 1600);
      if (chartReadout) {
        chartReadout.textContent = '2023: 119 citations · scrolled to PhD & MSc Thesis Monographs';
      }
    }

    function syncYearAndTopicUI() {
      chartCols.forEach(function (col) {
        if (col.getAttribute('data-action') !== 'filter') return;
        var on = col.getAttribute('data-year') === activeYear && activeYear !== '';
        col.classList.toggle('is-active', on);
        col.setAttribute('aria-pressed', String(on));
      });
      yrChips.forEach(function (chip) {
        if (chip.getAttribute('data-action') !== 'filter') return;
        var on = chip.getAttribute('data-year') === activeYear && activeYear !== '';
        chip.classList.toggle('is-active', on);
        chip.setAttribute('aria-pressed', String(on));
      });
      topicPills.forEach(function (pill) {
        var tLow = (pill.getAttribute('data-topic') || '').toLowerCase();
        var on = Boolean(activeTopic) && tLow === activeTopic.toLowerCase();
        pill.classList.toggle('is-active', on);
        pill.setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll('.pub-topic-link').forEach(function (link) {
        var tLow = (link.getAttribute('data-topic') || '').toLowerCase();
        link.classList.toggle('is-active', Boolean(activeTopic) && tLow === activeTopic.toLowerCase());
      });
    }

    function syncUrl() {
      try {
        var params = new URLSearchParams(window.location.search);
        if (activeFilter !== 'all') params.set('filter', activeFilter);
        else params.delete('filter');
        if (activeYear) params.set('year', activeYear);
        else params.delete('year');
        if (activeTopic) params.set('topic', activeTopic);
        else params.delete('topic');
        var qVal = ((searchEl && searchEl.value) || '').trim();
        if (qVal) params.set('q', qVal);
        else params.delete('q');
        var sVal = (sortEl && sortEl.value) || 'default';
        if (sVal !== 'default') params.set('sort', sVal);
        else params.delete('sort');
        var qs = params.toString();
        var nextUrl = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        window.history.replaceState(null, '', nextUrl);
      } catch (e) {}
    }

    function applyFilterAndSort(skipUrl) {
      var q = ((searchEl && searchEl.value) || '').trim().toLowerCase();
      var sortMode = (sortEl && sortEl.value) || 'default';
      var tLow = activeTopic.toLowerCase();

      var sorted = cards.slice().sort(function (a, b) {
        if (sortMode === 'citations') {
          return Number(b.getAttribute('data-citations') || 0) - Number(a.getAttribute('data-citations') || 0);
        }
        if (sortMode === 'title') {
          return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
        }
        return Number(a.getAttribute('data-idx') || 0) - Number(b.getAttribute('data-idx') || 0);
      });

      var visible = 0;
      sorted.forEach(function (card) {
        listEl.appendChild(card);
        var cat = card.getAttribute('data-category') || '';
        var yr = card.getAttribute('data-year') || '';
        var saail = card.getAttribute('data-saail') === 'yes';
        var oa = card.getAttribute('data-oa') === 'yes';
        var topicsArr = (card.getAttribute('data-topics') || '').split('|').filter(Boolean);
        var hay = (card.textContent + ' ' + (card.getAttribute('data-extra') || '')).toLowerCase();

        var matchTab =
          activeFilter === 'all' ||
          (activeFilter === 'saail' && saail) ||
          (activeFilter === 'journal' && cat === 'journal') ||
          (activeFilter === 'conference' && (cat === 'conference' || cat === 'workshop')) ||
          (activeFilter === 'preprint' && cat === 'preprint') ||
          (activeFilter === 'oa' && oa);

        var matchYear = !activeYear || yr === activeYear;
        var matchTopic = !tLow || topicsArr.indexOf(tLow) !== -1;
        var matchSearch = !q || hay.indexOf(q) !== -1;
        var show = matchTab && matchYear && matchTopic && matchSearch;
        card.style.display = show ? 'grid' : 'none';
        if (show) visible++;
      });

      if (emptyEl) emptyEl.hidden = visible > 0;
      var isFiltered = activeFilter !== 'all' || Boolean(activeYear) || Boolean(activeTopic) || Boolean(q) || sortMode !== 'default';
      if (resetBtn) resetBtn.hidden = !isFiltered;

      var bibBundle = getVisibleBibBundle();
      if (copyVisibleBtn) {
        copyVisibleBtn.textContent = 'Copy Visible BibTeX (' + bibBundle.count + ')';
        copyVisibleBtn.disabled = bibBundle.count === 0;
      }
      if (downloadVisibleBtn) {
        downloadVisibleBtn.textContent = 'Download .bib (' + bibBundle.count + ')';
        downloadVisibleBtn.disabled = bibBundle.count === 0;
      }

      if (countEl) {
        var parts = [];
        if (activeFilter !== 'all') {
          var activeBtn = document.querySelector('.filter-btn[aria-pressed="true"]');
          var lbl = activeBtn ? activeBtn.textContent.replace(/\s*\(\d+\)\s*$/, '') : activeFilter;
          parts.push(lbl);
        }
        if (activeYear) parts.push('Year: ' + activeYear);
        if (activeTopic) parts.push('Topic: ' + activeTopic);
        if (q && searchEl) parts.push('"' + searchEl.value.trim() + '"');
        var suffix = parts.length ? ' (' + parts.join(' + ') + ')' : '';
        countEl.textContent = 'Showing ' + visible + ' of ' + cards.length + ' publications' + suffix;
      }

      syncYearAndTopicUI();
      if (!skipUrl) syncUrl();
    }

    function toggleYear(yr) {
      activeYear = activeYear === yr ? '' : yr;
      applyFilterAndSort();
    }

    function toggleTopic(topic) {
      activeTopic = activeTopic.toLowerCase() === topic.toLowerCase() ? '' : topic;
      applyFilterAndSort();
    }

    function resetAll() {
      if (searchEl) searchEl.value = '';
      if (sortEl) sortEl.value = 'default';
      activeFilter = 'all';
      activeYear = '';
      activeTopic = '';
      tabs.forEach(function (b) {
        var isAll = b.getAttribute('data-filter') === 'all';
        b.setAttribute('aria-pressed', String(isAll));
      });
      applyFilterAndSort();
      searchEl && searchEl.focus();
    }

    // Hydrate from URL query parameters
    try {
      var initParams = new URLSearchParams(window.location.search);
      var initFilter = initParams.get('filter');
      var initYear = initParams.get('year');
      var initTopic = initParams.get('topic');
      var initQ = initParams.get('q');
      var initSort = initParams.get('sort');
      if (initFilter) {
        tabs.forEach(function (b) {
          var match = b.getAttribute('data-filter') === initFilter;
          b.setAttribute('aria-pressed', String(match));
          if (match) activeFilter = initFilter;
        });
      }
      if (initYear) activeYear = initYear;
      if (initTopic) activeTopic = initTopic;
      if (initQ && searchEl) searchEl.value = initQ;
      if (initSort && sortEl) sortEl.value = initSort;
      if (initFilter || initYear || initTopic || initQ || initSort) applyFilterAndSort(true);
    } catch (e) {}

    chartCols.forEach(function (col) {
      var yr = col.getAttribute('data-year') || '';
      var cites = col.getAttribute('data-cites') || '';
      var action = col.getAttribute('data-action') || 'static';
      var updateReadout = function () {
        if (!chartReadout) return;
        if (action === 'thesis') {
          chartReadout.textContent = yr + ': ' + cites + ' citations (click to view 2023 PhD thesis monograph)';
        } else if (action === 'filter') {
          chartReadout.textContent = yr + ': ' + cites + ' citations (click to filter ' + yr + ' papers)';
        } else {
          chartReadout.textContent = yr + ': ' + cites + ' citations across earlier publications';
        }
      };
      col.addEventListener('mouseenter', updateReadout);
      if (action === 'static') return;
      col.addEventListener('focus', updateReadout);
      col.addEventListener('click', function () {
        if (action === 'thesis') jumpToTheses();
        else toggleYear(yr);
      });
      col.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (action === 'thesis') jumpToTheses();
          else toggleYear(yr);
        }
      });
    });

    yrChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (chip.getAttribute('data-action') === 'thesis') jumpToTheses();
        else toggleYear(chip.getAttribute('data-year') || '');
      });
    });

    var copyTimer = null;
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(function (b) {
          b.setAttribute('aria-pressed', 'false');
        });
        btn.setAttribute('aria-pressed', 'true');
        activeFilter = btn.getAttribute('data-filter') || 'all';
        applyFilterAndSort();
      });
    });

    resetBtn && resetBtn.addEventListener('click', resetAll);
    emptyResetEl && emptyResetEl.addEventListener('click', resetAll);

    searchEl && searchEl.addEventListener('input', function () { applyFilterAndSort(); });
    sortEl && sortEl.addEventListener('change', function () { applyFilterAndSort(); });

    copyVisibleBtn &&
      copyVisibleBtn.addEventListener('click', function () {
        var bundle = getVisibleBibBundle();
        if (!bundle.count) return;
        copyTextFallback(bundle.text).then(function (ok) {
          if (ok) {
            if (copyTimer) clearTimeout(copyTimer);
            var origText = 'Copy Visible BibTeX (' + bundle.count + ')';
            copyVisibleBtn.textContent = 'Copied! (' + bundle.count + ')';
            if (announceEl) announceEl.textContent = 'Copied ' + bundle.count + ' BibTeX entries to clipboard.';
            if (window.__showMonoToast) window.__showMonoToast('Copied ' + bundle.count + ' BibTeX entries');
            copyTimer = setTimeout(function () {
              copyVisibleBtn.textContent = origText;
            }, 1600);
          }
        });
      });

    downloadVisibleBtn &&
      downloadVisibleBtn.addEventListener('click', function () {
        var bundle = getVisibleBibBundle();
        if (!bundle.count) return;
        var blob = new Blob([bundle.text + '\n'], { type: 'application/x-bibtex;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'nyalala-publications-' + bundle.count + '.bib';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        if (window.__showMonoToast) window.__showMonoToast('Downloaded nyalala-publications-' + bundle.count + '.bib');
      });

    (mainEl || listEl).addEventListener('click', function (e) {
      var target = e.target;
      var topicBtn = target.closest('.topic-pill');
      if (topicBtn) {
        toggleTopic(topicBtn.getAttribute('data-topic') || '');
        return;
      }

      var topicLink = target.closest('.pub-topic-link');
      if (topicLink && !e.metaKey && !e.ctrlKey && !e.shiftKey) {
        e.preventDefault();
        var chosen = topicLink.getAttribute('data-topic') || '';
        toggleTopic(chosen);
        if (announceEl) {
          announceEl.textContent = activeTopic ? 'Filtered to topic: ' + activeTopic : 'Cleared topic filter';
        }
        var controlsEl = document.querySelector('.controls-bar');
        if (activeTopic && controlsEl) {
          controlsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }

      var apaBtn = target.closest('.copy-apa-inline');
      if (apaBtn) {
        var apaTxt = apaBtn.getAttribute('data-apa') || '';
        copyTextFallback(apaTxt).then(function (ok) {
          if (ok) {
            apaBtn.textContent = 'Copied!';
            if (announceEl) announceEl.textContent = 'APA citation copied to clipboard.';
            if (window.__showMonoToast) window.__showMonoToast('APA citation copied to clipboard');
            setTimeout(function () {
              apaBtn.textContent = 'Cite (APA)';
            }, 1600);
          }
        });
        return;
      }

      var toggle = target.closest('.bib-toggle');
      if (toggle) {
        var panel = toggle.closest('.pub-body') && toggle.closest('.pub-body').querySelector('.bib-panel');
        if (!panel) return;
        var willOpen = panel.hidden;
        panel.hidden = !willOpen;
        toggle.setAttribute('aria-expanded', String(willOpen));
        return;
      }

      var copyBtn = target.closest('.copy-bib');
      if (copyBtn) {
        var preEl = copyBtn.previousElementSibling;
        var txt = preEl ? preEl.textContent || '' : '';
        copyTextFallback(txt).then(function (ok) {
          if (ok) {
            copyBtn.textContent = 'Copied!';
            if (announceEl) announceEl.textContent = 'BibTeX entry copied to clipboard.';
            if (window.__showMonoToast) window.__showMonoToast('BibTeX entry copied to clipboard');
            setTimeout(function () {
              copyBtn.textContent = 'Copy BibTeX';
            }, 1600);
          }
        });
      }
    });
  });
</script>
</BaseLayout>

