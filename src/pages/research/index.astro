---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PROFILE } from '../../data/profile';
import metrics from '../../data/scholar-metrics.json';
import { getImageDim, getThumbSrc } from '../../data/media';
import { breadcrumbList, personEntity, websiteEntity } from '../../data/schema';

const pillars = [
  {
    id: 'agriculture',
    num: 'I · Precision Agriculture & Blue Economy',
    title: 'Agricultural Vision, Commodity Grading & Coastal Seaweed Sensing',
    summary:
      'Smallholder crops and coastal livelihoods require lightweight neural models that resist background shortcuts and run offline on modest mobile phones. Work spans cross-crop pathology (CropGuardNet, 35,420 deduplicated leaf images at 5.00 ms CPU ONNX), commercial Zanzibar clove grading (ETRI Journal 2026, CVPR 2026 V4A, ZSTC-Clove-V1), IC&SR-funded CashewAI orchard scouting, and marine heatwave modeling for Zanzibar seaweed.',
    image: '/images/research/cropguardnet-architecture.webp',
    imageAlt: 'CropGuardNet lightweight CNN-Transformer architecture diagram',
    caption: 'CropGuardNet architecture: 481,574 parameters and 63.8M FLOPs running at 200 FPS on CPU ONNX.',
    labHref: 'https://saaillab.github.io/projects/cropguard-pathology/',
    labLabel: 'Crop Pathology & Clove Projects'
  },
  {
    id: 'swahili',
    num: 'II · Swahili NLP & Provenance',
    title: 'Zanzibar Swahili Corpus & Dira Translationese Detection',
    summary:
      'Public African NLP datasets often rely on machine-translated English text that drops coastal Kiunguja phrasing and agricultural domain context. We curate authentic written and spoken Swahili alongside the Dira provenance detector and CARA-FM edge foundation model framework (PMLR Vol. 302).',
    image: '/images/research/swahili-corpus.png',
    imageAlt: 'Zanzibar Swahili Corpus source distribution chart',
    caption: 'Zanzibar Swahili Corpus distribution across regional news, civic, and agricultural Kiunguja sources.',
    labHref: 'https://saaillab.github.io/projects/swahili-dira/',
    labLabel: 'Swahili Corpus & Dira Project'
  },
  {
    id: 'responsible',
    num: 'III · Responsible AI & Policy',
    title: 'Deployment-Gap Auditing & East African AI Governance',
    summary:
      'Standard top-1 accuracy hides minority-class collapse under field prevalence skew and acquisition-session confounding. DGS-Bench (DLI 2026 Best Poster) quantifies these evaluation gaps across 40 controlled runs; complementary studies examine DCGAN failure modes (DSA 2026), Dynamic Data Re-weighting (ICLR 2026), and East African AI policy harmonization (Oxford TAIS 2026, AAAI 2026).',
    image: '/images/research/dgs-bench-gap.png',
    imageAlt: 'DGS-Bench accuracy versus macro-F1 deployment gap plots',
    caption: 'DGS-Bench results across 40 experimental runs exposing accuracy mirages on smallholder cassava splits.',
    labHref: 'https://saaillab.github.io/projects/responsible-ai-global-south/',
    labLabel: 'Responsible AI & Governance'
  },
  {
    id: 'healthcare',
    num: 'IV · Healthcare & Clinical ML',
    title: 'Placental Morphometry, Maternal Biomarkers & Segmentation',
    summary:
      'In partnership with Penn State University and CPHK Pemba, PlacentaVision automates calibrated three-view placental segmentation across 9,883 bedside photographs (98.92% QC pass rate). Parallel clinical work builds SHAP-explainable preterm birth models and boundary-gated colorectal polyp segmentation (BAFNet, ESWA 2025).',
    image: '/images/research/placentavision-pipeline.webp',
    imageAlt: 'PlacentaVision three-view segmentation and morphometry framework',
    caption: 'PlacentaVision three-view segmentation pipeline pairing anatomical masks with calibration-ruler scaling.',
    labHref: 'https://saaillab.github.io/projects/placentavision/',
    labLabel: 'PlacentaVision Clinical Consortium'
  }
];

const partners = [
  { region: 'Zanzibar, Tanzania', name: 'Zanzibar State Trading Corporation (ZSTC)', scope: 'CLOVES-4603, ZSTC-Clove-V1 & Ubora-AI grading prototype' },
  { region: 'Pemba & India', name: 'Center for Public Health Kinetics (CPHK)', scope: 'Four co-supervised PhD studies in maternal & neonatal clinical ML' },
  { region: 'Chennai, India', name: 'Wadhwani School of Data Science & AI, IIT Madras', scope: 'CARA-FM (PMLR 302) & Global South AI sovereignty (AAAI 2026)' },
  { region: 'Pennsylvania, USA', name: 'Pennsylvania State University', scope: 'PlacentaVision calibrated placental segmentation consortium' },
  { region: 'Victoria, Australia', name: 'Deakin University & Agriculture Victoria Research', scope: 'Joint cotutelle PhD on agentic agricultural IoT systems' },
  { region: 'United Kingdom', name: 'Oxford TAIS, Cambridge & Salford Collaborators', scope: 'East African AI policy harmonization & 7-axis sovereignty audits' },
  { region: 'China', name: 'Nanjing Agricultural Univ. & Xuzhou Univ. of Technology', scope: 'BAFNet (ESWA 2025) & foliar cassava detection (COMPAG, AIIA)' },
  { region: 'New York, USA', name: 'Columbia University', scope: 'Environmental air-quality sensing and public health analytics' }
];

const researchSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    {
      '@type': 'CollectionPage',
      '@id': 'https://inyalala.github.io/research/#webpage',
      url: 'https://inyalala.github.io/research/',
      name: 'Research Agenda & Grants | Innocent Nyalala · IITMZ',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      about: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': 'https://inyalala.github.io/research/#breadcrumb' }
    },
    {
      '@type': 'Dataset',
      '@id': 'https://inyalala.github.io/research/#dataset-cloves-4603',
      name: 'CLOVES-4603 Zanzibar Clove Grading Dataset',
      description: 'Lot-aware commercial Zanzibar clove dataset of 4,603 expert-graded images across four ZSTC quality tiers.',
      url: 'https://github.com/saaillab/CLOVES-4603',
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      creator: { '@id': 'https://inyalala.github.io/#person' }
    },
    {
      '@type': 'Dataset',
      '@id': 'https://inyalala.github.io/research/#dataset-cropguardnet',
      name: 'CropGuardNet Deduplicated Multi-Crop Pathology Benchmark',
      description: 'Perceptually deduplicated 35,420-image benchmark spanning 8 crops and 38 foliar pathology classes.',
      url: 'https://github.com/saaillab/CropGuardNet',
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      creator: { '@id': 'https://inyalala.github.io/#person' }
    },
    {
      '@type': 'Dataset',
      '@id': 'https://inyalala.github.io/research/#dataset-dgs-bench',
      name: 'DGS-Bench Deployment-Gap Auditing Suite',
      description: 'Controlled 40-run evaluation suite measuring minority-class accuracy mirages under smallholder prevalence skew.',
      url: 'https://saaillab.github.io/papers/dgs-bench/',
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      creator: { '@id': 'https://inyalala.github.io/#person' }
    },
    {
      '@type': 'Dataset',
      '@id': 'https://inyalala.github.io/research/#dataset-swahili-dira',
      name: 'Zanzibar Swahili Corpus & Dira Provenance Benchmark',
      description: 'Coastal Kiunguja and Pemba Swahili corpus paired with translationese provenance evaluation splits.',
      url: 'https://saaillab.github.io/projects/swahili-dira/',
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      creator: { '@id': 'https://inyalala.github.io/#person' }
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Research Agenda', url: 'https://inyalala.github.io/research/' }
      ],
      'https://inyalala.github.io/research/#breadcrumb'
    )
  ]
};
---

<BaseLayout
  title="Research Agenda & Grants | Innocent Nyalala · IITMZ"
  description="Research in agricultural vision, Swahili NLP, responsible AI, and clinical machine learning led by Innocent Nyalala at IIT Madras Zanzibar."
  canonical="https://inyalala.github.io/research/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(researchSchema)} />
  </Fragment>

  <MonographRail currentPage="research" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">Research Monograph &middot; IIT Madras Zanzibar</span>
        <h1 class="page-title">Research Agenda &amp; Consortia</h1>
        <p class="page-lead">
          My research program designs machine learning, computer vision, and natural language systems around East African field constraints. Interactive lab project portals, team rosters, open datasets, and mobile applications live separately on{' '}
          <a href={PROFILE.labUrl} target="_blank" rel="noopener" class="inline-link">saaillab.github.io &#8599;</a>.
        </p>

        <div class="res-top-actions">
          <a href="/publications/" class="btn-mono">All {metrics.totalWorks} Publications &rarr;</a>
          <a href="/work-with-me/" class="btn-mono-outline">Collaborate or Supervise</a>
          <a href={PROFILE.labUrl} target="_blank" rel="noopener" class="text-action">Open SAAIL Lab Portal &#8599;</a>
        </div>
      </header>

      <!-- Active Grants & Awards Ledger -->
      <section class="rule-section" style="padding-top: 0;">
        <span class="mono-eyebrow">Funded Projects &amp; Recent Recognition</span>
        <h2 class="section-h" style="margin-bottom: 1.15rem;">Active Grants &amp; Selected Honors</h2>
        <div class="grants-ledger">
          <article class="grant-row">
            <span class="grant-k">IC&amp;SR IIT Madras &middot; ERP 2026-27</span>
            <h3>CashewAI: Smallholder Cashew Scouting (Rs. 9.35 Lakhs)</h3>
            <p>
              Principal Investigator on an Industrial Consultancy and Sponsored Research exploratory grant (August 2026 to July 2027) building phenology-aware computer vision for foliar disease, pest detection, and canopy yield prediction in Tanzania.
            </p>
          </article>
          <article class="grant-row">
            <span class="grant-k">Deep Learning Indaba &middot; 2025 &amp; 2026</span>
            <h3>Consecutive Best Poster Awards (Kigali &amp; Lagos)</h3>
            <p>
              Awarded Best Poster at DLI 2026 in Lagos for DGS-Bench (deployment-gap evaluation across Africa) following the DLI 2025 Best Poster Award in Kigali for CARA-FM (PMLR Vol. 302).
            </p>
          </article>
          <article class="grant-row">
            <span class="grant-k">EAC STI Conference &middot; 2026</span>
            <h3>AI4EAC Competitive Grant for ZSTC-Clove-V1 ($980)</h3>
            <p>
              Selected to present industrial clove-grading feasibility models developed with the Zanzibar State Trading Corporation across 5,298 expert-labeled warehouse photographs in Kigali.
            </p>
          </article>
        </div>
      </section>

      <!-- Research Lineage Constellation -->
      <section class="rule-section">
        <span class="mono-eyebrow">Research Lineage Map</span>
        <div class="section-bar">
          <h2 class="section-h">Pillars, Open Systems &amp; Bibliography Links</h2>
          <span id="lineageStatus" class="lineage-status">Hover or focus any node to trace links</span>
        </div>

        <div class="lineage-wrap">
          <svg
            id="lineageSvg"
            viewBox="0 0 820 292"
            width="820"
            height="292"
            role="img"
            aria-label="Research lineage constellation linking four research pillars to five datasets and systems and filtered publication queries"
          >
            <text x="16" y="20" class="lin-col-hd">I · PILLARS</text>
            <text x="310" y="20" class="lin-col-hd">II · DATASETS &amp; SYSTEMS</text>
            <text x="612" y="20" class="lin-col-hd">III · PUBLICATIONS</text>

            <!-- Edges: Pillars -> Systems -->
            <path d="M 220 62 C 265 62, 265 56, 310 56" class="lin-edge" data-lin="ag cloves" />
            <path d="M 220 62 C 265 62, 265 110, 310 110" class="lin-edge" data-lin="ag cropguard" />
            <path d="M 220 124 C 265 124, 265 164, 310 164" class="lin-edge" data-lin="sw dira" />
            <path d="M 220 186 C 265 186, 265 218, 310 218" class="lin-edge" data-lin="resp dgs" />
            <path d="M 220 248 C 265 248, 265 270, 310 270" class="lin-edge" data-lin="health placenta" />

            <!-- Edges: Systems -> Publications -->
            <path d="M 520 56 C 566 56, 566 56, 612 56" class="lin-edge" data-lin="ag cloves" />
            <path d="M 520 110 C 566 110, 566 110, 612 110" class="lin-edge" data-lin="ag cropguard" />
            <path d="M 520 164 C 566 164, 566 164, 612 164" class="lin-edge" data-lin="sw dira" />
            <path d="M 520 218 C 566 218, 566 218, 612 218" class="lin-edge" data-lin="resp dgs" />
            <path d="M 520 270 C 566 270, 566 270, 612 270" class="lin-edge" data-lin="health placenta" />

            <!-- Column 1: Pillars -->
            <a href="#agriculture" class="lin-node" data-group="ag" data-desc="Pillar I: Precision Agriculture & Blue Economy -> CLOVES-4603 & CropGuardNet">
              <rect x="16" y="42" width="204" height="40" rx="2" class="lin-box lin-box-pillar" />
              <text x="28" y="66" class="lin-lbl">01 · Agriculture &amp; Cloves</text>
            </a>
            <a href="#swahili" class="lin-node" data-group="sw" data-desc="Pillar II: Swahili NLP & Provenance -> Zanzibar Corpus & Dira">
              <rect x="16" y="104" width="204" height="40" rx="2" class="lin-box lin-box-pillar" />
              <text x="28" y="128" class="lin-lbl">02 · Swahili NLP &amp; Dira</text>
            </a>
            <a href="#responsible" class="lin-node" data-group="resp" data-desc="Pillar III: Responsible AI & Policy -> DGS-Bench & Auditing">
              <rect x="16" y="166" width="204" height="40" rx="2" class="lin-box lin-box-pillar" />
              <text x="28" y="190" class="lin-lbl">03 · Responsible AI &amp; Policy</text>
            </a>
            <a href="#healthcare" class="lin-node" data-group="health" data-desc="Pillar IV: Healthcare & Clinical ML -> PlacentaVision & BAFNet">
              <rect x="16" y="228" width="204" height="40" rx="2" class="lin-box lin-box-pillar" />
              <text x="28" y="252" class="lin-lbl">04 · Healthcare &amp; Clinical ML</text>
            </a>

            <!-- Column 2: Key Systems / Datasets -->
            <a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="lin-node" data-group="ag cloves" data-desc="CLOVES-4603: 4,603 ZSTC Clove Images (CVPR V4A & ETRI 2026)">
              <rect x="310" y="38" width="210" height="36" rx="2" class="lin-box" />
              <text x="322" y="60" class="lin-lbl">CLOVES-4603 (4,603 imgs)</text>
            </a>
            <a href="https://github.com/saaillab/CropGuardNet" target="_blank" rel="noopener" class="lin-node" data-group="ag cropguard" data-desc="CropGuardNet: 35,420 Deduplicated Leaf Images (5.00 ms ONNX)">
              <rect x="310" y="92" width="210" height="36" rx="2" class="lin-box" />
              <text x="322" y="114" class="lin-lbl">CropGuardNet (481.6K params)</text>
            </a>
            <a href="https://saaillab.github.io/projects/swahili-dira/" target="_blank" rel="noopener" class="lin-node" data-group="sw dira" data-desc="Dira: Coastal Kiunguja Corpus & Translationese Provenance">
              <rect x="310" y="146" width="210" height="36" rx="2" class="lin-box" />
              <text x="322" y="168" class="lin-lbl">Dira Swahili Provenance</text>
            </a>
            <a href="https://saaillab.github.io/papers/dgs-bench/" target="_blank" rel="noopener" class="lin-node" data-group="resp dgs" data-desc="DGS-Bench: 40-Run Deployment-Gap Suite (DLI 2026 Best Poster)">
              <rect x="310" y="200" width="210" height="36" rx="2" class="lin-box" />
              <text x="322" y="222" class="lin-lbl">DGS-Bench (DLI Best Poster)</text>
            </a>
            <a href="https://saaillab.github.io/projects/placentavision/" target="_blank" rel="noopener" class="lin-node" data-group="health placenta" data-desc="PlacentaVision: 9,883 Bedside Images with CPHK Pemba & Penn State">
              <rect x="310" y="252" width="210" height="36" rx="2" class="lin-box" />
              <text x="322" y="274" class="lin-lbl">PlacentaVision (9,883 imgs)</text>
            </a>

            <!-- Column 3: Filtered Publications -->
            <a href="/publications/?q=clove" class="lin-node" data-group="ag cloves" data-desc="Filter Publications for Zanzibar Clove Studies">
              <rect x="612" y="38" width="192" height="36" rx="2" class="lin-box lin-box-out" />
              <text x="624" y="60" class="lin-lbl">Papers: Clove AI &rarr;</text>
            </a>
            <a href="/publications/?q=cropguardnet" class="lin-node" data-group="ag cropguard" data-desc="Filter Publications for CropGuardNet & Foliar Pathology">
              <rect x="612" y="92" width="192" height="36" rx="2" class="lin-box lin-box-out" />
              <text x="624" y="114" class="lin-lbl">Papers: CropGuardNet &rarr;</text>
            </a>
            <a href="/publications/?q=swahili" class="lin-node" data-group="sw dira" data-desc="Filter Publications for Swahili NLP & Provenance">
              <rect x="612" y="146" width="192" height="36" rx="2" class="lin-box lin-box-out" />
              <text x="624" y="168" class="lin-lbl">Papers: Swahili NLP &rarr;</text>
            </a>
            <a href="/publications/?q=dgs-bench" class="lin-node" data-group="resp dgs" data-desc="Filter Publications for DGS-Bench & Auditing">
              <rect x="612" y="200" width="192" height="36" rx="2" class="lin-box lin-box-out" />
              <text x="624" y="222" class="lin-lbl">Papers: DGS-Bench &rarr;</text>
            </a>
            <a href="/publications/?q=placenta" class="lin-node" data-group="health placenta" data-desc="Filter Publications for Placental & Clinical ML">
              <rect x="612" y="252" width="192" height="36" rx="2" class="lin-box lin-box-out" />
              <text x="624" y="274" class="lin-lbl">Papers: Clinical ML &rarr;</text>
            </a>
          </svg>
        </div>
      </section>

      <!-- Four Pillars -->
      <section class="rule-section">
        <span class="mono-eyebrow">Thematic Research Pillars</span>
        <h2 class="section-h" style="margin-bottom: 1.5rem;">Methods, Benchmarks &amp; Systems</h2>

        <div class="pillars-stack">
          {pillars.map((p) => {
            const thumb = getThumbSrc(p.image);
            const dim = getImageDim(thumb, 760, 500);
            return (
              <article id={p.id} class="pillar-row">
                <div class="pillar-copy">
                  <span class="mono-eyebrow">{p.num}</span>
                  <h3>{p.title}</h3>
                  <p>{p.summary}</p>
                  <p style="margin-top: 0.9rem;">
                    <a href={p.labHref} target="_blank" rel="noopener" class="text-action">
                      {p.labLabel} &#8599;
                    </a>
                  </p>
                </div>
                <figure class="pillar-fig">
                  <button
                    type="button"
                    class="pillar-zoom-btn"
                    data-zoom-src={p.image}
                    data-zoom-alt={p.caption}
                    aria-label={`Enlarge diagram: ${p.imageAlt}`}
                  >
                    <img
                      src={thumb}
                      alt={p.imageAlt}
                      width={dim.width}
                      height={dim.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="pillar-zoom-cue" aria-hidden="true">Zoom</span>
                  </button>
                  <figcaption>{p.caption}</figcaption>
                </figure>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Open Datasets, Benchmarks & Live Tools -->
      <section class="rule-section">
        <span class="mono-eyebrow">Open Benchmarks, Code &amp; Field Prototypes</span>
        <div class="section-bar">
          <h2 class="section-h">Open Datasets &amp; Live Clove AI Demo</h2>
          <a href="https://saaillab.github.io/datasets/" target="_blank" rel="noopener" class="text-action">
            All SAAIL Datasets &#8599;
          </a>
        </div>
        <div class="datasets-grid">
          <article class="ds-card">
            <span class="ds-k">4,603 Clove Images &middot; CC BY-NC 4.0</span>
            <h3>CLOVES-4603 &amp; Live ONNX Grader</h3>
            <p>
              Lot-aware Zanzibar commercial clove dataset graded across four ZSTC tiers, paired with an in-browser ONNX grading prototype on SAAIL Lab.
            </p>
            <p class="ds-links">
              <a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="text-action">Dataset Repo &#8599;</a>
              <a href="https://saaillab.github.io/tools/#live-demo" target="_blank" rel="noopener" class="text-action">Live Demo &#8599;</a>
            </p>
          </article>
          <article class="ds-card">
            <span class="ds-k">35,420 Leaf Images &middot; 5.00 ms CPU</span>
            <h3>CropGuardNet Cross-Crop Suite</h3>
            <p>
              Perceptually deduplicated 8-crop, 38-class pathology benchmark (80,238 duplicates removed) with quantized CPU ONNX inference and four XAI audits.
            </p>
            <p class="ds-links">
              <a href="https://github.com/saaillab/CropGuardNet" target="_blank" rel="noopener" class="text-action">Code &amp; Splits &#8599;</a>
              <a href="https://saaillab.github.io/papers/cropguardnet/" target="_blank" rel="noopener" class="text-action">Paper Portal &#8599;</a>
            </p>
          </article>
          <article class="ds-card">
            <span class="ds-k">40 Controlled Runs &middot; DLI Best Poster</span>
            <h3>DGS-Bench &amp; CARA-FM Calculators</h3>
            <p>
              Deployment-gap evaluation suite and closed-form accuracy-mirage threshold calculators engineered for budget Android deployment constraints.
            </p>
            <p class="ds-links">
              <a href="https://saaillab.github.io/papers/dgs-bench/" target="_blank" rel="noopener" class="text-action">DGS-Bench &#8599;</a>
              <a href="https://saaillab.github.io/tools/#calculators" target="_blank" rel="noopener" class="text-action">Calculators &#8599;</a>
            </p>
          </article>
          <article class="ds-card">
            <span class="ds-k">Coastal Kiunguja &middot; Provenance Audit</span>
            <h3>Zanzibar Swahili Corpus &amp; Dira</h3>
            <p>
              Authentic island-written Swahili corpus paired with translationese provenance detection and cultural-alignment benchmarks for East Africa.
            </p>
            <p class="ds-links">
              <a href="https://saaillab.github.io/projects/swahili-dira/" target="_blank" rel="noopener" class="text-action">Swahili Dira &#8599;</a>
              <a href="/writing/kiunguja-swahili-coastal-dialect-nlp/" class="text-action">Read Essay &rarr;</a>
            </p>
          </article>
        </div>
      </section>

      <!-- Partners Table -->
      <section class="rule-section">
        <span class="mono-eyebrow">Institutional Consortia</span>
        <div class="section-bar">
          <h2 class="section-h">Research Partners</h2>
          <a href="https://saaillab.github.io/collaborations/" target="_blank" rel="noopener" class="text-action">
            Full Consortium Directory on SAAIL Lab &#8599;
          </a>
        </div>

        <ul class="partners-list">
          {partners.map((pt) => (
            <li>
              <span class="pt-region">{pt.region}</span>
              <div>
                <strong>{pt.name}</strong>
                <p>{pt.scope}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <SiteFooter />
  </div>

  <div id="researchLightbox" class="res-lightbox" hidden role="dialog" aria-modal="true" aria-labelledby="resLbCap">
    <div class="res-lb-backdrop"></div>
    <button id="resLbClose" type="button" class="res-lb-close" aria-label="Close diagram preview">&times;</button>
    <figure class="res-lb-figure">
      <img
        id="resLbImg"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt="Enlarged research diagram"
        width="1200"
        height="800"
      />
      <figcaption id="resLbCap"></figcaption>
    </figure>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var statusEl = document.getElementById('lineageStatus');
      var nodes = document.querySelectorAll('.lin-node');
      var edges = document.querySelectorAll('.lin-edge');

      function setHighlight(node) {
        if (!node) {
          nodes.forEach(function (n) { n.classList.remove('is-dim', 'is-lit'); });
          edges.forEach(function (e) { e.classList.remove('is-dim', 'is-lit'); });
          if (statusEl) statusEl.textContent = 'Hover or focus any node to trace links';
          return;
        }
        var groups = (node.getAttribute('data-group') || '').split(/\s+/).filter(Boolean);
        if (statusEl) statusEl.textContent = node.getAttribute('data-desc') || '';
        edges.forEach(function (e) {
          var elin = (e.getAttribute('data-lin') || '').split(/\s+/);
          var match = groups.length === 1 ? elin.indexOf(groups[0]) !== -1 : elin.indexOf(groups[1]) !== -1;
          e.classList.toggle('is-lit', match);
          e.classList.toggle('is-dim', !match);
        });
        nodes.forEach(function (n) {
          var ng = (n.getAttribute('data-group') || '').split(/\s+/);
          var match = groups.length === 1
            ? ng.indexOf(groups[0]) !== -1
            : (ng.length === 1 ? ng[0] === groups[0] : ng.indexOf(groups[1]) !== -1);
          n.classList.toggle('is-lit', match);
          n.classList.toggle('is-dim', !match);
        });
      }

      nodes.forEach(function (node) {
        node.addEventListener('mouseenter', function () { setHighlight(node); });
        node.addEventListener('focus', function () { setHighlight(node); });
        node.addEventListener('mouseleave', function () { setHighlight(null); });
        node.addEventListener('blur', function () { setHighlight(null); });
      });

      var lb = document.getElementById('researchLightbox');
      var lbImg = document.getElementById('resLbImg');
      var lbCap = document.getElementById('resLbCap');
      var lbClose = document.getElementById('resLbClose');
      var lbBackdrop = lb && lb.querySelector('.res-lb-backdrop');
      var bgEls = document.querySelectorAll('.monograph-rail, .mobile-header, .monograph-canvas, #backToTop');
      var lastFocus = null;
      var blankSrc = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

      function setInert(state) {
        bgEls.forEach(function (el) {
          if (state) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
      }

      function closeLb() {
        if (!lb) return;
        lb.hidden = true;
        document.body.style.overflow = '';
        setInert(false);
        if (lbImg) lbImg.src = blankSrc;
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      }

      document.querySelectorAll('.pillar-zoom-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!lb || !lbImg || !lbCap) return;
          lastFocus = btn;
          lbImg.src = btn.getAttribute('data-zoom-src') || blankSrc;
          lbImg.alt = btn.getAttribute('data-zoom-alt') || 'Research diagram';
          lbCap.textContent = btn.getAttribute('data-zoom-alt') || '';
          lb.hidden = false;
          setInert(true);
          document.body.style.overflow = 'hidden';
          lbClose && lbClose.focus();
        });
      });

      lbClose && lbClose.addEventListener('click', closeLb);
      lbBackdrop && lbBackdrop.addEventListener('click', closeLb);
      document.addEventListener('keydown', function (e) {
        if (!lb || lb.hidden) return;
        if (e.key === 'Escape') closeLb();
        else if (e.key === 'Tab') {
          e.preventDefault();
          lbClose && lbClose.focus();
        }
      });
    });
  </script>
</BaseLayout>

