---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PROFILE } from '../../data/profile';
import { breadcrumbList, personEntity, websiteEntity } from '../../data/schema';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    {
      '@type': 'ContactPage',
      '@id': 'https://inyalala.github.io/contact/#webpage',
      url: 'https://inyalala.github.io/contact/',
      name: 'Contact | Innocent Nyalala · IIT Madras Zanzibar',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      mainEntity: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': 'https://inyalala.github.io/contact/#breadcrumb' }
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Contact', url: 'https://inyalala.github.io/contact/' }
      ],
      'https://inyalala.github.io/contact/#breadcrumb'
    )
  ]
};
---

<BaseLayout
  title="Contact | Innocent Nyalala · IIT Madras Zanzibar"
  description="Contact Innocent Nyalala at Room 105 (F1), School of Engineering and Science, IIT Madras Zanzibar for research, supervision, and course matters."
  canonical="https://inyalala.github.io/contact/"
  alternates={[
    { hreflang: 'en', href: 'https://inyalala.github.io/contact/' },
    { hreflang: 'sw', href: 'https://inyalala.github.io/sw/contact/' },
    { hreflang: 'x-default', href: 'https://inyalala.github.io/contact/' }
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  </Fragment>

  <MonographRail currentPage="contact" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">IIT Madras Zanzibar &middot; Bweleo Campus</span>
        <h1 class="page-title">Contact</h1>
        <p class="page-lead">
          Write directly to <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a> or submit an inquiry below for research collaborations, graduate supervision, industry partnerships, and student office appointments.
        </p>
      </header>

      <section class="rule-section" style="padding-top: 0;">
        <div class="contact-grid">
          <div>
            <h2 class="section-h" style="margin-bottom: 0.45rem;">Send a Direct Inquiry</h2>
            <p class="form-sub">
              Submissions route to <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a>. You can also launch your email app or Gmail Web directly with filled fields.
            </p>

            <div id="formBanner" class="form-banner" hidden role="status" aria-live="polite" tabindex="-1"></div>

            <form id="facultyContactForm" class="contact-form" action={`https://formsubmit.co/ajax/${PROFILE.email}`} method="POST">
              <input type="hidden" name="_subject" value="Faculty Monograph Inquiry · inyalala.github.io" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name *</label>
                  <input id="firstName" name="firstName" type="text" required autocomplete="given-name" placeholder="First name" />
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name *</label>
                  <input id="lastName" name="lastName" type="text" required autocomplete="family-name" placeholder="Last name" />
                </div>
              </div>

              <div class="form-group">
                <label for="email">Email Address *</label>
                <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@institution.edu" />
              </div>

              <div class="form-group">
                <label for="topic">Inquiry Topic *</label>
                <select id="topic" name="topic" required>
                  <option value="">Select category...</option>
                  <option value="Academic Research Collaboration">Academic Research Collaboration</option>
                  <option value="Industry / NGO Partnership">Industry / NGO Partnership</option>
                  <option value="MTech / PhD / Postdoc Mentorship">MTech / PhD / Postdoc Mentorship</option>
                  <option value="Coursework / Student Inquiry">Coursework / Student Inquiry (Z5007 / Z3003)</option>
                  <option value="Invited Talk / Press">Invited Talk / Media Request</option>
                  <option value="General Inquiry">General Academic Inquiry</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Message *</label>
                <textarea id="message" name="message" rows="5" required placeholder="Outline your research goal, course question, or proposed meeting timing..."></textarea>
              </div>

              <div class="form-actions">
                <button id="submitBtn" type="submit" class="btn-mono">Send Message &rarr;</button>
                <a id="mailtoFallback" href={`mailto:${PROFILE.email}`} class="btn-mono-outline">Open Email App</a>
                <a
                  id="gmailFallback"
                  href={`https://mail.google.com/mail/?view=cm&fs=1&to=${PROFILE.email}`}
                  target="_blank"
                  rel="noopener"
                  class="text-action"
                >
                  Open in Gmail &#8599;
                </a>
              </div>
            </form>
          </div>

          <aside class="info-col">
            <div class="monograph-panel">
              <span class="mono-eyebrow">Direct Coordinates</span>
              <dl class="c-dl">
                <div>
                  <dt>Faculty Email</dt>
                  <dd>
                    <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a>
                    <button id="copyEmailBtn" type="button" class="mini-btn" style="margin-left: 0.45rem;">Copy</button>
                  </dd>
                </div>
                <div>
                  <dt>Research Group</dt>
                  <dd><a href={PROFILE.labUrl} target="_blank" rel="noopener" class="inline-link">SAAIL Lab ({PROFILE.labEmail}) &#8599;</a></dd>
                </div>
                <div>
                  <dt>Campus Office</dt>
                  <dd>{PROFILE.office}<br />{PROFILE.campusAddress}</dd>
                </div>
                <div>
                  <dt>Office Hours</dt>
                  <dd>{PROFILE.officeHours} ({PROFILE.officeHoursNote})</dd>
                </div>
                <div>
                  <dt>Phone</dt>
                  <dd class="tabular-nums">
                    TZ: <a href={`tel:${PROFILE.phoneTanzania.replace(/\s+/g, '')}`} class="inline-link">{PROFILE.phoneTanzania}</a><br />
                    KE: <a href={`tel:${PROFILE.phoneKenya.replace(/\s+/g, '')}`} class="inline-link">{PROFILE.phoneKenya}</a>
                  </dd>
                </div>
                <div>
                  <dt>Visiting Zanzibar?</dt>
                  <dd><a href="/writing/visiting-iit-madras-zanzibar-guide/" class="inline-link">Read Arrival &amp; Campus Travel Guide &rarr;</a></dd>
                </div>
              </dl>
            </div>
          </aside>
        </div>
      </section>

      <section class="rule-section">
        <div class="map-head">
          <div>
            <span class="mono-eyebrow">Bweleo Campus &middot; Zanzibar, Tanzania</span>
            <h2 class="section-h">Campus Location &amp; Directions</h2>
          </div>
          <a href="/writing/visiting-iit-madras-zanzibar-guide/" class="text-action">
            Airport Transfer &amp; Campus Guide &rarr;
          </a>
        </div>
        <div class="map-box">
          <iframe
            title="IIT Madras Zanzibar Campus Map"
            src={PROFILE.mapEmbedUrl}
            width="100%"
            height="320"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var TARGET_EMAIL = 'innocent@iitmz.ac.in';
      var copyBtn = document.getElementById('copyEmailBtn');
      var form = document.getElementById('facultyContactForm');
      var submitBtn = document.getElementById('submitBtn');
      var banner = document.getElementById('formBanner');
      var firstEl = document.getElementById('firstName');
      var lastEl = document.getElementById('lastName');
      var emailEl = document.getElementById('email');
      var topicEl = document.getElementById('topic');
      var msgEl = document.getElementById('message');
      var mailtoLink = document.getElementById('mailtoFallback');
      var gmailLink = document.getElementById('gmailFallback');

      function buildPayload() {
        var name = (((firstEl && firstEl.value) || '') + ' ' + ((lastEl && lastEl.value) || '')).trim() || 'Website Visitor';
        var sender = ((emailEl && emailEl.value) || '').trim();
        var topic = ((topicEl && topicEl.value) || '').trim() || 'Faculty Inquiry';
        var msg = ((msgEl && msgEl.value) || '').trim();
        var subject = '[inyalala.github.io] ' + topic + ' - ' + name;
        var body = 'From: ' + name + (sender ? ' (' + sender + ')' : '') + '\nTopic: ' + topic + '\n\n' + msg;
        return { subject: subject, body: body };
      }

      function syncComposeLinks() {
        var p = buildPayload();
        var qSub = encodeURIComponent(p.subject);
        var qBody = encodeURIComponent(p.body);
        if (mailtoLink) mailtoLink.href = 'mailto:' + TARGET_EMAIL + '?subject=' + qSub + '&body=' + qBody;
        if (gmailLink) gmailLink.href = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + TARGET_EMAIL + '&su=' + qSub + '&body=' + qBody;
      }

      [firstEl, lastEl, emailEl, topicEl, msgEl].forEach(function (el) {
        el && el.addEventListener('input', syncComposeLinks);
        el && el.addEventListener('change', syncComposeLinks);
      });
      syncComposeLinks();

      copyBtn &&
        copyBtn.addEventListener('click', function () {
          var onCopied = function () {
            copyBtn.textContent = 'Copied!';
            if (window.__showMonoToast) window.__showMonoToast('Copied ' + TARGET_EMAIL);
            setTimeout(function () {
              copyBtn.textContent = 'Copy';
            }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(TARGET_EMAIL).then(onCopied).catch(function () {
              var ta = document.createElement('textarea');
              ta.value = TARGET_EMAIL;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try { if (document.execCommand('copy')) onCopied(); } catch (e) {}
              document.body.removeChild(ta);
            });
          } else {
            var ta = document.createElement('textarea');
            ta.value = TARGET_EMAIL;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { if (document.execCommand('copy')) onCopied(); } catch (e) {}
            document.body.removeChild(ta);
          }
        });

      form &&
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (!submitBtn || !banner) return;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
          banner.hidden = true;

          var fd = new FormData(form);
          fd.append('_replyto', fd.get('email') || '');

          fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: fd
          })
            .then(function (resp) {
              if (resp.ok) {
                banner.className = 'form-banner is-ok';
                banner.textContent = 'Message sent to ' + TARGET_EMAIL + '. Thank you for reaching out.';
                banner.hidden = false;
                banner.focus();
                form.reset();
                syncComposeLinks();
              } else {
                throw new Error('Request rejected');
              }
            })
            .catch(function () {
              var p = buildPayload();
              banner.className = 'form-banner is-warn';
              banner.innerHTML =
                'Direct relay unavailable right now. Please send via <a href="mailto:' +
                TARGET_EMAIL +
                '?subject=' +
                encodeURIComponent(p.subject) +
                '&body=' +
                encodeURIComponent(p.body) +
                '" class="inline-link">your email app</a> or write directly to ' +
                TARGET_EMAIL +
                '.';
              banner.hidden = false;
              banner.focus();
            })
            .finally(function () {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Message →';
            });
        });
    });
  </script>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.25rem;
    align-items: start;
  }
  .form-sub {
    color: var(--text-secondary);
    font-size: 0.94rem;
    margin-bottom: 1.25rem;
  }
  .form-banner {
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-strong);
    margin-bottom: 1rem;
    font-size: 0.92rem;
  }
  .form-banner.is-ok {
    border-color: var(--accent-forest);
    background: var(--bg-secondary);
  }
  .form-banner.is-warn {
    border-color: var(--accent-clove);
    background: var(--bg-secondary);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.58rem 0.75rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 0.96rem;
    border-radius: 2px;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .c-dl {
    border-top: 1px solid var(--rule);
    margin-top: 0.4rem;
  }
  .c-dl > div {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .c-dl dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-clove);
    margin-bottom: 0.15rem;
  }
  .c-dl dd {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .mini-btn {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    border-radius: 2px;
  }
  .map-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }
  .map-box {
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    padding: 0.35rem;
  }

  @media (max-width: 820px) {
    .contact-grid,
    .form-row {
      grid-template-columns: 1fr;
    }
    .mini-btn {
      min-height: 42px;
      padding: 0.45rem 0.85rem;
    }
  }
</style>
