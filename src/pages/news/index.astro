---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import newsData from '../../data/news.json';
import { getImageDim, getThumbSrc } from '../../data/media';
import { breadcrumbList, personEntity, websiteEntity } from '../../data/schema';

interface GalleryItem {
  src: string;
  alt: string;
  fit?: 'contain' | 'cover';
}

interface NewsEntry {
  id: string;
  date: string;
  dateRange?: string;
  category: string;
  featured?: boolean;
  headline: string;
  summary?: string;
  body: string;
  link?: string | null;
  linkLabel?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  focal?: string | null;
  fit?: 'contain' | 'cover';
  gallery?: GalleryItem[];
  source?: string | null;
  sourceUrl?: string | null;
}

const sortedItems = ([...newsData.items] as NewsEntry[]).sort((a, b) => b.date.localeCompare(a.date));

const catCounts: Record<string, number> = {};
for (const it of sortedItems) {
  catCounts[it.category] = (catCounts[it.category] || 0) + 1;
}
const categories = Object.keys(catCounts).sort();

let lastYear = '';
const withDividers = sortedItems.map((item) => {
  const year = item.date.slice(0, 4);
  const showYear = year !== lastYear;
  lastYear = year;
  const slides: GalleryItem[] = [];
  if (item.image) {
    slides.push({
      src: item.image,
      alt: item.imageAlt || item.headline,
      fit: item.fit
    });
  }
  if (item.gallery) {
    slides.push(...item.gallery);
  }
  return { ...item, year, showYear, slides };
});

const newsSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    {
      '@type': 'CollectionPage',
      '@id': 'https://inyalala.github.io/news/#webpage',
      url: 'https://inyalala.github.io/news/',
      name: 'News & Dispatches | Innocent Nyalala · IITM Zanzibar',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      about: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': 'https://inyalala.github.io/news/#breadcrumb' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: sortedItems.length,
        itemListElement: sortedItems.map((item, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          item: {
            '@type': 'NewsArticle',
            headline: item.headline,
            datePublished: item.date,
            articleSection: item.category,
            description: item.summary || item.body,
            author: { '@id': 'https://inyalala.github.io/#person' },
            image: item.image ? `https://inyalala.github.io${item.image}` : undefined,
            url: `https://inyalala.github.io/news/#${item.id}`
          }
        }))
      }
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'News & Dispatches', url: 'https://inyalala.github.io/news/' }
      ],
      'https://inyalala.github.io/news/#breadcrumb'
    )
  ]
};
---

<BaseLayout
  title="News & Dispatches | Innocent Nyalala · IITM Zanzibar"
  description="Chronological updates on research grants, conference awards, publications, talks, and teaching from Innocent Nyalala at IIT Madras Zanzibar."
  canonical="https://inyalala.github.io/news/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(newsSchema)} />
  </Fragment>

  <MonographRail currentPage="news" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">Chronological Archive &middot; 2024 - 2026</span>
        <h1 class="page-title">News, Talks &amp; Dispatches</h1>
        <p class="page-lead">
          Research grants, journal publications, Deep Learning Indaba and Data Science Africa milestones, invited talks, and course announcements ordered most recent first.
        </p>

        <div class="filter-strip" role="group" aria-label="Filter dispatches by category">
          <button type="button" class="filter-btn" aria-pressed="true" data-cat="all">
            All ({sortedItems.length})
          </button>
          {categories.map((cat) => (
            <button type="button" class="filter-btn" aria-pressed="false" data-cat={cat}>
              {cat} ({catCounts[cat]})
            </button>
          ))}
        </div>
        <p id="newsResultCount" class="news-count" aria-live="polite">
          Showing {sortedItems.length} of {sortedItems.length} dispatches
        </p>
      </header>

      <section class="rule-section" style="padding-top: 0;" id="newsContainer">
        {withDividers.map((item) => (
          <>
            {item.showYear && (
              <div class="year-divider" data-year-group={item.year}>
                <span>{item.year}</span>
              </div>
            )}
            <article id={item.id} class="news-entry" data-category={item.category}>
              <p class="entry-head">
                <span class="entry-cat">{item.category}</span>
                <span>&middot;</span>
                <time datetime={item.date}>{item.dateRange || item.date}</time>
                {item.source && (
                  <>
                    <span>&middot;</span>
                    {item.sourceUrl ? (
                      <a href={item.sourceUrl} target="_blank" rel="noopener" class="entry-src">
                        {item.source} &#8599;
                      </a>
                    ) : (
                      <span class="entry-src">{item.source}</span>
                    )}
                  </>
                )}
              </p>

              <h2>{item.headline}</h2>
              <p class="entry-body">{item.body}</p>

              {item.slides.length > 0 && (
                <div class="news-gallery" data-count={item.slides.length}>
                  <div class="gallery-track">
                    {item.slides.map((sl) => {
                      const thumb = getThumbSrc(sl.src);
                      const dim = getImageDim(thumb, 640, 420);
                      const isContain = sl.fit === 'contain';
                      return (
                        <figure class="slide">
                          <button
                            type="button"
                            class="zoom-btn"
                            data-zoom-src={sl.src}
                            data-zoom-alt={sl.alt}
                            aria-label={`View full image: ${sl.alt}`}
                          >
                            <img
                              src={thumb}
                              alt={sl.alt}
                              width={dim.width}
                              height={dim.height}
                              class={isContain ? 'img-contain' : 'img-cover'}
                              style={!isContain && item.focal ? `object-position: ${item.focal}` : undefined}
                              loading="lazy"
                              decoding="async"
                            />
                          </button>
                          <figcaption>{sl.alt}</figcaption>
                        </figure>
                      );
                    })}
                  </div>

                  {item.slides.length > 1 && (
                    <div class="gallery-bar">
                      <span>{item.slides.length} visuals (click to enlarge full resolution)</span>
                      <div class="gallery-nav">
                        <button type="button" class="g-prev" aria-label="Previous visual">&larr;</button>
                        <button type="button" class="g-next" aria-label="Next visual">&rarr;</button>
                      </div>
                    </div>
                  )}
                </div>
              )}

              {item.link && (
                <p class="entry-foot">
                  {item.link.startsWith('http') ? (
                    <a href={item.link} target="_blank" rel="noopener" class="text-action">
                      {item.linkLabel || 'Read More'} &#8599;
                    </a>
                  ) : (
                    <a href={item.link} class="text-action">
                      {item.linkLabel || 'Open Page'} &rarr;
                    </a>
                  )}
                </p>
              )}
            </article>
          </>
        ))}
        <div id="newsEmptyState" class="filter-empty-state" hidden>
          <p>No dispatches matched the selected category.</p>
          <button type="button" id="resetNewsFilters" class="filter-btn">Reset Filters</button>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <!-- Accessible Focus-Trapped Lightbox Modal -->
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-labelledby="lbCap">
    <div class="lb-backdrop"></div>
    <button id="lbClose" type="button" class="lb-close" aria-label="Close image preview">&times;</button>
    <figure class="lb-figure">
      <img
        id="lbImg"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt="Expanded news photograph preview"
        width="1200"
        height="800"
      />
      <figcaption id="lbCap"></figcaption>
    </figure>
  </div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var btns = document.querySelectorAll('.filter-btn[data-cat]');
    var entries = document.querySelectorAll('.news-entry');
    var dividers = document.querySelectorAll('.year-divider');
    var countEl = document.getElementById('newsResultCount');
    var emptyEl = document.getElementById('newsEmptyState');
    var resetEl = document.getElementById('resetNewsFilters');

    function applyCat(cat, skipUrl) {
      var vis = 0;
      btns.forEach(function (b) {
        b.setAttribute('aria-pressed', String((b.getAttribute('data-cat') || 'all') === cat));
      });
      entries.forEach(function (e) {
        var match = cat === 'all' || e.getAttribute('data-category') === cat;
        e.style.display = match ? 'block' : 'none';
        if (match) vis++;
      });
      dividers.forEach(function (d) {
        d.style.display = cat === 'all' ? 'flex' : 'none';
      });
      if (emptyEl) emptyEl.hidden = vis > 0;
      if (countEl) {
        countEl.textContent = 'Showing ' + vis + ' of ' + entries.length + ' dispatches';
      }
      if (!skipUrl) {
        try {
          var params = new URLSearchParams(window.location.search);
          if (cat !== 'all') params.set('cat', cat);
          else params.delete('cat');
          var qs = params.toString();
          window.history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
        } catch (e) {}
      }
    }

    try {
      var initCat = new URLSearchParams(window.location.search).get('cat');
      if (initCat) applyCat(initCat, true);
    } catch (e) {}

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyCat(btn.getAttribute('data-cat') || 'all');
      });
    });

    resetEl &&
      resetEl.addEventListener('click', function () {
        applyCat('all');
      });

    document.querySelectorAll('.news-gallery').forEach(function (gal) {
      var track = gal.querySelector('.gallery-track');
      var prev = gal.querySelector('.g-prev');
      var next = gal.querySelector('.g-next');
      if (!track) return;
      var beh = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      prev &&
        prev.addEventListener('click', function () {
          track.scrollBy({ left: -track.clientWidth * 0.85, behavior: beh });
        });
      next &&
        next.addEventListener('click', function () {
          track.scrollBy({ left: track.clientWidth * 0.85, behavior: beh });
        });
    });

    var lb = document.getElementById('lightbox');
    var lbImg = document.getElementById('lbImg');
    var lbCap = document.getElementById('lbCap');
    var lbClose = document.getElementById('lbClose');
    var lbBackdrop = lb && lb.querySelector('.lb-backdrop');
    var backgroundEls = document.querySelectorAll('.monograph-rail, .mobile-header, .monograph-canvas, #backToTop');
    var lastFocus = null;
    var blankSrc = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

    function setBackgroundInert(state) {
      backgroundEls.forEach(function (el) {
        if (state) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });
    }

    function closeLb() {
      if (!lb) return;
      lb.hidden = true;
      document.body.style.overflow = '';
      setBackgroundInert(false);
      if (lbImg) lbImg.src = blankSrc;
      lastFocus && lastFocus.focus();
    }

    var container = document.getElementById('newsContainer');
    container &&
      container.addEventListener('click', function (e) {
        var trigger = e.target.closest('.zoom-btn');
        if (!trigger || !lb || !lbImg || !lbCap) return;
        lastFocus = trigger;
        lbImg.src = trigger.getAttribute('data-zoom-src') || blankSrc;
        lbImg.alt = '';
        lbCap.textContent = trigger.getAttribute('data-zoom-alt') || '';
        lb.hidden = false;
        setBackgroundInert(true);
        document.body.style.overflow = 'hidden';
        lbClose && lbClose.focus();
      });

    lbClose && lbClose.addEventListener('click', closeLb);
    lbBackdrop && lbBackdrop.addEventListener('click', closeLb);

    document.addEventListener('keydown', function (e) {
      if (!lb || lb.hidden) return;
      if (e.key === 'Escape') {
        closeLb();
      } else if (e.key === 'Tab') {
        e.preventDefault();
        lbClose && lbClose.focus();
      }
    });
  });
</script>
</BaseLayout>

<style>
  .news-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.85rem;
  }
  .filter-empty-state {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 1.5rem;
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .filter-empty-state[hidden] {
    display: none;
  }
  .filter-empty-state p {
    color: var(--text-secondary);
    font-size: 0.96rem;
    margin: 0;
  }

  .year-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-clove);
  }
  .year-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule-strong);
  }

  .news-entry {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 28px;
  }
  @media (max-width: 1020px) {
    .news-entry {
      scroll-margin-top: calc(var(--mobile-bar-height) + 18px);
    }
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-bottom: 0.45rem;
  }
  .entry-cat {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-clove);
    font-weight: 600;
  }
  .entry-src {
    color: var(--accent-forest);
    text-decoration: none;
  }
  a.entry-src:hover {
    text-decoration: underline;
  }

  .news-entry h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .entry-body {
    color: var(--text-secondary);
    line-height: 1.68;
    max-width: 68ch;
    margin-bottom: 1.15rem;
  }

  .news-gallery {
    margin-bottom: 1rem;
  }
  .gallery-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.35rem;
  }
  .news-gallery[data-count='1'] .gallery-track {
    display: block;
    overflow: visible;
  }

  .slide {
    flex: 0 0 min(420px, 84%);
    scroll-snap-align: start;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    padding: 0.45rem;
    display: flex;
    flex-direction: column;
  }
  .news-gallery[data-count='1'] .slide {
    max-width: 560px;
  }

  .zoom-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 280px;
    padding: 0;
    border: none;
    background: var(--bg-secondary);
    overflow: hidden;
    cursor: zoom-in;
    flex-shrink: 0;
  }
  .zoom-btn img.img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .zoom-btn img.img-contain {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.45rem;
    background: var(--bg-surface);
    display: block;
  }

  .slide figcaption {
    padding: 0.65rem 0.45rem 0.3rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.45;
    flex: 1;
  }
  @media (max-width: 640px) {
    .zoom-btn {
      height: 220px;
    }
  }

  .gallery-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .gallery-nav {
    display: flex;
    gap: 0.4rem;
  }
  .g-prev,
  .g-next {
    width: 30px;
    height: 30px;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    cursor: pointer;
  }
  .g-prev:hover,
  .g-next:hover {
    border-color: var(--accent-forest);
    color: var(--accent-forest);
  }

  .entry-foot {
    margin-top: 0.35rem;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(16, 15, 13, 0.9);
  }
  .lb-close {
    position: fixed;
    top: 1.25rem;
    right: 1.45rem;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(21, 20, 18, 0.85);
    color: #f8f5ee;
    font-size: 1.6rem;
    cursor: pointer;
    z-index: 3002;
  }
  .lb-figure {
    position: relative;
    z-index: 3001;
    max-width: min(1080px, 92vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lb-figure img {
    max-height: 82vh;
    width: auto;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: var(--bg-surface);
  }
  .lb-figure figcaption {
    color: #f2efe9;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: center;
    max-width: 70ch;
  }
</style>
