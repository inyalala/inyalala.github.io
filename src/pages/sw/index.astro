---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonographRail from '../../components/MonographRail.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PROFILE } from '../../data/profile';
import { PUBLICATIONS } from '../../data/publications';
import { COURSES } from '../../data/courses';
import { SW_COURSES_MAP } from '../../data/sw-courses';
import { WRITING_POSTS } from '../../data/writing';
import metrics from '../../data/scholar-metrics.json';
import { personEntity, webPageEntity, websiteEntity, breadcrumbList } from '../../data/schema';

const pageUrl = 'https://inyalala.github.io/sw/';
const activeCourses = COURSES.filter((c) => c.status === 'active');

const swSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity('sw'),
    {
      ...websiteEntity(),
      name: 'Innocent Nyalala | Toleo la Kiswahili na Kumbukumbu za Kitaaluma',
      inLanguage: ['en-US', 'sw-TZ']
    },
    {
      ...webPageEntity({
        url: pageUrl,
        name: 'Dkt. Innocent Nyalala · Toleo la Kiswahili | IITMZ',
        description:
          'Wasifu wa kitaaluma, miradi ya akili mnemba katika kilimo na afya, na mtaala wa ufundishaji wa Dkt. Innocent Nyalala katika Chuo Kikuu cha IIT Madras Zanzibar.',
        breadcrumbId: `${pageUrl}#breadcrumb`,
        mainEntityId: 'https://inyalala.github.io/#person'
      }),
      inLanguage: 'sw-TZ'
    },
    breadcrumbList(
      [
        { name: 'Home (English)', url: 'https://inyalala.github.io/' },
        { name: 'Kiswahili', url: pageUrl }
      ],
      `${pageUrl}#breadcrumb`
    )
  ]
};
---

<BaseLayout
  title="Dkt. Innocent Nyalala · Toleo la Kiswahili | IITMZ"
  description="Wasifu wa kitaaluma, utafiti wa akili mnemba katika kilimo na lugha ya Kiswahili, na ufundishaji wa Dkt. Innocent Nyalala katika IIT Madras Zanzibar."
  canonical={pageUrl}
  lang="sw"
  preloadDisplayFonts={true}
  alternates={[
    { hreflang: 'en', href: 'https://inyalala.github.io/' },
    { hreflang: 'sw', href: pageUrl },
    { hreflang: 'x-default', href: 'https://inyalala.github.io/' }
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(swSchema)} />
  </Fragment>

  <MonographRail currentPage="home" lang="sw" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="sw-masthead">
        <div class="sw-grid">
          <div class="sw-copy">
            <span class="calligraphic-flourish" aria-hidden="true">Salama &middot; Karibu Zanzibar</span>
            <h1 class="sw-h1">Dkt. Innocent Nyalala</h1>
            <p class="sw-role">Profesa Msaidizi wa Sayansi ya Data na Akili Mnemba</p>

            <div class="sw-affils">
              <p>
                Kitivo cha Uhandisi na Sayansi,{' '}
                <a href="https://www.iitmz.ac.in/" target="_blank" rel="noopener" class="inline-link">
                  Chuo Kikuu cha IIT Madras Zanzibar
                </a>
              </p>
              <p>Mtafiti Shirikishi, Kituo cha Wadhwani (WSAI), IIT Madras, Chennai</p>
              <p>
                Mwanzilishi na Mkurugenzi wa Utafiti,{' '}
                <a href="https://saaillab.github.io/" target="_blank" rel="noopener" class="inline-link">
                  Maabara ya SAAIL (EN) &#8599;
                </a>
              </p>
            </div>

            <p class="sw-bio">
              Utafiti na ufundishaji wangu unalenga kujenga mifumo ya <a href="#gloss-akili-mnemba" class="gloss-ref">akili mnemba</a> (AI), ujifunzaji mashine, na uchambuzi wa picha unaofanya kazi katika mazingira halisi ya Afrika Mashariki: kutambua magonjwa ya mazao shambani, kupima ubora wa <a href="#gloss-karafuu" class="gloss-ref">karafuu</a> kwa uwazi Zanzibar, kuhifadhi Kiswahili asilia cha Pwani, na kusaidia uchunguzi wa afya ya mama na mtoto.
            </p>

            <div class="sw-actions">
              <a href="/publications/" class="btn-mono">Machapisho ({PUBLICATIONS.length}) (EN) &rarr;</a>
              <a href="/sw/courses/" class="btn-mono-outline">Kozi na Slaidi ({COURSES.length})</a>
              <a href="/" class="text-action">Switch to English Edition &rarr;</a>
            </div>
          </div>

          <aside class="sw-portrait-col" aria-label="Picha rasmi na taarifa za ofisi">
            <div class="cutout-stage">
              <picture>
                <source srcset="/images/innocent-nyalala-cutout.webp" type="image/webp" />
                <img
                  src="/images/innocent-nyalala-cutout.webp"
                  alt="Dkt. Innocent Nyalala katika Chuo Kikuu cha IIT Madras Zanzibar"
                  width="640"
                  height="640"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="hero-cutout"
                />
              </picture>
            </div>
            <dl class="sw-facts">
              <div>
                <dt>Ofisi</dt>
                <dd>Chumba 105 (Ghorofa ya 1 / F1) &middot; Kampasi ya Bweleo, Zanzibar</dd>
              </div>
              <div>
                <dt>Saa za Wanafunzi</dt>
                <dd>Jumanne (Z5007) na Jumatano, Saa 8:00 mchana&ndash;10:00 alasiri (2:00&ndash;4:00 PM EAT)</dd>
              </div>
              <div>
                <dt>Barua Pepe</dt>
                <dd><a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a></dd>
              </div>
            </dl>
          </aside>
        </div>

        <dl class="sw-metrics">
          <div class="sw-metric-item">
            <dt>Manukuu (Google Scholar)</dt>
            <dd class="tabular-nums">{metrics.citations.toLocaleString('en-US')}</dd>
            <span>h-index {metrics.hIndex} &middot; i10-index {metrics.i10Index}</span>
          </div>
          <div class="sw-metric-item">
            <dt>Machapisho Yaliyoorodheshwa</dt>
            <dd class="tabular-nums">{PUBLICATIONS.length}</dd>
            <span>{metrics.saailPublishedCount} yaliyochapishwa &middot; {metrics.saailUnderReviewCount} yanakaguliwa (SAAIL)</span>
          </div>
          <div class="sw-metric-item">
            <dt>Kozi Zinazofundishwa</dt>
            <dd class="tabular-nums">{COURSES.length}</dd>
            <span>{activeCourses.length} zinazoendelea Muhula wa 2026-27</span>
          </div>
          <div class="sw-metric-item">
            <dt>Tuzo za Deep Learning Indaba</dt>
            <dd class="tabular-nums">2&times;</dd>
            <span>Kigali 2025 &amp; Lagos 2026 (Bango Bora)</span>
          </div>
        </dl>
      </header>

      <section class="rule-section">
        <span class="mono-eyebrow">I &middot; Nguzo Nne za Utafiti Zanzibar na Afrika Mashariki</span>
        <h2 class="section-h" style="margin-bottom: 1.25rem;">Utafiti Unaoendana na Mazingira Halisi</h2>

        <div class="sw-pillars">
          <article class="sw-pillar">
            <h3>1. Kilimo cha Karafuu, Korosho, Mihogo na Mwani</h3>
            <p>
              Kwa ushirikiano na Shirika la Biashara la Taifa Zanzibar (<strong>ZSTC</strong>) huko Saateni, tumeunda mkusanyiko wa picha 4,603 za <a href="#gloss-karafuu" class="gloss-ref">karafuu</a> (<strong>CLOVES-4603</strong>) na mfumo wa uchambuzi wa hatua mbili unaopima ubora wa karafuu kwa uwazi (99.45% macro-F1). Sambamba na hayo, mradi wa <strong>CashewAI</strong> unaofadhiliwa na IC&amp;SR IIT Madras unalenga kutambua magonjwa ya mikorosho Tanzania Bara, huku <strong>CropGuardNet</strong> (paramita 481,574) ikikagua majani kwa kasi ya milisekunde 5.00 kwenye simu za Android bila intaneti.
            </p>
            <p class="sw-link-row">
              <a href="https://saaillab.github.io/tools/#live-demo" target="_blank" rel="noopener" class="text-action">Jaribu Mfumo wa Karafuu Mtandaoni (EN) &#8599;</a>
              <a href="/sw/research/" class="text-action">Soma Ajenda ya Utafiti &rarr;</a>
            </p>
          </article>

          <article class="sw-pillar">
            <h3>2. Lugha ya Kiswahili: Kiunguja, Kipemba na Asili ya Matini</h3>
            <p>
              Mifumo mingi ya lugha ya AI barani Afrika hujengwa kwa kutafsiri Kiingereza moja kwa moja, jambo linalopoteza msamiati asilia wa Pwani, kilimo cha mwani, na uvuvi. Kupitia <strong>Korpasi ya Kiswahili cha Zanzibar</strong> na mfumo wa <strong>Dira</strong>, tunakusanya matini asilia ya <em>Kiunguja</em>, <em>Kipemba</em>, na Kiswahili cha Bara ili kubaini maandishi ya <a href="#gloss-utafsiri-wa-kimashine" class="gloss-ref">tafsiri ya mashine</a> na kuboresha zana za wakulima na wanafunzi.
            </p>
            <p class="sw-link-row">
              <a href="/writing/kiunguja-swahili-coastal-dialect-nlp/" class="text-action">Soma Makala ya Lahaja za Kiswahili (EN) &rarr;</a>
              <a href="https://saaillab.github.io/projects/swahili-dira/" target="_blank" rel="noopener" class="text-action">Mradi wa Kiswahili Dira (EN) &#8599;</a>
            </p>
          </article>

          <article class="sw-pillar">
            <h3>3. Uhakiki wa Mifumo ya AI na Sera Afrika Mashariki</h3>
            <p>
              Usahihi wa juu katika vipimo vya maabara mara nyingi huficha makosa pindi mfumo unapokwenda shambani au ghalani kwenye mwanga mpya. Kazi yetu ya <strong>DGS-Bench</strong> (iliyotunukiwa Bango Bora katika <em>Deep Learning Indaba 2026</em>, Lagos) pamoja na tafiti zilizowasilishwa Chuo Kikuu cha Oxford (TAIS 2026) na AAAI zinatoa mbinu za kukagua upendeleo wa picha na kuoanisha sera za AI katika nchi za Afrika Mashariki.
            </p>
            <p class="sw-link-row">
              <a href="/writing/accuracy-mirages-field-agricultural-ai/" class="text-action">Kwa Nini Usahihi wa Maabara Hushindwa Shambani (EN) &rarr;</a>
              <a href="https://saaillab.github.io/papers/dgs-bench/" target="_blank" rel="noopener" class="text-action">Chapisho la DGS-Bench (EN) &#8599;</a>
            </p>
          </article>

          <article class="sw-pillar">
            <h3>4. Afya ya Mama na Mtoto (Kisiwa cha Pemba)</h3>
            <p>
              Tukishirikiana na Chuo Kikuu cha Penn State (Marekani) na Kituo cha <strong>CPHK Pemba</strong>, tunasimamia tafiti nne za shahada ya uzamivu (PhD) zinazochambua picha 9,883 za <a href="#gloss-kondo-la-uzazi" class="gloss-ref">kondo la uzazi</a> (<strong>PlacentaVision</strong>) pamoja na modeli za ubashiri zinazofafanua hatari ya kuzaliwa kabla ya wakati ili kuwasaidia wataalamu wa afya hospitalini.
            </p>
            <p class="sw-link-row">
              <a href="https://saaillab.github.io/projects/placentavision/" target="_blank" rel="noopener" class="text-action">Mradi wa PlacentaVision (EN) &#8599;</a>
              <a href="/writing/zanzibar-seaweed-blue-economy-field-notes/" class="text-action">Makala za Uwandani Zanzibar (EN) &rarr;</a>
            </p>
          </article>
        </div>

        <aside class="sw-glossary" aria-label="Kamusi fupi ya istilahi za kiufundi">
          <div class="sw-glossary-head">
            <span class="mono-eyebrow">Kamusi Fupi ya Pambizoni &middot; Bilingual Technical Glossary</span>
            <p class="sw-glossary-intro">Bofya neno la kiufundi kupata ufafanuzi wa Kiswahili na Kiingereza.</p>
          </div>
          <div class="sw-glossary-grid">
            <details id="gloss-akili-mnemba" class="glossary-item" open>
              <summary>
                <span class="g-sw">akili mnemba</span>
                <span class="g-en">artificial intelligence</span>
              </summary>
              <p>
                Mifumo ya kompyuta inayojifunza ruwaza za takwimu kutoka kwenye data ili kutambua picha, kuchambua lugha, au kutoa ubashiri wa kitaalamu bila kuandikiwa kila kanuni kwa mkono.
              </p>
            </details>
            <details id="gloss-karafuu" class="glossary-item">
              <summary>
                <span class="g-sw">karafuu</span>
                <span class="g-en">cloves / ZSTC grading</span>
              </summary>
              <p>
                Zao kuu la biashara Zanzibar linalokaguliwa na Shirika la Biashara la Taifa Zanzibar (ZSTC) katika madaraja manne (Grade I hadi IV) kulingana na rangi, ukavu, na takataka au mabaki yasiyohusika.
              </p>
            </details>
            <details id="gloss-kondo-la-uzazi" class="glossary-item">
              <summary>
                <span class="g-sw">kondo la uzazi</span>
                <span class="g-en">placental morphometry</span>
              </summary>
              <p>
                Upimaji wa umbo, eneo, na mishipa ya kondo la uzazi kutoka kwenye picha za hospitalini (mradi wa PlacentaVision huko Pemba) kusaidia kutathmini hatari za uzazi mapema.
              </p>
            </details>
            <details id="gloss-utafsiri-wa-kimashine" class="glossary-item">
              <summary>
                <span class="g-sw">Asili ya Matini</span>
                <span class="g-en">translationese vs. native provenance</span>
              </summary>
              <p>
                Kubaini iwapo matini ya Kiswahili imeandikwa moja kwa moja na mwandishi asilia wa Pwani (kama Kiunguja au Kipemba) au imetafsiriwa moja kwa moja kutoka lugha ya Kiingereza kwa programu za kompyuta.
              </p>
            </details>
          </div>
        </aside>
      </section>

      <section class="rule-section">
        <span class="mono-eyebrow">II &middot; Ufundishaji na Kozi za IIT Madras Zanzibar</span>
        <div class="section-bar">
          <h2 class="section-h">Mtaala, Slaidi za PDF na Madaftari ya Colab</h2>
          <a href="/sw/courses/" class="text-action">Fungua Kozi Zote ({COURSES.length}) &rarr;</a>
        </div>
        <ul class="sw-course-list">
          {COURSES.map((c) => {
            const loc = SW_COURSES_MAP[c.slug];
            return (
              <li>
                <span class="sw-c-code">{c.code} &middot; {c.status === 'active' ? 'Inaendelea 2026-27' : 'Kumbukumbu'}</span>
                <div>
                  <a href={`/courses/${c.slug}/`} class="sw-c-title">{loc ? loc.titleSw : c.title}</a>
                  <p class="sw-c-meta">{c.program} {c.courseType} &middot; {loc ? loc.termSw : c.term}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <section class="rule-section">
        <span class="mono-eyebrow">III &middot; Ushirikiano, Usimamizi wa Wanafunzi na Mawasiliano</span>
        <div class="sw-contact-panel">
          <p>
            Watafiti, washirika wa kilimo na viwanda, waandishi wa habari, pamoja na wanafunzi wa <strong>MTech</strong> na <strong>PhD</strong> wanaopenda kushirikiana katika Maabara ya SAAIL wanaweza kupitia masharti ya ushirikiano au kuandika moja kwa moja kupitia <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a>.
          </p>
          <div class="sw-actions" style="margin-top: 1rem;">
            <a href="/work-with-me/" class="btn-mono">Mwongozo wa Ushirikiano (EN) &rarr;</a>
            <a href="/sw/writing/" class="btn-mono-outline">Makala na Miongozo ({WRITING_POSTS.length})</a>
            <a href="/sw/contact/" class="btn-mono-outline">Fomu ya Mawasiliano</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter lang="sw" />
  </div>

  <aside id="glossPopover" class="gloss-popover" role="dialog" aria-labelledby="glossPopTitle" hidden>
    <div class="gloss-pop-head">
      <div>
        <strong id="glossPopTitle"></strong>
        <span id="glossPopEn" class="gloss-pop-en"></span>
      </div>
      <button id="glossPopClose" type="button" class="gloss-pop-close" aria-label="Funga ufafanuzi">&times;</button>
    </div>
    <p id="glossPopDef" class="gloss-pop-def"></p>
    <a id="glossPopJump" href="#gloss-akili-mnemba" class="gloss-pop-jump">Fungua kwenye Kamusi &darr;</a>
  </aside>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var pop = document.getElementById('glossPopover');
      var popTitle = document.getElementById('glossPopTitle');
      var popEn = document.getElementById('glossPopEn');
      var popDef = document.getElementById('glossPopDef');
      var popJump = document.getElementById('glossPopJump');
      var popClose = document.getElementById('glossPopClose');
      var activeRef = null;

      function openGlossaryItem(id) {
        var det = id ? document.getElementById(id) : null;
        if (det && det.tagName === 'DETAILS') {
          det.open = true;
          det.classList.remove('is-flash');
          void det.offsetWidth;
          det.classList.add('is-flash');
          setTimeout(function () {
            det.classList.remove('is-flash');
          }, 1400);
        }
      }

      function closePop(restoreFocus) {
        if (!pop || pop.hidden) return;
        pop.hidden = true;
        if (restoreFocus && activeRef && typeof activeRef.focus === 'function') activeRef.focus();
        activeRef = null;
      }

      document.querySelectorAll('.gloss-ref').forEach(function (link) {
        link.addEventListener('click', function (e) {
          var id = (link.getAttribute('href') || '').replace(/^#/, '');
          var det = id ? document.getElementById(id) : null;
          if (!det || !pop || !popTitle || !popEn || !popDef || !popJump) {
            openGlossaryItem(id);
            return;
          }
          e.preventDefault();
          activeRef = link;
          var swEl = det.querySelector('.g-sw');
          var enEl = det.querySelector('.g-en');
          var pEl = det.querySelector('p');
          popTitle.textContent = swEl ? swEl.textContent : '';
          popEn.textContent = enEl ? ' (' + enEl.textContent + ')' : '';
          popDef.textContent = pEl ? pEl.textContent : '';
          popJump.setAttribute('href', '#' + id);

          pop.hidden = false;
          var rect = link.getBoundingClientRect();
          var popW = Math.min(340, window.innerWidth - 24);
          pop.style.width = popW + 'px';
          var left = Math.min(Math.max(12, rect.left), window.innerWidth - popW - 12);
          var top = rect.bottom + 8;
          if (top + pop.offsetHeight > window.innerHeight - 16) {
            top = Math.max(12, rect.top - pop.offsetHeight - 8);
          }
          pop.style.left = left + 'px';
          pop.style.top = top + 'px';
        });
      });

      popJump &&
        popJump.addEventListener('click', function () {
          var id = (popJump.getAttribute('href') || '').replace(/^#/, '');
          closePop(false);
          openGlossaryItem(id);
        });

      popClose &&
        popClose.addEventListener('click', function () {
          closePop(true);
        });

      document.addEventListener('click', function (e) {
        if (!pop || pop.hidden) return;
        if (!pop.contains(e.target) && !e.target.closest('.gloss-ref')) {
          closePop(false);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && pop && !pop.hidden) {
          closePop(true);
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .sw-masthead {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .sw-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 2.5rem;
    align-items: start;
  }
  .sw-h1 {
    font-size: clamp(2.15rem, 4.2vw, 3.25rem);
    margin: 0.35rem 0 0.25rem;
  }
  .sw-role {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--accent-clove);
    margin-bottom: 0.85rem;
  }
  .sw-affils p {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.25rem;
  }
  .sw-bio {
    margin: 1.05rem 0 1.35rem;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--text-primary);
  }
  .sw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 0.85rem;
    align-items: center;
  }
  .sw-portrait-col {
    display: flex;
    flex-direction: column;
  }
  .cutout-stage {
    border-bottom: 1px solid var(--rule-strong);
    line-height: 0;
  }
  .hero-cutout {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    display: block;
    object-fit: contain;
    object-position: center bottom;
  }
  .sw-facts {
    margin: 0;
    font-size: 0.84rem;
  }
  .sw-facts > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.58rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .sw-facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-clove);
    flex-shrink: 0;
  }
  .sw-facts dd {
    margin: 0;
    color: var(--text-secondary);
    text-align: right;
  }
  .sw-facts a {
    color: var(--accent-forest);
  }

  .sw-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    margin: 2rem 0 0;
  }
  .sw-metric-item {
    padding: 1rem 0.85rem;
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .sw-metric-item:last-child {
    border-right: none;
  }
  .sw-metric-item dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .sw-metric-item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--accent-forest);
    line-height: 1.05;
  }
  .sw-metric-item span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .sw-pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.85rem 2.15rem;
  }
  .sw-pillar {
    border-top: 1px solid var(--rule-strong);
    padding-top: 1.15rem;
