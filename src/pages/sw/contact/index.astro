---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MonographRail from '../../../components/MonographRail.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { PROFILE } from '../../../data/profile';
import { breadcrumbList, personEntity, websiteEntity } from '../../../data/schema';

const pageUrl = 'https://inyalala.github.io/sw/contact/';

const swContactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    {
      ...websiteEntity(),
      inLanguage: ['en-US', 'sw-TZ']
    },
    {
      '@type': 'ContactPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Mawasiliano | Innocent Nyalala · IIT Madras Zanzibar',
      inLanguage: 'sw-TZ',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      mainEntity: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` }
    },
    breadcrumbList(
      [
        { name: 'Nyumbani (Kiswahili)', url: 'https://inyalala.github.io/sw/' },
        { name: 'Mawasiliano', url: pageUrl }
      ],
      `${pageUrl}#breadcrumb`
    )
  ]
};
---

<BaseLayout
  title="Mawasiliano | Innocent Nyalala · IIT Madras Zanzibar"
  description="Wasiliana na Dkt. Innocent Nyalala katika Chumba 105 (Ghorofa ya 1 / F1), IIT Madras Zanzibar, Kampasi ya Bweleo kwa ushirikiano wa utafiti, usimamizi na masomo."
  canonical={pageUrl}
  lang="sw"
  alternates={[
    { hreflang: 'en', href: 'https://inyalala.github.io/contact/' },
    { hreflang: 'sw', href: pageUrl },
    { hreflang: 'x-default', href: 'https://inyalala.github.io/contact/' }
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(swContactSchema)} />
  </Fragment>

  <MonographRail currentPage="contact" lang="sw" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">IIT Madras Zanzibar &middot; Kampasi ya Bweleo</span>
        <h1 class="page-title">Mawasiliano ya Moja kwa Moja</h1>
        <p class="page-lead">
          Tuma barua pepe kwenda <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a> au jaza fomu hapa chini kwa ajili ya ushirikiano wa utafiti, usimamizi wa wanafunzi wa MTech/PhD, na miadi ya saa za ofisi.
        </p>
      </header>

      <section class="rule-section" style="padding-top: 0;">
        <div class="contact-grid">
          <div>
            <h2 class="section-h" style="margin-bottom: 0.45rem;">Tuma Ujumbe</h2>
            <p class="form-sub">
              Fomu hii hutuma ujumbe kwenda <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a>. Pia unaweza kufungua programu yako ya barua pepe au Gmail moja kwa moja.
            </p>

            <div id="swFormBanner" class="form-banner" hidden role="status" aria-live="polite" tabindex="-1"></div>

            <form id="swContactForm" class="contact-form" action={`https://formsubmit.co/ajax/${PROFILE.email}`} method="POST">
              <input type="hidden" name="_subject" value="Ujumbe wa Kiswahili · inyalala.github.io" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

              <div class="form-row">
                <div class="form-group">
                  <label for="swFirstName">Jina la Kwanza *</label>
                  <input id="swFirstName" name="firstName" type="text" required autocomplete="given-name" placeholder="Jina la kwanza" />
                </div>
                <div class="form-group">
                  <label for="swLastName">Jina la Mwisho *</label>
                  <input id="swLastName" name="lastName" type="text" required autocomplete="family-name" placeholder="Jina la mwisho" />
                </div>
              </div>

              <div class="form-group">
                <label for="swEmail">Anwani ya Barua Pepe *</label>
                <input id="swEmail" name="email" type="email" required autocomplete="email" placeholder="jina@taasisi.ac.tz" />
              </div>

              <div class="form-group">
                <label for="swTopic">Mada ya Ujumbe *</label>
                <select id="swTopic" name="topic" required>
                  <option value="">Chagua kundi la mada...</option>
                  <option value="Ushirikiano wa Utafiti wa Kitaaluma">Ushirikiano wa Utafiti wa Kitaaluma</option>
                  <option value="Ushirikiano wa Sekta ya Kilimo / Afya / NGO">Ushirikiano wa Sekta ya Kilimo / Afya / NGO</option>
                  <option value="Usimamizi wa MTech / PhD / Postdoc">Usimamizi wa MTech / PhD / Postdoc</option>
                  <option value="Masuala ya Masomo (Z5007 / Z3003)">Masuala ya Masomo (Z5007 / Z3003)</option>
                  <option value="Mwaliko wa Mhadhara / Habari">Mwaliko wa Mhadhara au Vyombo vya Habari</option>
                  <option value="Ujumbe wa Kawaida">Swali la Kawaida</option>
                </select>
              </div>

              <div class="form-group">
                <label for="swMessage">Ujumbe *</label>
                <textarea id="swMessage" name="message" rows="5" required placeholder="Eleza kwa ufupi lengo la utafiti, swali la somo, au muda unaopendekeza wa kukutana..."></textarea>
              </div>

              <div class="form-actions">
                <button id="swSubmitBtn" type="submit" class="btn-mono">Tuma Ujumbe &rarr;</button>
                <a id="swMailto" href={`mailto:${PROFILE.email}`} class="btn-mono-outline">Fungua Programu ya Barua Pepe</a>
                <a
                  id="swGmail"
                  href={`https://mail.google.com/mail/?view=cm&fs=1&to=${PROFILE.email}`}
                  target="_blank"
                  rel="noopener"
                  class="text-action"
                >
                  Fungua Gmail &#8599;
                </a>
              </div>
            </form>
          </div>

          <aside class="info-col">
            <div class="monograph-panel">
              <span class="mono-eyebrow">Anwani Rasmi za Ofisi</span>
              <dl class="c-dl">
                <div>
                  <dt>Barua Pepe ya Profesa</dt>
                  <dd>
                    <a href={`mailto:${PROFILE.email}`} class="inline-link">{PROFILE.email}</a>
                    <button id="swCopyEmail" type="button" class="mini-btn" style="margin-left: 0.45rem;">Nakili</button>
                  </dd>
                </div>
                <div>
                  <dt>Maabara ya Utafiti</dt>
                  <dd><a href={PROFILE.labUrl} target="_blank" rel="noopener" class="inline-link">Maabara ya SAAIL ({PROFILE.labEmail}) &#8599;</a></dd>
                </div>
                <div>
                  <dt>Ofisi ya Kampasi</dt>
                  <dd>Chumba 105 (Ghorofa ya 1 / F1)<br />Kitivo cha Uhandisi na Sayansi, IIT Madras Zanzibar, Kampasi ya Bweleo, Zanzibar</dd>
                </div>
                <div>
                  <dt>Saa za Ofisi</dt>
                  <dd>Jumanne (kipindi cha kozi ya Z5007) na Jumatano, Saa 8:00 mchana&ndash;10:00 alasiri (2:00&ndash;4:00 PM EAT, Z3003 na huduma kwa wanafunzi)</dd>
                </div>
                <div>
                  <dt>Simu</dt>
                  <dd class="tabular-nums">
                    TZ: <a href={`tel:${PROFILE.phoneTanzania.replace(/\s+/g, '')}`} class="inline-link">{PROFILE.phoneTanzania}</a><br />
                    KE: <a href={`tel:${PROFILE.phoneKenya.replace(/\s+/g, '')}`} class="inline-link">{PROFILE.phoneKenya}</a>
                  </dd>
                </div>
                <div>
                  <dt>Unasafiri Kuja Zanzibar?</dt>
                  <dd><a href="/writing/visiting-iit-madras-zanzibar-guide/" class="inline-link">Soma Mwongozo wa Kampasi ya Bweleo (EN) &rarr;</a></dd>
                </div>
              </dl>
            </div>
          </aside>
        </div>
      </section>

      <section class="rule-section">
        <div class="map-head">
          <div>
            <span class="mono-eyebrow">Kampasi ya Bweleo &middot; Zanzibar, Tanzania</span>
            <h2 class="section-h">Ramani ya Kampasi na Maelekezo</h2>
          </div>
          <a href="/sw/faq/" class="text-action">Maswali Yanayoulizwa Mara kwa Mara &rarr;</a>
        </div>
        <div class="map-box">
          <iframe
            title="Ramani ya Kampasi ya IIT Madras Zanzibar huko Bweleo"
            src={PROFILE.mapEmbedUrl}
            width="100%"
            height="320"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
    </main>

    <SiteFooter lang="sw" />
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var TARGET_EMAIL = 'innocent@iitmz.ac.in';
      var copyBtn = document.getElementById('swCopyEmail');
      var form = document.getElementById('swContactForm');
      var submitBtn = document.getElementById('swSubmitBtn');
      var banner = document.getElementById('swFormBanner');
      var firstEl = document.getElementById('swFirstName');
      var lastEl = document.getElementById('swLastName');
      var emailEl = document.getElementById('swEmail');
      var topicEl = document.getElementById('swTopic');
      var msgEl = document.getElementById('swMessage');
      var mailtoLink = document.getElementById('swMailto');
      var gmailLink = document.getElementById('swGmail');

      function buildPayload() {
        var name = (((firstEl && firstEl.value) || '') + ' ' + ((lastEl && lastEl.value) || '')).trim() || 'Mgeni wa Tovuti';
        var sender = ((emailEl && emailEl.value) || '').trim();
        var topic = ((topicEl && topicEl.value) || '').trim() || 'Ujumbe wa Kitaaluma';
        var msg = ((msgEl && msgEl.value) || '').trim();
        var subject = '[inyalala.github.io] ' + topic + ' - ' + name;
        var body = 'Kutoka: ' + name + (sender ? ' (' + sender + ')' : '') + '\nMada: ' + topic + '\n\n' + msg;
        return { subject: subject, body: body };
      }

      function syncLinks() {
        var p = buildPayload();
        var qSub = encodeURIComponent(p.subject);
        var qBody = encodeURIComponent(p.body);
        if (mailtoLink) mailtoLink.href = 'mailto:' + TARGET_EMAIL + '?subject=' + qSub + '&body=' + qBody;
        if (gmailLink) gmailLink.href = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + TARGET_EMAIL + '&su=' + qSub + '&body=' + qBody;
      }

      [firstEl, lastEl, emailEl, topicEl, msgEl].forEach(function (el) {
        el && el.addEventListener('input', syncLinks);
        el && el.addEventListener('change', syncLinks);
      });
      syncLinks();

      copyBtn &&
        copyBtn.addEventListener('click', function () {
          var onCopied = function () {
            copyBtn.textContent = 'Imenakiliwa!';
            if (window.__showMonoToast) window.__showMonoToast('Imenakiliwa ' + TARGET_EMAIL);
            setTimeout(function () {
              copyBtn.textContent = 'Nakili';
            }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(TARGET_EMAIL).then(onCopied).catch(function () {
              var ta = document.createElement('textarea');
              ta.value = TARGET_EMAIL;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try { if (document.execCommand('copy')) onCopied(); } catch (e) {}
              document.body.removeChild(ta);
            });
          }
        });

      form &&
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (!submitBtn || !banner) return;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Inatuma...';
          banner.hidden = true;

          var fd = new FormData(form);
          fd.append('_replyto', fd.get('email') || '');

          fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: fd
          })
            .then(function (resp) {
              if (resp.ok) {
                banner.className = 'form-banner is-ok';
                banner.textContent = 'Ujumbe umetumwa kwenda ' + TARGET_EMAIL + '. Asante kwa kuwasiliana.';
                banner.hidden = false;
                banner.focus();
                form.reset();
                syncLinks();
              } else {
                throw new Error('Request rejected');
              }
            })
            .catch(function () {
              var p = buildPayload();
              banner.className = 'form-banner is-warn';
              banner.innerHTML =
                'Huduma ya kutuma moja kwa moja haikupatikana sasa. Tafadhali tuma kupitia <a href="mailto:' +
                TARGET_EMAIL +
                '?subject=' +
                encodeURIComponent(p.subject) +
                '&body=' +
                encodeURIComponent(p.body) +
                '" class="inline-link">programu yako ya barua pepe</a> au andika kwenda ' +
                TARGET_EMAIL +
                '.';
              banner.hidden = false;
              banner.focus();
            })
            .finally(function () {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Tuma Ujumbe →';
            });
        });
    });
  </script>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.25rem;
    align-items: start;
  }
  .form-sub {
    color: var(--text-secondary);
    font-size: 0.94rem;
    margin-bottom: 1.25rem;
  }
  .form-banner {
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-strong);
    margin-bottom: 1rem;
    font-size: 0.92rem;
  }
  .form-banner.is-ok {
    border-color: var(--accent-forest);
    background: var(--bg-secondary);
  }
  .form-banner.is-warn {
    border-color: var(--accent-clove);
    background: var(--bg-secondary);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.58rem 0.75rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 0.96rem;
    border-radius: 2px;
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
  }
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .c-dl {
    border-top: 1px solid var(--rule);
    margin-top: 0.4rem;
  }
  .c-dl > div {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .c-dl dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-clove);
    margin-bottom: 0.15rem;
  }
  .c-dl dd {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .mini-btn {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    border-radius: 2px;
  }
  .map-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }
  .map-box {
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    padding: 0.35rem;
  }
  @media (max-width: 820px) {
    .contact-grid,
    .form-row {
      grid-template-columns: 1fr;
    }
    .mini-btn {
      min-height: 42px;
      padding: 0.45rem 0.85rem;
    }
  }
</style>
