---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MonographRail from '../../../components/MonographRail.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { WRITING_POSTS } from '../../../data/writing';
import { getImageDim, getThumbSrc } from '../../../data/media';
import { breadcrumbList, personEntity, websiteEntity } from '../../../data/schema';

const pageUrl = 'https://inyalala.github.io/sw/writing/';

const swPostMeta: Record<string, { titleSw: string; catSw: string; summarySw: string; altSw: string }> = {
  'abcs-of-ai-in-agriculture': {
    titleSw: 'Alfabeti ya AI katika Kilimo (A hadi Z): Kutoka Matrekta ya Kujiendesha hadi Ramani za Shamba',
    catSw: 'Mwongozo wa Mtafiti',
    summarySw:
      'Muhtasari wenye michoro unaounganisha dhana 26 za msingi za akili mnemba na uhandisi wa kilimo na tafiti za Maabara ya SAAIL pamoja na data wazi Afrika Mashariki.',
    altSw: 'Mchoro wa usanifu wa mfumo wa CropGuardNet unaounganisha picha za mazao na uainishaji mwepesi'
  },
  'accuracy-mirages-field-agricultural-ai': {
    titleSw: 'Kwa Nini Usahihi wa Juu wa Maabara Hushindwa Kwenye Mashamba ya Wakulima Wadogo',
    catSw: 'Makala ya Utafiti',
    summarySw:
      'Masomo kutoka DGS-Bench, CLOVES-4603, na ETRI Journal 2026 kuhusu udanganyifu wa vipimo vya jumla, athari za mwanga wa maabara, na modeli za utenganishaji wa picha.',
    altSw: 'Chati za DGS-Bench zikionyesha pengo kati ya usahihi wa maabara na matumizi halisi shambani'
  },
  'kiunguja-swahili-coastal-dialect-nlp': {
    titleSw: 'Kiunguja, Kipemba, Kiswahili cha Bara na Kenya: Kwa Nini Tofauti za Lahaja Ni Muhimu Kwenye NLP',
    catSw: 'Makala ya Utafiti',
    summarySw:
      'Tafakuri kutoka Zanzibar kuhusu lahaja za Kiunguja na Kipemba dhidi ya Kiswahili cha Bara na Kenya, na kwa nini ukaguzi wa asili ya matini hushinda tafsiri ya mashine.',
    altSw: 'Usambazaji wa vyanzo halisi vya Kiunguja na Kipemba katika Korpasi ya Kiswahili cha Zanzibar'
  },
  'overleaf-latex-citation-starter-guide': {
    titleSw: 'Kuanza Kutumia Overleaf, LaTeX, na Nukuu Safi za BibTeX',
    catSw: 'Mwongozo wa Mtafiti',
    summarySw:
      'Mwongozo wa hatua kwa hatua kwa wanafunzi wa shahada ya kwanza, MTech, na PhD wanaoandaa machapisho ya kisayansi yanayojirudia ndani ya Overleaf.',
    altSw: 'Meza ya kufundishia katika Chuo Kikuu cha IIT Madras Zanzibar yenye kitabu cha algoriti na kompyuta mpakato'
  },
  'visiting-iit-madras-zanzibar-guide': {
    titleSw: 'Kutembelea IIT Madras Zanzibar: Mwongozo wa Kufika Uwanja wa Ndege na Kampasi ya Bweleo',
    catSw: 'Mwongozo wa Zanzibar',
    summarySw:
      'Maelekezo muhimu ya usafiri, malazi, na mpangilio wa kampasi kwa wahadhiri wageni, wazungumzaji waalikwa, na wanafunzi wapya wanaowasili Zanzibar.',
    altSw: 'Picha ya ukumbi na mazingira ya mafunzo katika kampasi ya Bweleo ya IIT Madras Zanzibar'
  },
  'zanzibar-seaweed-blue-economy-field-notes': {
    titleSw: 'Kamba za Mwani, Maghala ya Karafuu, na Kwa Nini AI ya Kilimo Lazima Iendane na Kazi za Uwandani',
    catSw: 'Tafakuri ya Uwandani',
    summarySw:
      'Tafakuri kutoka fukwe za mwani na maghala ya karafuu Zanzibar juu ya kwa nini akili mnemba yenye tija huanza na taratibu za wakulima na fizikia ya mazingira.',
    altSw: 'Kazi ya uwandani ya uwekaji daraja wa karafuu na uchumi wa buluu katika Pwani ya Zanzibar'
  }
};

function formatSwReadingTime(rt: string): string {
  const m = rt.match(/(\d+)/);
  return m ? `Dakika ${m[1]} za kusoma` : rt;
}

const swCategories = [
  { key: 'All', label: `Zote (${WRITING_POSTS.length})` },
  { key: 'Research Note', label: 'Makala za Utafiti' },
  { key: 'Scholar Guide', label: 'Miongozo ya Watafiti' },
  { key: 'Essay & Reflection', label: 'Tafakuri' },
  { key: 'Zanzibar & Campus Guide', label: 'Mwongozo wa Zanzibar' }
];

const swWritingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity('sw'),
    {
      ...websiteEntity(),
      inLanguage: ['en-US', 'sw-TZ']
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Makala, Tafiti na Miongozo | Innocent Nyalala · IITMZ',
      inLanguage: 'sw-TZ',
      isPartOf: { '@id': 'https://inyalala.github.io/#website' },
      about: { '@id': 'https://inyalala.github.io/#person' },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: WRITING_POSTS.length,
        itemListElement: WRITING_POSTS.map((p, idx) => {
          const meta = swPostMeta[p.slug];
          return {
            '@type': 'ListItem',
            position: idx + 1,
            item: {
              '@type': 'BlogPosting',
              headline: meta ? meta.titleSw : p.title,
              description: meta ? meta.summarySw : p.summary,
              datePublished: p.date,
              inLanguage: 'en-US',
              image: p.image
                ? (p.image.startsWith('http') ? p.image : `https://inyalala.github.io${p.image}`)
                : 'https://inyalala.github.io/images/og-innocent-nyalala.png',
              author: { '@id': 'https://inyalala.github.io/#person' },
              url: `https://inyalala.github.io/writing/${p.slug}/`
            }
          };
        })
      }
    },
    breadcrumbList(
      [
        { name: 'Nyumbani (Kiswahili)', url: 'https://inyalala.github.io/sw/' },
        { name: 'Makala na Miongozo', url: pageUrl }
      ],
      `${pageUrl}#breadcrumb`
    )
  ]
};
---

<BaseLayout
  title="Makala, Tafiti na Miongozo | Innocent Nyalala · IITMZ"
  description="Muhtasari wa Kiswahili wa makala za utafiti wa kilimo na lugha ya Kiunguja, miongozo ya Overleaf, na taarifa za wageni wa IIT Madras Zanzibar."
  canonical={pageUrl}
  lang="sw"
  alternates={[
    { hreflang: 'en', href: 'https://inyalala.github.io/writing/' },
    { hreflang: 'sw', href: pageUrl },
    { hreflang: 'x-default', href: 'https://inyalala.github.io/writing/' }
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(swWritingSchema)} />
  </Fragment>

  <MonographRail currentPage="writing" lang="sw" />

  <div class="monograph-canvas">
    <main id="main-content">
      <header class="page-masthead">
        <span class="mono-eyebrow">Insha, Maelezo ya Utafiti na Miongozo</span>
        <h1 class="page-title">Makala na Miongozo ya Kampasi</h1>
        <p class="page-lead">
          Muhtasari wa Kiswahili kwa kila insha na mwongozo kamili (makala kamili za kitaaluma zinapatikana kwa Kiingereza zikiwa na alama ya <strong>(EN)</strong>), zikihusu akili mnemba ya kilimo, lahaja ya Kiunguja, uandishi wa LaTeX, na safari za kampasi ya Bweleo.
        </p>

        <div class="writing-controls">
          <div class="filter-strip" style="margin-top: 0;" role="group" aria-label="Chuja makala kwa kundi">
            {swCategories.map((cat, idx) => (
              <button type="button" class="filter-btn" aria-pressed={idx === 0 ? 'true' : 'false'} data-wcat={cat.key}>
                {cat.label}
              </button>
            ))}
          </div>
        </div>
        <div class="w-count-bar">
          <p id="swWritingCount" class="w-count" aria-live="polite">
            Inaonyesha makala {WRITING_POSTS.length} kati ya {WRITING_POSTS.length}
          </p>
          <a href="/writing/" class="text-action">Toleo la Kiingereza / English Index (EN) &rarr;</a>
        </div>
      </header>

      <section class="rule-section" style="padding-top: 0;">
        <ol class="essay-ledger">
          {WRITING_POSTS.map((post) => {
            const thumb = post.image ? getThumbSrc(post.image) : '';
            const dim = thumb ? getImageDim(thumb, 640, 400) : { width: 640, height: 400 };
            const meta = swPostMeta[post.slug];
            return (
              <li class="essay-row" data-wcat={post.category}>
                {thumb && (
                  <a href={`/writing/${post.slug}/`} class="essay-media" aria-label={meta ? meta.titleSw : post.title}>
                    <img
                      src={thumb}
                      alt={meta ? meta.altSw : (post.imageAlt || post.title)}
                      width={dim.width}
                      height={dim.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="essay-body">
                  <p class="essay-meta">
                    <span class="e-cat">{meta ? meta.catSw : post.category}</span>
                    <span>&middot;</span>
                    <time datetime={post.date}>{post.date}</time>
                    <span>&middot;</span>
                    <span>{formatSwReadingTime(post.readingTime)}</span>
                  </p>
                  <h2>
                    <a href={`/writing/${post.slug}/`}>{meta ? meta.titleSw : post.title}</a>
                  </h2>
                  <p class="essay-summary">{meta ? meta.summarySw : post.summary}</p>
                  <p>
                    <a href={`/writing/${post.slug}/`} class="text-action">Soma Makala Kamili (EN) &rarr;</a>
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    </main>

    <SiteFooter lang="sw" />
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var btns = document.querySelectorAll('.filter-btn[data-wcat]');
      var rows = document.querySelectorAll('.essay-row');
      var countEl = document.getElementById('swWritingCount');

      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var cat = btn.getAttribute('data-wcat') || 'All';
          btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
          var vis = 0;
          rows.forEach(function (r) {
            var show = cat === 'All' || r.getAttribute('data-wcat') === cat;
            r.style.display = show ? 'grid' : 'none';
            if (show) vis++;
          });
          if (countEl) {
            countEl.textContent = 'Inaonyesha makala ' + vis + ' kati ya ' + rows.length;
          }
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .writing-controls {
    margin-top: 1.35rem;
  }
  .w-count-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }
  .w-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .essay-ledger {
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .essay-row {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 1.75rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .essay-media {
    display: block;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .essay-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .essay-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .e-cat {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-clove);
    font-weight: 500;
  }
  .essay-body h2 {
    font-size: 1.48rem;
    margin-bottom: 0.45rem;
  }
  .essay-body h2 a {
    text-decoration: none;
  }
  .essay-body h2 a:hover {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .essay-summary {
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
    margin-bottom: 0.7rem;
  }
  @media (max-width: 780px) {
    .essay-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
