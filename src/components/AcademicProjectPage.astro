  <script is:inline>
    (function () {
      var pBar = document.getElementById('paperProgressBar');
      function updatePaperProgress() {
        if (!pBar) return;
        var docH = document.documentElement.scrollHeight - window.innerHeight;
        var pct = docH > 0 ? Math.min(1, Math.max(0, window.scrollY / docH)) : 0;
        pBar.style.transform = 'scaleX(' + pct.toFixed(4) + ')';
      }
      window.addEventListener('scroll', updatePaperProgress, { passive: true });
      updatePaperProgress();

      var btn = document.getElementById('moreWorksBtn');
      var dropdown = document.getElementById('moreWorksDropdown');
      var closeBtn = document.getElementById('closeMoreWorks');
      var chevron = document.getElementById('moreWorksChevron');

      function setOpen(open) {
        if (!btn || !dropdown) return;
        dropdown.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chevron) {
          chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }

      if (btn && dropdown) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(dropdown.hidden);
        });
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            setOpen(false);
            btn.focus();
          });
        }
        document.addEventListener('click', function (e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            setOpen(false);
          }
        });
      }

      var lightbox = document.getElementById('imgLightbox');
      var lightboxImg = document.getElementById('lightboxImg');
      var lightboxCap = document.getElementById('lightboxCaption');
      var lbCounter = document.getElementById('lbCounter');
      var prevLb = document.getElementById('prevLightbox');
      var nextLb = document.getElementById('nextLightbox');
      var closeLightbox = document.getElementById('closeLightbox');
      var lbBackdrop = lightbox && lightbox.querySelector('.lb-backdrop');
      var triggers = Array.prototype.slice.call(document.querySelectorAll('.zoom-trigger'));
      var lbIdx = 0;
      var lastFocusEl = null;
      var blankSrc = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

      function setBackgroundInert(active) {
        document.querySelectorAll('.monograph-rail, .mobile-header, .monograph-canvas, #backToTop, .skip-link').forEach(function (el) {
          if (active) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
      }

      function showSlide(idx) {
        if (!triggers.length || !lightboxImg) return;
        lbIdx = (idx + triggers.length) % triggers.length;
        var trg = triggers[lbIdx];
        var imgEl = trg.querySelector('img');
        var src = trg.getAttribute('data-zoom-src') || (imgEl && imgEl.src) || blankSrc;
        var alt = trg.getAttribute('data-zoom-alt') || (imgEl && imgEl.alt) || 'Figure';
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        if (lightboxCap) lightboxCap.textContent = alt;
        if (lbCounter) lbCounter.textContent = (lbIdx + 1) + ' / ' + triggers.length;
        if (prevLb) prevLb.disabled = triggers.length <= 1;
        if (nextLb) nextLb.disabled = triggers.length <= 1;
      }

      function openLightbox(triggerEl, startIdx) {
        if (!lightbox) return;
        lastFocusEl = triggerEl;
        showSlide(startIdx);
        lightbox.hidden = false;
        setBackgroundInert(true);
        document.body.style.overflow = 'hidden';
        closeLightbox && closeLightbox.focus();
      }

      function hideLightbox() {
        if (!lightbox) return;
        lightbox.hidden = true;
        setBackgroundInert(false);
        document.body.style.overflow = '';
        if (lightboxImg) lightboxImg.src = blankSrc;
        if (lastFocusEl && typeof lastFocusEl.focus === 'function') {
          lastFocusEl.focus();
        }
      }

      triggers.forEach(function (triggerEl, i) {
        triggerEl.title = 'Click to view full size';
        triggerEl.addEventListener('click', function () {
          openLightbox(triggerEl, i);
        });
      });

      prevLb && prevLb.addEventListener('click', function () { showSlide(lbIdx - 1); });
      nextLb && nextLb.addEventListener('click', function () { showSlide(lbIdx + 1); });
      closeLightbox && closeLightbox.addEventListener('click', hideLightbox);
      lbBackdrop && lbBackdrop.addEventListener('click', hideLightbox);

      if (lightbox) {
        var tX = 0;
        var tY = 0;
        lightbox.addEventListener('touchstart', function (e) {
          if (e.touches && e.touches.length === 1) {
            tX = e.touches[0].clientX;
            tY = e.touches[0].clientY;
          }
        }, { passive: true });
        lightbox.addEventListener('touchend', function (e) {
          if (!e.changedTouches || !e.changedTouches.length || triggers.length <= 1) return;
          var dx = e.changedTouches[0].clientX - tX;
          var dy = Math.abs(e.changedTouches[0].clientY - tY);
          if (Math.abs(dx) > 48 && Math.abs(dx) > dy * 1.3) {
            showSlide(dx < 0 ? lbIdx + 1 : lbIdx - 1);
          }
        }, { passive: true });
      }

      document.addEventListener('keydown', function (e) {
        if (lightbox && !lightbox.hidden) {
          if (e.key === 'Escape') {
            hideLightbox();
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            showSlide(lbIdx - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            showSlide(lbIdx + 1);
          } else if (e.key === 'Tab') {
            var focusList = [prevLb, nextLb, closeLightbox].filter(function (b) { return b && !b.disabled; });
            if (!focusList.length) return;
            e.preventDefault();
            var cur = focusList.indexOf(document.activeElement);
            var nextPos = e.shiftKey ? (cur <= 0 ? focusList.length - 1 : cur - 1) : (cur + 1) % focusList.length;
            focusList[nextPos].focus();
          }
          return;
        }
        if (e.key === 'Escape' && dropdown && !dropdown.hidden) {
          setOpen(false);
          btn && btn.focus();
        }
      });

      function copyToClipboard(text) {
        if (!text) return Promise.resolve(false);
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text).then(function () { return true; }).catch(function () {
            return execCopy(text);
          });
        }
        return Promise.resolve(execCopy(text));
      }

      function execCopy(text) {
        var area = document.createElement('textarea');
        area.value = text;
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (_e2) {}
        document.body.removeChild(area);
        return ok;
      }

      var copyBtn = document.getElementById('copyBibBtn');
      if (copyBtn) {
        var originalText = copyBtn.textContent;
        copyBtn.addEventListener('click', function () {
          var el = document.getElementById('bibtexCode');
          var text = el ? (el.textContent || '').trim() : '';
          copyToClipboard(text).then(function (copied) {
            if (copied) {
              copyBtn.textContent = 'Copied!';
              if (window.__showMonoToast) window.__showMonoToast('BibTeX citation copied to clipboard');
              setTimeout(function () { copyBtn.textContent = originalText; }, 1800);
            }
          });
        });
      }

      var copyApaBtn = document.getElementById('copyApaBtn');
      if (copyApaBtn) {
        var originalApa = copyApaBtn.textContent;
        copyApaBtn.addEventListener('click', function () {
          var text = copyApaBtn.getAttribute('data-apa') || '';
          copyToClipboard(text).then(function (copied) {
            if (copied) {
              copyApaBtn.textContent = 'Copied APA!';
              if (window.__showMonoToast) window.__showMonoToast('APA 7th citation copied to clipboard');
              setTimeout(function () { copyApaBtn.textContent = originalApa; }, 1800);
            }
          });
        });
      }
    })();
  </script>
</BaseLayout>

