---
import BaseLayout from '../layouts/BaseLayout.astro';
import MonographRail from './MonographRail.astro';
import SiteFooter from './SiteFooter.astro';
import type { PriorPaper } from '../data/prior-papers';
import { PRIOR_COMPANIONS, PHD_CHAPTER_SLUGS, getImageDims } from '../data/prior-papers';
import { fitAtWord } from '../data/text-utils';
import { breadcrumbList, personEntity, webPageEntity, websiteEntity } from '../data/schema';

export interface Props {
  pub: PriorPaper;
}

const { pub } = Astro.props;

const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
const isThesis = pub.slug === 'phd-dissertation-2023' || pub.slug === 'intelligent-greenhouse-arduino-2016' || pub.slug === 'msc-thesis-2016';
const thesisRouteSlug = pub.slug === 'intelligent-greenhouse-arduino-2016' ? 'msc-thesis-2016' : pub.slug;
const isPhdChapter = PHD_CHAPTER_SLUGS.has(pub.slug);
const canonicalUrl = `https://inyalala.github.io/papers/${pub.slug}/`;
const ogImageUrl = pub.teaserImage
  ? (pub.teaserImage.endsWith('.svg')
      ? 'https://inyalala.github.io/images/og-innocent-nyalala.png'
      : `https://inyalala.github.io${pub.teaserImage}`)
  : 'https://inyalala.github.io/images/og-innocent-nyalala.png';
const isSvgTeaser = Boolean(pub.teaserImage && pub.teaserImage.endsWith('.svg'));
const teaserDims = pub.teaserImage ? getImageDims(pub.teaserImage) : null;
const ogImgW = pub.teaserImage && !isSvgTeaser && teaserDims ? teaserDims.width : 1200;
const ogImgH = pub.teaserImage && !isSvgTeaser && teaserDims ? teaserDims.height : 630;

function escapeHtmlAttr(val: string): string {
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function extractBibField(bib: string, field: string): string {
  const m = new RegExp(`\\b${field}\\s*=\\s*[{\"']([^}\"']+)[}\"']`, 'i').exec(bib || '');
  return m ? m[1].replace(/\s+/g, ' ').trim() : '';
}

const rawTitlePart = pub.shortTitle || fitAtWord(pub.title, 41);
const pageTitleBase = rawTitlePart.length <= 41 ? rawTitlePart : fitAtWord(rawTitlePart, 41);
const seoTitle = `${pageTitleBase} | Innocent Nyalala`;
const seoDesc = fitAtWord(pub.tldr || pub.abstract, 155);

const bibJournal = extractBibField(pub.bibtex, 'journal');
const bibBooktitle = extractBibField(pub.bibtex, 'booktitle');
const bibVolume = extractBibField(pub.bibtex, 'volume');
const bibNumber = extractBibField(pub.bibtex, 'number');
const bibPages = extractBibField(pub.bibtex, 'pages');
const scholarPubDate = (pub.dateISO || String(pub.year)).replace(/-/g, '/');
const keywordsMeta = [...(pub.keywords || []), 'Innocent Nyalala', 'Nanjing Agricultural University', 'Agricultural AI', 'Computer Vision'].join(', ');

const scholarMetaLines: string[] = [
  `<meta name="citation_title" content="${escapeHtmlAttr(pub.title)}" />`,
  ...pub.authors.map((a) => `<meta name="citation_author" content="${escapeHtmlAttr(a.name)}" />`),
  ...pub.affiliations.map((aff) => `<meta name="citation_author_institution" content="${escapeHtmlAttr(aff)}" />`),
  `<meta name="citation_publication_date" content="${escapeHtmlAttr(scholarPubDate)}" />`,
  `<meta name="citation_public_url" content="${escapeHtmlAttr(canonicalUrl)}" />`,
  `<meta name="citation_language" content="en" />`,
  `<meta name="citation_abstract" content="${escapeHtmlAttr(pub.abstract)}" />`,
  `<meta name="citation_keywords" content="${escapeHtmlAttr((pub.keywords || []).join('; '))}" />`
];
if (bibJournal) scholarMetaLines.push(`<meta name="citation_journal_title" content="${escapeHtmlAttr(bibJournal)}" />`);
else if (bibBooktitle) scholarMetaLines.push(`<meta name="citation_conference_title" content="${escapeHtmlAttr(bibBooktitle)}" />`);
if (bibVolume) scholarMetaLines.push(`<meta name="citation_volume" content="${escapeHtmlAttr(bibVolume)}" />`);
if (bibNumber) scholarMetaLines.push(`<meta name="citation_issue" content="${escapeHtmlAttr(bibNumber)}" />`);
if (bibPages) {
  const parts = bibPages.split(/--|-/).map((s) => s.trim()).filter(Boolean);
  if (parts[0]) scholarMetaLines.push(`<meta name="citation_firstpage" content="${escapeHtmlAttr(parts[0])}" />`);
  if (parts[1]) scholarMetaLines.push(`<meta name="citation_lastpage" content="${escapeHtmlAttr(parts[1])}" />`);
}
if (cleanDoi) {
  scholarMetaLines.push(`<meta name="citation_doi" content="${escapeHtmlAttr(cleanDoi)}" />`);
}
if (pub.pdfUrl) {
  const fullPdfUrl = pub.pdfUrl.startsWith('http') ? pub.pdfUrl : `https://inyalala.github.io${pub.pdfUrl}`;
  scholarMetaLines.push(`<meta name="citation_pdf_url" content="${escapeHtmlAttr(fullPdfUrl)}" />`);
}
const headScholarHtml = scholarMetaLines.join('\n  ');

const rawUsedIndices: number[] = [];
pub.authors.forEach((a) => {
  (a.affiliations || []).forEach((idx) => {
    if (!rawUsedIndices.includes(idx)) rawUsedIndices.push(idx);
  });
});
rawUsedIndices.sort((a, b) => a - b);

const remapAff = new Map<number, number>();
const visibleAffiliations: { num: number; label: string }[] = [];
if (rawUsedIndices.length > 0) {
  rawUsedIndices.forEach((origIdx) => {
    const label = pub.affiliations[origIdx - 1];
    if (label) {
      const seq = visibleAffiliations.length + 1;
      remapAff.set(origIdx, seq);
      visibleAffiliations.push({ num: seq, label });
    }
  });
} else {
  pub.affiliations.forEach((label, idx) => {
    visibleAffiliations.push({ num: idx + 1, label });
  });
}

function formatContributionSentence(raw: string, idx: number): string {
  const s = raw.trim();
  if (!s) return '';
  if (/^(This|We|The|These|Across|Under|Evaluation|Experimental|Together)\b/.test(s)) return s;
  const firstWord = s.split(/\s+/)[0].replace(/[^A-Za-z]/g, '');
  const present3rd = [
    'Demonstrates', 'Quantifies', 'Proves', 'Delivers', 'Defines', 'Establishes',
    'Reproduces', 'Introduces', 'Profiles', 'Unifies', 'Proposes', 'Documents',
    'Advances', 'Builds', 'Integrates', 'Reconciles', 'Audits', 'Exposes',
    'Formulates', 'Categorizes', 'Critiques', 'Identifies'
  ];
  if (present3rd.includes(firstWord)) {
    const subj = idx === 0 ? 'This study ' : idx === 1 ? 'The analysis ' : 'This work ';
    return subj + s.charAt(0).toLowerCase() + s.slice(1);
  }
  const subj = idx === 0 ? 'We ' : idx === 1 ? 'In addition, we ' : 'We also ';
  return subj + s.charAt(0).toLowerCase() + s.slice(1);
}

const teaserSummaryText = pub.teaserSummary || pub.teaserCaption || pub.tldr;
const allFigs = (pub.figures || []).slice(0, 3);
const bodyFigs = allFigs.length >= 2 ? allFigs.slice(0, -1) : allFigs;
const resultsFig = allFigs.length >= 2 ? allFigs[allFigs.length - 1] : null;
const resultsNarrative =
  pub.resultsSummary ||
  (pub.contributions && pub.contributions.length > 0
    ? pub.contributions.map((c, idx) => formatContributionSentence(c, idx)).join(' ')
    : '');
const hasResults = Boolean(resultsNarrative || resultsFig || (pub.tables && pub.tables.length > 0));
const extraDetails = pub.detailSections || [];

const jumpSections: { id: string; label: string }[] = [
  { id: 'abstract', label: 'Abstract' },
  ...(bodyFigs.length > 0 ? [{ id: 'methodology', label: 'Methodology' }] : []),
  ...(hasResults ? [{ id: 'results', label: 'Results' }] : []),
  ...extraDetails.map((sec) => ({
    id: sec.id,
    label: sec.id === 'study-6-synthesis'
      ? 'Synthesis'
      : sec.title.includes(':')
        ? sec.title.split(':')[0].trim()
        : sec.title
  })),
  { id: 'bibtex', label: 'Citation' }
];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personEntity(),
    websiteEntity(),
    webPageEntity({
      url: canonicalUrl,
      name: seoTitle,
      description: seoDesc,
      breadcrumbId: `${canonicalUrl}#breadcrumb`,
      mainEntityId: `${canonicalUrl}#work`
    }),
    {
      '@type': isThesis ? 'Thesis' : 'ScholarlyArticle',
      '@id': `${canonicalUrl}#work`,
      headline: pub.title,
      name: pub.title,
      datePublished: pub.dateISO || String(pub.year),
      description: pub.tldr,
      abstract: pub.abstract,
      keywords: pub.keywords,
      inLanguage: 'en',
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      image: ogImageUrl,
      author: pub.authors.map((a) =>
        a.name.toLowerCase().includes('innocent') && a.name.toLowerCase().includes('nyalala')
          ? { '@id': 'https://inyalala.github.io/#person' }
          : { '@type': 'Person', name: a.name }
      ),
      isPartOf: { '@type': isThesis ? 'CollegeOrUniversity' : (bibJournal ? 'Periodical' : 'PublicationVolume'), name: pub.venue },
      ...(doiUrl ? { sameAs: doiUrl, identifier: cleanDoi } : {})
    },
    breadcrumbList(
      [
        { name: 'Home', url: 'https://inyalala.github.io/' },
        { name: 'Publications', url: 'https://inyalala.github.io/publications/' },
        { name: pub.shortTitle || pub.title, url: canonicalUrl }
      ],
      `${canonicalUrl}#breadcrumb`
    )
  ]
};
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  canonical={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={pub.title}
  ogImageWidth={ogImgW}
  ogImageHeight={ogImgH}
  ogType="article"
  publishedTime={pub.dateISO || String(pub.year)}
  tags={pub.topics}
  keywords={keywordsMeta}
>
  <Fragment slot="head">
    <Fragment set:html={headScholarHtml} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </Fragment>

  <MonographRail currentPage="publications" />

  <div id="paperProgressBar" class="paper-progress-bar" aria-hidden="true"></div>

  <div class="monograph-canvas">
    <main id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/publications/">Publications</a>
        <span>/</span>
        <a href="/publications/?filter=all">Pre-SAAIL Archive</a>
        <span>/</span>
        <span aria-current="page">{pub.shortTitle || fitAtWord(pub.title, 44)}</span>
      </nav>

      <header class="page-masthead paper-masthead">
        <div class="masthead-top-row">
          <span class="mono-eyebrow">{pub.venueShort} &middot; {isThesis ? 'Degree Monograph' : 'Archival Paper'}</span>
          <div class="more-works-dock">
            <button
              id="moreWorksBtn"
              type="button"
              class="more-works-btn"
              aria-expanded="false"
              aria-controls="moreWorksDropdown"
              title="Browse Pre-SAAIL Publications & Theses (2015-2024)"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
              <span>More Works ({PRIOR_COMPANIONS.length})</span>
              <svg id="moreWorksChevron" class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>

            <div id="moreWorksDropdown" class="more-works-dropdown" hidden>
              <div class="dropdown-head">
                <span>Pre-SAAIL Works &amp; Theses ({PRIOR_COMPANIONS.length})</span>
                <button id="closeMoreWorks" type="button" class="close-btn" aria-label="Close">&times;</button>
              </div>
              <div class="dropdown-links">
                <a href="/publications/" class="dropdown-item dropdown-home-link">
                  <span class="item-kicker">&larr; All Cataloged Works</span>
                  <span class="item-title">Full Publications &amp; Thesis Index</span>
                </a>
                {PRIOR_COMPANIONS.map((item) => {
                  const kickerLabel = item.venueShort.includes(String(item.year))
                    ? item.venueShort
                    : `${item.venueShort} · ${item.year}`;
                  const isCurrent = item.slug === pub.slug;
                  return (
                    <a
                      href={`/papers/${item.slug}/`}
                      class:list={['dropdown-item', { 'dropdown-item-active': isCurrent }]}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      <span class="item-kicker">{kickerLabel}{isCurrent ? ' · Current' : ''}</span>
                      <span class="item-title">{item.shortTitle || item.title}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <h1 class="page-title">{pub.title}</h1>

        <div class="authors-row">
          {pub.authors.map((author, idx) => {
            const mappedAffs = (author.affiliations || [])
              .map((num) => remapAff.get(num))
              .filter((n): n is number => typeof n === 'number');
            const supText = mappedAffs.join(',');
            const comma = idx < pub.authors.length - 1 ? ', ' : '';
            return (
              <span class="author-token">
                {author.url ? (
                  <a href={author.url} target="_blank" rel="noopener" class="author-link">{author.name}</a>
                ) : (
                  <span class="author-name">{author.name}</span>
                )}
                {supText && <sup class="aff-sup">{supText}</sup>}
                {comma}
              </span>
            );
          })}
        </div>

        <div class="affiliations-stack">
          {visibleAffiliations.map((aff) => (
            <div class="aff-line">
              <sup>{aff.num}</sup>{aff.label}
            </div>
          ))}
        </div>

        <div class="venue-line">
          <span>{pub.venue}</span>
        </div>
        {pub.award && <div class="award-line">{pub.award}</div>}

        <nav class="action-buttons" aria-label={isThesis ? 'Monograph resources' : 'Paper resources'}>
          <a href="/publications/" class="btn-mono-outline">&larr; All Publications</a>
          {isThesis && (
            <a href={`/publications/theses/${thesisRouteSlug}/`} class="btn-mono">
              Monograph Record &rarr;
            </a>
          )}
          {!isThesis && isPhdChapter && (
            <a href="/papers/phd-dissertation-2023/" class="btn-mono-outline">
              Ph.D. Dissertation &rarr;
            </a>
          )}
          {doiUrl && (
            <a href={doiUrl} target="_blank" rel="noopener" class="btn-mono">
              DOI &#8599;
            </a>
          )}
          {pub.pdfUrl && (
            <a href={pub.pdfUrl} target="_blank" rel="noopener" class="btn-mono-outline">
              Publisher PDF &#8599;
            </a>
          )}
        </nav>
      </header>

      {jumpSections.length >= 2 && (
        <nav class="section-jump-nav" aria-label="Paper sections">
          {jumpSections.map((sec) => (
            <a href={`#${sec.id}`} class="jump-link">{sec.label}</a>
          ))}
        </nav>
      )}

      <section class:list={['teaser-section', { 'teaser-compact': !pub.teaserImage }]}>
        {pub.teaserImage && teaserDims && (
          <figure class="teaser-figure">
            <button
              type="button"
              class="zoom-trigger"
              data-zoom-src={pub.teaserImage}
              data-zoom-alt={pub.title}
              aria-label={`View full size: ${pub.title}`}
            >
              <img
                src={pub.teaserImage}
                alt={pub.title}
                width={teaserDims.width}
                height={teaserDims.height}
                class:list={['teaser-img', 'zoomable-img', { 'teaser-svg': isSvgTeaser }]}
                loading="eager"
              />
              <span class="zoom-cue" aria-hidden="true">Zoom</span>
            </button>
          </figure>
        )}
        <p class="teaser-summary">{teaserSummaryText}</p>
      </section>

      <section id="abstract" class="rule-section">
        <span class="mono-eyebrow">Abstract</span>
        <h2 class="section-h">Summary</h2>
        <div class="abstract-prose">
          <p>{pub.abstract}</p>
        </div>
      </section>

      {bodyFigs.map((fig, idx) => {
        const heading = fig.title || (idx === 0 ? (pub.figureHeading || 'Methodology & Analysis') : `Analysis ${idx + 1}`);
        const fd = getImageDims(fig.src);
        return (
          <section id={idx === 0 ? 'methodology' : `analysis-${idx + 1}`} class="rule-section">
            <span class="mono-eyebrow">Figure {idx + 1}</span>
            <h2 class="section-h" style="margin-bottom: 1.15rem;">{heading}</h2>
            <figure class="analysis-figure">
              <button
                type="button"
                class="zoom-trigger"
                data-zoom-src={fig.src}
                data-zoom-alt={fig.alt || fig.caption}
                aria-label={`View full size: ${fig.alt || fig.caption}`}
              >
                <img
                  src={fig.src}
                  alt={fig.alt || fig.caption}
                  width={fd.width}
                  height={fd.height}
                  class="analysis-img zoomable-img"
                  loading="lazy"
                />
                <span class="zoom-cue" aria-hidden="true">Zoom</span>
              </button>
              <figcaption class="figure-prose">{fig.caption}</figcaption>
            </figure>
          </section>
        );
      })}

      {hasResults && (
        <section id="results" class="rule-section">
          <span class="mono-eyebrow">Quantitative Findings</span>
          <h2 class="section-h" style="margin-bottom: 1.15rem;">Results</h2>

          {resultsNarrative && <p class="section-prose">{resultsNarrative}</p>}

          {resultsFig && (() => {
            const rfd = getImageDims(resultsFig.src);
            return (
              <figure class="analysis-figure results-figure">
                <button
                  type="button"
                  class="zoom-trigger"
                  data-zoom-src={resultsFig.src}
                  data-zoom-alt={resultsFig.alt || resultsFig.caption}
                  aria-label={`View full size: ${resultsFig.alt || resultsFig.caption}`}
                >
                  <img
                    src={resultsFig.src}
                    alt={resultsFig.alt || resultsFig.caption}
                    width={rfd.width}
                    height={rfd.height}
                    class="analysis-img zoomable-img"
                    loading="lazy"
                  />
                  <span class="zoom-cue" aria-hidden="true">Zoom</span>
                </button>
                <figcaption class="figure-prose">{resultsFig.caption}</figcaption>
              </figure>
            );
          })()}

          {pub.tables && pub.tables.length > 0 && (
            <div class="tables-stack">
              {pub.tables.map((table) => (
                <div class="table-block">
                  <div class="table-header-text">
                    <h3>{table.title}</h3>
                    {table.caption && <p>{table.caption}</p>}
                  </div>
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          {table.headers.map((h) => <th>{h}</th>)}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => {
                          const cell0 = row[0] || '';
                          const isOurs = cell0.includes('(Ours)') || cell0.startsWith('Total');
                          return (
                            <tr class:list={[{ 'row-highlight': isOurs }]}>
                              {row.map((cell) => <td>{cell}</td>)}
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      )}

      {extraDetails.map((sec) => (
        <section id={sec.id} class="rule-section">
          <span class="mono-eyebrow">Detailed Study Record</span>
          <h2 class="section-h" style="margin-bottom: 1.15rem;">{sec.title}</h2>

          {sec.paragraphs && sec.paragraphs.map((p) => <p class="section-prose">{p}</p>)}

          {sec.figure && (() => {
            const sfd = getImageDims(sec.figure.src);
            return (
              <figure class="analysis-figure results-figure">
                <button
                  type="button"
                  class="zoom-trigger"
                  data-zoom-src={sec.figure.src}
                  data-zoom-alt={sec.figure.alt || sec.figure.caption}
                  aria-label={`View full size: ${sec.figure.alt || sec.figure.caption}`}
                >
                  <img
                    src={sec.figure.src}
                    alt={sec.figure.alt || sec.figure.caption}
                    width={sfd.width}
                    height={sfd.height}
                    class="analysis-img zoomable-img"
                    loading="lazy"
                  />
                  <span class="zoom-cue" aria-hidden="true">Zoom</span>
                </button>
                <figcaption class="figure-prose">{sec.figure.caption}</figcaption>
              </figure>
            );
          })()}

          {sec.figures && sec.figures.length > 0 && (
            <div class:list={['detail-figures-grid', { 'detail-figures-single': sec.figures.length === 1 }]}>
              {sec.figures.map((fig) => {
                const dfd = getImageDims(fig.src);
                return (
                  <figure class="detail-fig-card">
                    <button
                      type="button"
                      class="zoom-trigger"
                      data-zoom-src={fig.src}
                      data-zoom-alt={fig.alt || fig.caption}
                      aria-label={`View full size: ${fig.alt || fig.caption}`}
                    >
                      <img
                        src={fig.src}
                        alt={fig.alt || fig.caption}
                        width={dfd.width}
                        height={dfd.height}
                        class="detail-fig-img zoomable-img"
                        loading="lazy"
                      />
                      <span class="zoom-cue" aria-hidden="true">Zoom</span>
                    </button>
                    <figcaption class="detail-fig-caption">
                      {fig.title && <strong>{fig.title}: </strong>}{fig.caption}
                    </figcaption>
                  </figure>
                );
              })}
            </div>
          )}

          {sec.table && (
            <div class="table-block">
              <div class="table-header-text">
                <h3>{sec.table.title}</h3>
                {sec.table.caption && <p>{sec.table.caption}</p>}
              </div>
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      {sec.table.headers.map((h) => <th>{h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {sec.table.rows.map((row) => (
                      <tr>
                        {row.map((cell) => <td>{cell}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </section>
      ))}

      <section id="bibtex" class="rule-section">
        <div class="bibtex-header">
          <div>
            <span class="mono-eyebrow">Reference Formats</span>
            <h2 class="section-h">Citation</h2>
          </div>
          <div class="bibtex-actions">
            {pub.apa && (
              <button type="button" id="copyApaBtn" class="btn-mono-outline" data-apa={pub.apa} title="Copy APA 7th citation">
                Copy APA 7th
              </button>
            )}
            <button type="button" id="copyBibBtn" class="btn-mono" data-copy-target="bibtexCode" title="Copy BibTeX to clipboard">
              Copy BibTeX
            </button>
          </div>
        </div>
        <pre id="bibtex-code" class="bibtex-pre"><code id="bibtexCode">{pub.bibtex}</code></pre>
      </section>
    </main>

    <SiteFooter />
  </div>

  <div id="imgLightbox" class="img-lightbox" hidden role="dialog" aria-modal="true" aria-labelledby="lightboxCaption">
    <div class="lb-backdrop"></div>
    <div class="lb-topbar">
      <span id="lbCounter" class="lb-counter tabular-nums">1 / 1</span>
      <div class="lb-controls">
        <button id="prevLightbox" type="button" class="lb-nav-btn" aria-label="Previous figure">&larr; Prev</button>
        <button id="nextLightbox" type="button" class="lb-nav-btn" aria-label="Next figure">Next &rarr;</button>
        <button id="closeLightbox" type="button" class="lightbox-close" aria-label="Close enlarged view">&times;</button>
      </div>
    </div>
    <figure class="lb-figure">
      <img
        id="lightboxImg"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt="Enlarged figure preview"
        width="1200"
