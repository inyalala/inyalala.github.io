---
import { PROFILE } from '../data/profile';
import { PUBLICATIONS } from '../data/publications';
export interface Props {
  lang?: 'en' | 'sw';
}
const { lang = 'en' } = Astro.props;
const isSw = lang === 'sw';
const blankImg = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<footer class="colophon">
  <div class="colophon-grid">
    <div class="colophon-identity">
      <p class="colophon-sig">Innocent Nyalala</p>
      <p class="colophon-role">
        {isSw ? (
          <>
            Profesa Msaidizi wa Sayansi ya Data na Akili Mnemba<br />
            Kitivo cha Uhandisi na Sayansi, Chuo Kikuu cha IIT Madras Zanzibar<br />
            Mtafiti Shirikishi, WSAI, IIT Madras<br />
            Mkurugenzi wa Utafiti, Maabara ya SAAIL
          </>
        ) : (
          <>
            {PROFILE.role}<br />
            {PROFILE.school}, {PROFILE.institution}<br />
            {PROFILE.secondaryRole}, WSAI, IIT Madras<br />
            Principal Investigator, SAAIL Lab
          </>
        )}
      </p>
      <p class="colophon-links">
        <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        <span>&middot;</span>
        <a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener">Scholar</a>
        <span>&middot;</span>
        <a href="https://orcid.org/0000-0002-7969-437X" target="_blank" rel="noopener">ORCID</a>
        <span>&middot;</span>
        <a href="https://www.scopus.com/authid/detail.uri?authorId=57190215419" target="_blank" rel="noopener">Scopus</a>
        <span>&middot;</span>
        <a href="https://openreview.net/profile?id=~Innocent_Nyalala1" target="_blank" rel="noopener">OpenReview</a>
        <span>&middot;</span>
        <a href="https://openalex.org/A5013656785" target="_blank" rel="noopener">OpenAlex</a>
        <span>&middot;</span>
        <a href="https://github.com/inyalala" target="_blank" rel="noopener">GitHub</a>
        <span>&middot;</span>
        <a href="https://www.linkedin.com/in/innocentnyalala/" target="_blank" rel="noopener">LinkedIn</a>
        <span>&middot;</span>
        <a href={PROFILE.labUrl} target="_blank" rel="noopener">{isSw ? 'Maabara ya SAAIL' : 'SAAIL Lab'} &#8599;</a>
      </p>
    </div>

    <div class="colophon-cols">
      <div>
        <h2 class="colophon-h">{isSw ? 'Kurasa Kuu' : 'Monograph'}</h2>
        <ul class="colophon-list">
          <li><a href={isSw ? '/sw/' : '/'}>{isSw ? 'Nyumbani (Kiswahili)' : 'Home'}</a></li>
          <li><a href="/about/">{isSw ? 'Wasifu na Kazi' : 'Biography & Career'}</a></li>
          <li><a href={isSw ? '/sw/research/' : '/research/'}>{isSw ? 'Ajenda ya Utafiti' : 'Research Agenda'}</a></li>
          <li><a href="/publications/">{isSw ? `Machapisho (${PUBLICATIONS.length})` : `Publications (${PUBLICATIONS.length})`}</a></li>
          <li><a href={isSw ? '/sw/writing/' : '/writing/'}>{isSw ? 'Makala na Miongozo' : 'Writing & Travel Guides'}</a></li>
          <li><a href="/news/">{isSw ? 'Habari na Matukio' : 'News & Dispatches'}</a></li>
          <li><a href="/work-with-me/">{isSw ? 'Ushirikiano' : 'Collaborate'}</a></li>
          <li><a href={isSw ? '/sw/faq/' : '/faq/'}>{isSw ? 'Maswali' : 'FAQ'}</a></li>
          <li><a href={isSw ? '/sw/contact/' : '/contact/'}>{isSw ? 'Mawasiliano' : 'Contact'}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="colophon-h">{isSw ? 'Ufundishaji na Mitaala' : 'Teaching & Syllabi'}</h2>
        <ul class="colophon-list">
          <li><a href={isSw ? '/sw/courses/' : '/courses/'}>{isSw ? 'Kozi Zote (2026-27)' : 'All Courses (2026-27)'}</a></li>
          <li><a href="/courses/z5007/">{isSw ? 'Z5007 Prog & DS (MTech)' : 'Z5007 Prog & DS (MTech Active)'}</a></li>
          <li><a href="/courses/z3003/">{isSw ? 'Z3003 Uchimbaji wa Data (BS)' : 'Z3003 Data Mining (BS Active)'}</a></li>
          <li><a href="/courses/z2005/">{isSw ? 'Z2005 Prog & DS (Rejea)' : 'Z2005 Prog & DS (Reference)'}</a></li>
          <li><a href="/courses/z2004/">{isSw ? 'Z2004 DBMS (Kumbukumbu)' : 'Z2004 DBMS (Archive)'}</a></li>
          <li><a href="/courses/z5008/">{isSw ? 'Z5008 Big Data (Kumbukumbu)' : 'Z5008 Big Data Lab (Archive)'}</a></li>
          <li><a href={PROFILE.teachingSiteUrl} target="_blank" rel="noopener">{isSw ? 'Tovuti ya Slaidi' : 'Slides CDN'} &#8599;</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="telemetry-row" aria-label={isSw ? 'Takwimu za wageni wa tovuti kwa Saa za Afrika Mashariki' : 'Site visitor statistics in East Africa Time'}>
    <span class="telemetry-label">{isSw ? 'Wageni (EAT, UTC+3)' : 'Visitors (EAT, UTC+3)'}</span>
    <div class="telemetry-badges">
      <img
        src="https://visitor-badge.laobi.icu/badge?page_id=inyalala.github.io&left_color=1B3B2F&right_color=7A4B1E&left_text=Total%20Visitors"
        alt={isSw ? 'Jumla ya Wageni' : 'Total Visitors Count'}
        loading="lazy"
        decoding="async"
        width="124"
        height="20"
        class="visitor-img"
      />
      <img
        src={blankImg}
        data-visitor-period="day"
        alt={isSw ? 'Wageni wa Leo' : 'Daily Visitors Count'}
        loading="lazy"
        decoding="async"
        width="84"
        height="20"
        class="visitor-img"
      />
      <img
        src={blankImg}
        data-visitor-period="week"
        alt={isSw ? 'Wageni wa Wiki Hii' : 'Weekly Visitors Count'}
        loading="lazy"
        decoding="async"
        width="108"
        height="20"
        class="visitor-img"
      />
      <img
        src={blankImg}
        data-visitor-period="month"
        alt={isSw ? 'Wageni wa Mwezi Huu' : 'Monthly Visitors Count'}
        loading="lazy"
        decoding="async"
        width="114"
        height="20"
        class="visitor-img"
      />
    </div>
  </div>

  <div class="colophon-bottom">
    <p>
      {isSw ? (
        <>
          &copy; {new Date().getUTCFullYear()} Innocent Nyalala &middot; Kitivo cha Uhandisi na Sayansi, IIT Madras Zanzibar.
          Matini yanatolewa chini ya <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC BY-NC 4.0</a>;
          vifaa vya masomo vinatolewa chini ya <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="license noopener">CC BY-NC-SA 4.0</a>;
          msimbo chanzo unatolewa chini ya <a href="https://github.com/inyalala/inyalala.github.io/blob/main/LICENSE" target="_blank" rel="license noopener">Leseni ya MIT</a>.
        </>
      ) : (
        <>
          &copy; {new Date().getUTCFullYear()} Innocent Nyalala &middot; School of Engineering and Science, IIT Madras Zanzibar.
          Prose licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC BY-NC 4.0</a>;
          course materials under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="license noopener">CC BY-NC-SA 4.0</a>;
          source code under <a href="https://github.com/inyalala/inyalala.github.io/blob/main/LICENSE" target="_blank" rel="license noopener">MIT License</a>.
        </>
      )}
    </p>
    <p class="colophon-feeds">
      <a href="/feed.xml">{isSw ? 'Mlisho wa RSS' : 'RSS Feed'}</a>
      <a href="/sitemap.xml">{isSw ? 'Ramani ya Tovuti' : 'Sitemap'}</a>
    </p>
  </div>
</footer>

<script is:inline>
  (function () {
    var nowEat = new Date(Date.now() + 3 * 3600 * 1000);
    var pad2 = function (n) {
      return String(n).padStart(2, '0');
    };
    var dayKey = nowEat.getUTCFullYear() + '-' + pad2(nowEat.getUTCMonth() + 1) + '-' + pad2(nowEat.getUTCDate());
    var monthKey = nowEat.getUTCFullYear() + '-' + pad2(nowEat.getUTCMonth() + 1);
    var isoTmp = new Date(Date.UTC(nowEat.getUTCFullYear(), nowEat.getUTCMonth(), nowEat.getUTCDate()));
    var isoDay = isoTmp.getUTCDay() || 7;
    isoTmp.setUTCDate(isoTmp.getUTCDate() + 4 - isoDay);
    var isoYear = isoTmp.getUTCFullYear();
    var isoYearStart = new Date(Date.UTC(isoYear, 0, 1));
    var isoWeek = Math.ceil(((isoTmp.getTime() - isoYearStart.getTime()) / 86400000 + 1) / 7);
    var weekKey = isoYear + '-W' + pad2(isoWeek);

    var cfgMap = {
      day: { key: dayKey, label: 'Today' },
      week: { key: weekKey, label: 'This%20Week' },
      month: { key: monthKey, label: 'This%20Month' }
    };

    document.querySelectorAll('img.visitor-img').forEach(function (img) {
      img.addEventListener('error', function () {
        img.style.display = 'none';
      });
      var period = img.getAttribute('data-visitor-period');
      var cfg = period && cfgMap[period];
      if (!cfg) return;
      img.setAttribute('data-period-key', cfg.key);
      img.setAttribute(
        'src',
        'https://visitor-badge.laobi.icu/badge?page_id=inyalala.github.io.' +
          period +
          '.' +
          cfg.key +
          '&left_color=343833&right_color=1B3B2F&left_text=' +
          cfg.label
      );
    });
  })();
</script>

<style>
  .colophon {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: 2.25rem clamp(1.5rem, 4.5vw, 4rem) 2.75rem;
    border-top: 1px solid var(--rule-strong);
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.25rem;
    margin-bottom: 1.75rem;
  }

  .colophon-sig {
    font-family: var(--font-script);
    font-size: 1.95rem;
    color: var(--accent-clove);
    line-height: 1.05;
    margin-bottom: 0.45rem;
  }

  .colophon-role {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .colophon-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .colophon-links a {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .colophon-links a:hover {
    color: var(--accent-clove);
  }

  .colophon-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .colophon-h {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-clove);
    margin-bottom: 0.65rem;
  }

  .colophon-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .colophon-list a {
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .colophon-list a:hover {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .telemetry-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1rem;
  }

  .telemetry-label {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .telemetry-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .visitor-img {
    height: 20px;
    width: auto;
  }

  .colophon-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .colophon-bottom a {
    color: var(--accent-forest);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .colophon-feeds {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 720px) {
    .colophon-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
