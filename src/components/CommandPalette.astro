<div id="cmdPaletteBackdrop" class="cmd-palette-backdrop" hidden>
  <div
    id="cmdPaletteDialog"
    class="cmd-palette-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cmdPaletteLabel"
  >
    <div class="cmd-head">
      <label id="cmdPaletteLabel" for="cmdPaletteInput" class="sr-only">Search the faculty monograph</label>
      <svg class="cmd-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      <input
        id="cmdPaletteInput"
        type="search"
        class="cmd-input"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="cmdPaletteResults"
        aria-activedescendant=""
        placeholder="Search papers, Z5007/Z3003 modules, actions, essays, or pages..."
        autocomplete="off"
        spellcheck="false"
      />
      <button id="cmdPaletteClear" type="button" class="cmd-clear" aria-label="Clear search query" hidden>&times;</button>
      <button id="cmdPaletteClose" type="button" class="cmd-close" aria-label="Close quick search">Esc</button>
    </div>

    <div id="cmdPaletteResults" class="cmd-results" role="listbox" aria-label="Search results">
      <p class="cmd-hint">Type a keyword such as <em>clove</em>, <em>z5007</em>, <em>swahili</em>, or <em>theme</em>.</p>
    </div>
    <p id="cmdPaletteAnnounce" class="sr-only" aria-live="polite"></p>

    <div class="cmd-foot">
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> Select</span>
      <span><kbd>Enter</kbd> Open / Run</span>
      <span><kbd>Esc</kbd> Close</span>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var backdrop = document.getElementById('cmdPaletteBackdrop');
    var dialog = document.getElementById('cmdPaletteDialog');
    var input = document.getElementById('cmdPaletteInput');
    var resultsEl = document.getElementById('cmdPaletteResults');
    var announceEl = document.getElementById('cmdPaletteAnnounce');
    var clearBtn = document.getElementById('cmdPaletteClear');
    var closeBtn = document.getElementById('cmdPaletteClose');
    var triggers = document.querySelectorAll('.js-open-cmd');
    if (!backdrop || !dialog || !input || !resultsEl) return;

    var indexCache = null;
    var activeIdx = -1;
    var renderSeq = 0;
    var lastFocus = null;
    var siblingNodes = document.querySelectorAll('.monograph-shell, #backToTop, .skip-link, main, footer, .more-works-container');

    var actionEntries = [
      {
        group: 'Actions',
        title: 'Toggle Day / Night Palette',
        meta: 'Action · Switch light and dark reading themes',
        keywords: 'theme dark light night day palette toggle color mode',
        actionId: 'toggle-theme'
      },
      {
        group: 'Actions',
        title: 'Switch Language (EN / SW)',
        meta: 'Action · Toggle English Monograph and Kiswahili Edition',
        keywords: 'language swahili kiswahili english translate sw en',
        actionId: 'switch-lang'
      },
      {
        group: 'Actions',
        title: 'Copy Faculty Email (innocent@iitmz.ac.in)',
        meta: 'Action · Copy IIT Madras Zanzibar address to clipboard',
        keywords: 'copy email address contact innocent iitmz',
        actionId: 'copy-email'
      },
      {
        group: 'Actions',
        title: 'Open Z5007 (MTech Prog & Data Structures)',
        meta: 'Action · Active Odd Semester 2026-27 Course Dossier',
        url: '/courses/z5007/',
        keywords: 'open z5007 pds programming data structures mtech active course'
      },
      {
        group: 'Actions',
        title: 'Open Z3003 (BS Data Mining)',
        meta: 'Action · Active Odd Semester 2026-27 Course Dossier',
        url: '/courses/z3003/',
        keywords: 'open z3003 data mining bs scaling large data active course'
      }
    ];

    function setBackgroundInert(state) {
      siblingNodes.forEach(function (el) {
        if (el.contains(backdrop)) return;
        if (state) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });
    }

    function escapeHtml(s) {
      return String(s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function copyTextFallback(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(function () { return true; }).catch(function () {
          return execCopy(text);
        });
      }
      return Promise.resolve(execCopy(text));
    }

    function execCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      return ok;
    }

    function runAction(actionId) {
      if (actionId === 'toggle-theme') {
        var btn = document.querySelector('.js-theme-toggle, #paperThemeToggle');
        if (btn) {
          btn.click();
        } else {
          var curr = document.documentElement.getAttribute('data-theme') || 'light';
          var next = curr === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        }
        var nowTheme = document.documentElement.getAttribute('data-theme') || 'light';
        closePalette();
        if (window.__showMonoToast) {
          window.__showMonoToast('Palette switched to ' + (nowTheme === 'dark' ? 'Night' : 'Day') + ' mode');
        }
      } else if (actionId === 'switch-lang') {
        var path = window.location.pathname;
        var isSw = path.indexOf('/sw') === 0;
        if (isSw) {
          if (path.indexOf('/sw/courses') === 0) window.location.href = '/courses/';
          else if (path.indexOf('/sw/research') === 0) window.location.href = '/research/';
          else if (path.indexOf('/sw/writing') === 0) window.location.href = '/writing/';
          else if (path.indexOf('/sw/contact') === 0) window.location.href = '/contact/';
          else if (path.indexOf('/sw/faq') === 0) window.location.href = '/faq/';
          else window.location.href = '/';
        } else {
          if (path.indexOf('/courses') === 0) window.location.href = '/sw/courses/';
          else if (path.indexOf('/research') === 0) window.location.href = '/sw/research/';
          else if (path.indexOf('/writing') === 0) window.location.href = '/sw/writing/';
          else if (path.indexOf('/contact') === 0) window.location.href = '/sw/contact/';
          else if (path.indexOf('/faq') === 0) window.location.href = '/sw/faq/';
          else window.location.href = '/sw/';
        }
      } else if (actionId === 'copy-email') {
        copyTextFallback('innocent@iitmz.ac.in').then(function (ok) {
          closePalette();
          if (window.__showMonoToast) {
            window.__showMonoToast(ok ? 'Copied innocent@iitmz.ac.in' : 'Email: innocent@iitmz.ac.in');
          }
        });
      }
    }

    function loadIndex() {
      if (indexCache) return Promise.resolve(indexCache);
      return fetch('/search-index.json')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          indexCache = actionEntries.concat((data && data.items) || []);
          return indexCache;
        })
        .catch(function () {
          return actionEntries.slice();
        });
    }

    function renderResults(query) {
      var mySeq = ++renderSeq;
      loadIndex().then(function (items) {
        if (mySeq !== renderSeq) return;
        var q = (query || '').trim().toLowerCase();
        var filtered = [];
        if (!q) {
          filtered = actionEntries.concat(items.filter(function (it) { return it.group !== 'Actions'; }).slice(0, 9));
        } else {
          var terms = q.split(/\s+/).filter(Boolean);
          filtered = items
            .map(function (item) {
              var titleLow = item.title.toLowerCase();
              var metaLow = item.meta.toLowerCase();
              var kw = item.keywords || '';
              var ok = terms.every(function (t) {
                return titleLow.indexOf(t) !== -1 || metaLow.indexOf(t) !== -1 || kw.indexOf(t) !== -1;
              });
              if (!ok) return null;
              var score = item.group === 'Actions' ? 1 : 0;
              terms.forEach(function (t) {
                if (titleLow.indexOf(t) === 0) score += 6;
                else if (titleLow.indexOf(t) !== -1) score += 4;
                if (metaLow.indexOf(t) !== -1) score += 2;
              });
              return { item: item, score: score };
            })
            .filter(Boolean)
            .sort(function (a, b) { return b.score - a.score; })
            .slice(0, 18)
            .map(function (x) { return x.item; });
        }

        if (!filtered.length) {
          activeIdx = -1;
          input.setAttribute('aria-activedescendant', '');
          resultsEl.innerHTML = '<p class="cmd-hint">No matching monograph records for "' + escapeHtml(query) + '".</p>';
          if (announceEl) announceEl.textContent = 'No matching monograph records.';
          return;
        }

        var groups = [];
        var byGroup = {};
        filtered.forEach(function (item) {
          if (!byGroup[item.group]) {
            byGroup[item.group] = [];
            groups.push(item.group);
          }
          byGroup[item.group].push(item);
        });

        var html = '';
        var idxCounter = 0;
        groups.forEach(function (grp, gIdx) {
          var lblId = 'cmdGrp-' + gIdx;
          html += '<div role="group" aria-labelledby="' + lblId + '">';
          html += '<div id="' + lblId + '" class="cmd-group-label" role="presentation">' + escapeHtml(grp) + '</div>';
          byGroup[grp].forEach(function (item) {
            var optId = 'cmdOpt-' + idxCounter;
            var isFirst = idxCounter === 0;
            var selAttr = ' aria-selected="' + (isFirst ? 'true' : 'false') + '"';
            if (item.actionId) {
              html +=
                '<button type="button" id="' +
                optId +
                '" tabindex="-1" class="cmd-item cmd-action-item' +
                (isFirst ? ' is-active' : '') +
                '" role="option"' +
                selAttr +
                ' data-cmd-idx="' +
                idxCounter +
                '" data-action-id="' +
                escapeHtml(item.actionId) +
                '">' +
                '<span class="cmd-item-title">' +
                escapeHtml(item.title) +
                ' &crarr;</span>' +
                '<span class="cmd-item-meta">' +
                escapeHtml(item.meta) +
                '</span>' +
                '</button>';
            } else {
              var extAttr = item.external ? ' target="_blank" rel="noopener"' : '';
              var arrow = item.external ? ' &#8599;' : ' &rarr;';
              html +=
                '<a id="' +
                optId +
                '" href="' +
                escapeHtml(item.url) +
                '" tabindex="-1" class="cmd-item' +
                (isFirst ? ' is-active' : '') +
                '" role="option"' +
                selAttr +
                ' data-cmd-idx="' +
                idxCounter +
                '"' +
                extAttr +
                '>' +
                '<span class="cmd-item-title">' +
                escapeHtml(item.title) +
                arrow +
                '</span>' +
                '<span class="cmd-item-meta">' +
                escapeHtml(item.meta) +
                '</span>' +
                '</a>';
            }
            idxCounter += 1;
          });
          html += '</div>';
        });

        resultsEl.innerHTML = html;
        activeIdx = 0;
        input.setAttribute('aria-activedescendant', 'cmdOpt-0');
        if (announceEl) {
          announceEl.textContent = q
            ? idxCounter + ' matching monograph records'
            : idxCounter + ' quick commands and pages';
        }
      });
    }

    function syncClearBtn() {
      if (clearBtn) clearBtn.hidden = !(input.value && input.value.length > 0);
    }

    function openPalette() {
      lastFocus = document.activeElement;
      backdrop.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setBackgroundInert(true);
      document.body.style.overflow = 'hidden';
      syncClearBtn();
      renderResults(input.value);
      setTimeout(function () { input.focus(); }, 10);
    }

    function closePalette() {
      if (backdrop.hidden) return;
      backdrop.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.setAttribute('aria-activedescendant', '');
      setBackgroundInert(false);
      document.body.style.overflow = '';
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    function setActive(newIdx) {
      var opts = resultsEl.querySelectorAll('.cmd-item');
      if (!opts.length) return;
      activeIdx = (newIdx + opts.length) % opts.length;
      opts.forEach(function (el, i) {
        var on = i === activeIdx;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      input.setAttribute('aria-activedescendant', opts[activeIdx].id || '');
      opts[activeIdx].scrollIntoView({ block: 'nearest' });
    }

    resultsEl.addEventListener('click', function (e) {
      var btn = e.target.closest('.cmd-action-item');
      if (!btn) return;
      var actionId = btn.getAttribute('data-action-id');
      if (actionId) runAction(actionId);
    });

    resultsEl.addEventListener('mousemove', function (e) {
      var opt = e.target.closest('.cmd-item');
      if (!opt) return;
      var idx = parseInt(opt.getAttribute('data-cmd-idx') || '', 10);
      if (!isNaN(idx) && idx !== activeIdx) {
        var opts = resultsEl.querySelectorAll('.cmd-item');
        if (!opts[idx]) return;
        activeIdx = idx;
        opts.forEach(function (el, i) {
          var on = i === activeIdx;
          el.classList.toggle('is-active', on);
          el.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        input.setAttribute('aria-activedescendant', opts[activeIdx].id || '');
      }
    });

    triggers.forEach(function (btn) {
      btn.addEventListener('click', openPalette);
    });

    clearBtn && clearBtn.addEventListener('click', function () {
      input.value = '';
      syncClearBtn();
      renderResults('');
      input.focus();
    });
    closeBtn && closeBtn.addEventListener('click', closePalette);
    backdrop.addEventListener('click', function (e) {
      if (e.target === backdrop) closePalette();
    });

    input.addEventListener('input', function () {
      syncClearBtn();
      renderResults(input.value);
    });

    dialog.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
        return;
      }
      if (e.key === 'Tab') {
        var focusables = [input, clearBtn, closeBtn].filter(function (el) {
          return el && !el.hidden && !el.disabled && el.offsetParent !== null;
        });
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      } else if (e.key === 'ArrowDown' && (document.activeElement === clearBtn || document.activeElement === closeBtn)) {
        e.preventDefault();
        input.focus();
        setActive(activeIdx < 0 ? 0 : activeIdx);
      }
    });

    input.addEventListener('keydown', function (e) {
      var opts = resultsEl.querySelectorAll('.cmd-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIdx - 1);
      } else if (e.key === 'Home' && opts.length) {
        e.preventDefault();
        setActive(0);
      } else if (e.key === 'End' && opts.length) {
        e.preventDefault();
        setActive(opts.length - 1);
      } else if (e.key === 'Enter' && activeIdx >= 0 && opts[activeIdx]) {
        e.preventDefault();
        opts[activeIdx].click();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      }
    });

    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.hidden) openPalette();
        else closePalette();
        return;
      }
      var tag = (document.activeElement && document.activeElement.tagName || '').toLowerCase();
      var typing = tag === 'input' || tag === 'textarea' || tag === 'select' || (document.activeElement && document.activeElement.isContentEditable);
      if (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        openPalette();
      } else if (e.key === 'Escape' && !backdrop.hidden) {
        closePalette();
      }
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .cmd-palette-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(21, 20, 18, 0.56);
    backdrop-filter: blur(2px);
    z-index: 3200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(3rem, 8vh, 6rem) 1rem 2rem;
  }
  .cmd-palette-backdrop[hidden] {
    display: none;
  }

  .cmd-palette-dialog {
    width: min(640px, 100%);
    background: var(--bg-surface);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.28);
    border-radius: 3px;
    overflow: hidden;
    color: var(--text-primary);
  }

  .cmd-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.78rem 1rem;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-rail);
  }

  .cmd-search-icon {
    color: var(--accent-forest);
    flex-shrink: 0;
  }

  .cmd-input {
    flex: 1 1 auto;
    border: none;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--text-primary);
    outline: none;
    min-width: 0;
  }
  .cmd-input::placeholder {
    color: var(--text-muted);
  }

  .cmd-clear {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1;
    width: 24px;
    height: 24px;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .cmd-clear[hidden] {
    display: none;
  }
  .cmd-clear:hover {
    color: var(--accent-forest);
    border-color: var(--accent-forest);
  }
  .cmd-close {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 2px;
  }
  .cmd-close:hover {
    color: var(--accent-forest);
    border-color: var(--accent-forest);
  }

  .cmd-results {
    max-height: min(56vh, 420px);
    overflow-y: auto;
    padding: 0.45rem 0;
  }

  .cmd-results :global(.cmd-hint) {
    padding: 1.35rem 1.15rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    margin: 0;
  }

  .cmd-results :global(.cmd-group-label) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-clove);
    padding: 0.65rem 1rem 0.25rem;
    border-top: 1px solid var(--rule);
  }
  .cmd-results :global([role='group']:first-child .cmd-group-label) {
    border-top: none;
  }

  .cmd-results :global(.cmd-item) {
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
    padding: 0.58rem 1rem;
    text-decoration: none;
    border: none;
    border-left: 3px solid transparent;
    background: transparent;
    width: 100%;
    text-align: left;
    font: inherit;
    cursor: pointer;
    color: var(--text-primary);
  }
  .cmd-results :global(.cmd-item:hover),
  .cmd-results :global(.cmd-item.is-active) {
    background: var(--bg-secondary);
    border-left-color: var(--accent-forest);
  }

  .cmd-results :global(.cmd-item-title) {
    display: block;
    font-size: 0.96rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.32;
  }
  .cmd-results :global(.cmd-item-meta) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .cmd-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--bg-rail);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .cmd-foot kbd {
    font-family: var(--font-mono);
    padding: 0.08rem 0.32rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-surface);
    border-radius: 2px;
    margin-right: 0.2rem;
  }
  @media (max-width: 640px) {
    .cmd-head {
      gap: 0.5rem;
    }
    .cmd-clear,
    .cmd-close {
      min-width: 38px;
      min-height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
